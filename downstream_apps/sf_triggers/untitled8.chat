            "kind": "read",
            "title": "Read utils.py (300 - 389)",
            "raw_output": "300\t    return head_names\n301\t\n302\t\n303\tdef apply_peft_lora(\n304\t    model: torch.nn.Module,\n305\t    lora_config: LoraAdapterConfig,\n306\t) -> torch.nn.Module:\n307\t    \"\"\"\n308\t    Applies PEFT LoRA adapters to a model.\n309\t\n310\t    Adapters go on the modules named by ``lora_config.target_modules``.  Every\n311\t    fine-tuning head module (see :func:`discover_head_modules`) is passed to\n312\t    PEFT as ``modules_to_save``, so it stays **trainable** -- without this the\n313\t    head is frozen at its random initialisation and LoRA fits adapters to a\n314\t    random readout.\n315\t\n316\t    Args:\n317\t        model: The model to apply LoRA to.\n318\t        lora_config: A LoraAdapterConfig instance (from workshop_infrastructure.configs).\n319\t\n320\t    Returns:\n321\t        Model with PEFT LoRA adapters applied.\n322\t    \"\"\"\n323\t    modules_to_save = discover_head_modules(model)\n324\t\n325\t    print(\n326\t        f\"Applying PEFT LoRA: r={lora_config.r}, alpha={lora_config.lora_alpha}, \"\n327\t        f\"dropout={lora_config.lora_dropout}, modules={lora_config.target_modules}\"\n328\t    )\n329\t\n330\t    from peft import LoraConfig, get_peft_model\n331\t    peft_config = LoraConfig(\n332\t        r=lora_config.r,\n333\t        lora_alpha=lora_config.lora_alpha,\n334\t        target_modules=lora_config.target_modules,\n335\t        lora_dropout=lora_config.lora_dropout,\n336\t        bias=lora_config.bias,\n337\t        modules_to_save=modules_to_save,\n338\t    )\n339\t\n340\t    model = get_peft_model(model, peft_config)\n341\t\n342\t<<<<<<< HEAD\n343\t    # get_peft_model() freezes every parameter except the LoRA adapters it just added.\n344\t    # Anything outside the backbone -- the pooling head, penultimate linear layer, and\n345\t    # unembed/decoder for HelioSpectformer1D; the decoder for HelioSpectformer2D -- is the\n346\t    # fine-tuning head and must stay trainable, or the adapters end up fitting a frozen,\n347\t    # randomly-initialized readout.\n348\t    for name, param in model.named_parameters():\n349\t        if \"lora_\" in name:\n350\t            continue\n351\t        original_name = name.split(\"base_model.model.\", 1)[-1]\n352\t        if not original_name.startswith(\"backbone.\"):\n353\t            param.requires_grad = True\n354\t=======\n355\t    # Show exactly what is being trained, so a misconfigured run is visible\n356\t    # in the log instead of only in the loss curve.\n357\t    adapted = sorted(\n358\t        {\n359\t            name.split(\".lora_A\")[0].replace(\"base_model.model.\", \"\")\n360\t            for name, _ in model.named_parameters()\n361\t            if \".lora_A\" in name\n362\t        }\n363\t    )\n364\t    print(f\"[LoRA] Adapted modules ({len(adapted)}):\")\n365\t    for name in adapted:\n366\t        print(f\"[LoRA]   {name}\")\n367\t    print(f\"[LoRA] Trainable head modules (modules_to_save): {modules_to_save}\")\n368\t\n369\t    # Defensive: current PEFT excludes modules_to_save from adapter injection.\n370\t    # If that ever changes, a head module would get both, so fail loudly.\n371\t    head_adapted = [n for n in adapted if n.split(\".\")[0].startswith(HEAD_PREFIX)]\n372\t    if head_adapted:\n373\t        raise RuntimeError(\n374\t            \"PEFT applied LoRA adapters to fine-tuning head modules, which \"\n375\t            f\"should be fully trainable instead: {head_adapted}. \"\n376\t            \"Narrow lora_config.target_modules so it cannot match head layers.\"\n377\t        )\n378\t>>>>>>> origin/main\n379\t\n380\t    # Log the number of trainable parameters\n381\t    trainable_params = 0\n382\t    all_param = 0\n383\t    for _, param in model.named_parameters():\n384\t        all_param += param.numel()\n385\t        if param.requires_grad:\n386\t            trainable_params += param.numel()\n387\t\n388\t    print(\n389\t        f\"trainable params: {trainable_params:,} || \"",
            "locations": [
