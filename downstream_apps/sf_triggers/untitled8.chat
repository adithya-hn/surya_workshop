sf_triggers/download_scalers.sh    |   10 +\n .../sf_triggers/download_scalers_and_weights.sh    |   10 +\n .../sf_triggers/lightning_modules/__init__.py      |    0\n .../lightning_modules/pl_simple_baseline.py        |  267 +++\n downstream_apps/sf_triggers/metrics/__init__.py    |    0\n .../sf_triggers/metrics/sf_triggers_metrics.py     |  194 ++\n downstream_apps/sf_triggers/models/__init__.py     |    0\n .../sf_triggers/models/simple_baseline.py          |   80 +\n downstream_apps/sf_triggers/untitled.chat          |   57 +\n downstream_apps/sf_triggers/untitled1.chat         | 1627 +++++++++++++++\n downstream_apps/sf_triggers/untitled2.chat         |  321 +++\n downstream_apps/sf_triggers/untitled3.chat         |  185 ++\n downstream_apps/sf_triggers/untitled4.chat         | 2177 ++++++++++++++++++++\n downstream_apps/sf_triggers/untitled5.chat         |  889 ++++++++\n repro_scratch.py                                   |   48 +\n 28 files changed, 13363 insertions(+)\nShell cwd was reset to /home/jovyan/adi_wdir/surya_workshop/downstream_apps/sf_triggers",
