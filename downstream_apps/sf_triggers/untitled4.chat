            "tool_call_id": "toolu_bdrk_01ECjpzEB9Sduwwr21TA4iEU",
            "raw_output": "1\timport re\n2\tfrom pathlib import Path\n3\tfrom typing import Literal\n4\t\n5\timport numpy as np\n6\timport pandas as pd\n7\tfrom astropy.io import fits\n8\t\n9\tfrom workshop_infrastructure.datasets.helio import HelioNetCDFDataset\n10\t\n11\t# SHARP bitmap filenames are the only place the HARP number and observation timestamp\n12\t# are recorded -- there is no sidecar index mapping catalog rows to mask files.\n13\t_MASK_FILENAME_RE = re.compile(\n14\t    r\"hmi\\.sharp_720s\\.(?P<harp>\\d+)\\.(?P<date>\\d{8})_(?P<time>\\d{6})_TAI\\.bitmap\\.fits$\"\n15\t)\n16\t\n17\t\n18\tdef _scan_mask_dir(mask_dir: str) -> pd.DataFrame:\n19\t    \"\"\"Parse HARP number + timestamp out of every SHARP bitmap filename in ``mask_dir``.\"\"\"\n20\t    rows = []\n21\t    for path in sorted(Path(mask_dir).glob(\"*.bitmap.fits\")):\n22\t        m = _MASK_FILENAME_RE.match(path.name)\n23\t        if m is None:\n24\t            continue\n25\t        ts = pd.Timestamp(\n26\t            f\"{m['date'][:4]}-{m['date'][4:6]}-{m['date'][6:]}\"\n27\t            f\"T{m['time'][:2]}:{m['time'][2:4]}:{m['time'][4:]}\"\n28\t        )\n29\t        rows.append({\"harp\": int(m[\"harp\"]), \"mask_ts\": ts, \"mask_path\": str(path)})\n30\t    if not rows:\n31\t        raise ValueError(f\"No SHARP bitmap files found in {mask_dir}\")\n32\t    return pd.DataFrame(rows).sort_values(\"mask_ts\")\n33\t\n34\t\n35\tclass FlareDSDataset(HelioNetCDFDataset):\n36\t    \"\"\"\n37\t    Template child class of HelioNetCDFDataset showing how to build a downstream dataset.\n38\t    Extends the base class with a flare-region spatial mask label aligned to the Surya index.\n39\t\n40\t    All ``HelioNetCDFDataset`` keyword arguments (``index_path``, ``scalers``, ``channels``,\n41\t    ``s3_cache_dir``, etc.) are accepted via ``**kwargs`` and forwarded to the base class.\n42\t    ``load_forecast_frames`` defaults to ``False`` here (flare forecasting supplies its own\n43\t    labels, so future Surya frames are never fetched); pass it explicitly to override.\n44\t\n45\t    Additional Args:\n46\t        return_surya_stack: If True (default), include the Surya image stack in the returned dict.\n47\t            Set to False to return only the flare mask label (useful for label inspection).\n48\t        max_number_of_samples: Cap the dataset length at this value. Useful for quick experiments.\n49\t        ds_flare_index_path: Path to the downstream flare catalog CSV index.\n50\t        ds_time_column: Column name in the flare index to use as the event timestamp.\n51\t        ds_time_tolerance: Maximum allowed time offset when matching Surya and DS indices\n52\t            (e.g., ``\"15min\"``). Unmatched entries are dropped.\n53\t        ds_match_direction: Merge direction passed to ``pd.merge_asof``. Use ``\"forward\"``\n54\t            for causal prediction (predict flares from prior solar state).\n55\t        ds_val_fraction: Fraction of DS *events* (not Surya timesteps) held out for\n56\t            validation. Splitting at the event level, rather than relying on which Surya\n57\t            calendar-month file a timestep happens to fall in, matters when the DS catalog\n58\t            is small and calendar-concentrated: a train/val split by month can easily leave\n59\t            zero events in validation.\n60\t        ds_split_seed: Seed for the event-level train/val split, so both the ``phase=\"train\"``\n61\t            and ``phase=\"val\"`` instances agree on a disjoint partition without communicating.\n62\t        mask_dir: Directory of SHARP bitmap FITS masks (one per flare event), named\n63\t            ``hmi.sharp_720s.<HARPNUM>.<YYYYMMDD>_<HHMMSS>_TAI.bitmap.fits``.\n64\t        mask_time_tolerance: Maximum allowed gap between a catalog row's event timestamp and\n65\t            a mask file's embedded timestamp when matching the two (e.g., ``\"10min\"``).\n66\t\n67\t    Raises:\n68\t        ValueError: If ``ds_flare_index_path`` or ``mask_dir`` is not provided, if no overlap\n69\t            exists between the Surya and DS indices within the specified tolerance, or if any\n70\t            catalog row has no matching mask file within ``mask_time_tolerance``.\n71\t    \"\"\"\n72\t\n73\t    def __init__(\n74\t        self,\n75\t        # Downstream-specific parameters\n76\t        return_surya_stack: bool = True,\n77\t        max_number_of_samples: int | None = None,\n78\t        ds_flare_index_path: str | None = None,\n79\t        ds_time_column: str | None = None,\n80\t        ds_time_tolerance: str | None = None,\n81\t        ds_match_direction: Literal[\"forward\", \"backward\", \"nearest\"] = \"forward\",\n82\t        ds_val_fraction: float = 0.2,\n83\t        ds_split_seed: int = 42,\n84\t        mask_dir: str | None = None,\n85\t        mask_time_tolerance: str = \"10min\",\n86\t        # All HelioNetCDFDataset parameters (index_path, scalers, channels, s3_*, etc.)\n87\t        **kwargs,\n88\t    ):\n89\t        if ds_match_direction not in [\"forward\", \"backward\", \"nearest\"]:\n90\t            raise ValueError(\"ds_match_direction must be one of 'forward', 'backward', or 'nearest'\")\n91\t        if mask_dir is None:\n92\t            raise ValueError(\"mask_dir must be provided for FlareDSDataset\")\n93\t\n94\t        # load_forecast_frames defaults to False here: flare forecasting supplies its\n95\t        # own labels, so future Surya frames never need to be fetched from disk/S3.\n96\t        kwargs.setdefault(\"load_forecast_frames\", False)\n97\t        super().__init__(**kwargs)\n98\t\n99\t        self.return_surya_stack = return_surya_stack\n100\t\n101\t        # Load ds index and find intersection with Surya index\n102\t        if ds_flare_index_path is not None:\n103\t            self.ds_index = pd.read_csv(ds_flare_index_path)\n104\t        else:\n105\t            raise ValueError(\"ds_flare_index_path must be provided for FlareDSDataset\")\n106\t\n107\t        self.ds_index[\"ds_index\"] = pd.to_datetime(\n108\t            self.ds_index[ds_time_column]\n109\t        ).values.astype(\"datetime64[ns]\")\n110\t        self.ds_index.sort_values(\"ds_index\", inplace=True)\n111\t\n112\t        # Split DS *events* into train/val before matching against the Surya index. A\n113\t        # split by calendar month (i.e. train_data_path vs valid_data_path) is meaningless\n114\t        # for a small, calendar-concentrated catalog like this one -- it can easily leave\n115\t        # zero events in whichever split holds the reserved months. Seeded, so the\n116\t        # phase=\"train\" and phase=\"val\" instances agree on a disjoint partition.\n117\t        n_events = len(self.ds_index)\n118\t        rng = np.random.RandomState(ds_split_seed)\n119\t        shuffled = rng.permutation(n_events)\n120\t        n_val = max(1, round(n_events * ds_val_fraction))\n121\t        val_positions = set(shuffled[:n_val].tolist())\n122\t        positions = val_positions if self.phase == \"val\" else set(range(n_events)) - val_positions\n123\t        self.ds_index = self.ds_index.iloc[sorted(positions)]\n124\t\n125\t        # Create Surya valid indices and find closest match to DS index\n126\t        self.df_valid_indices = pd.DataFrame(\n127\t            {\"valid_indices\": self.valid_indices}\n128\t        ).sort_values(\"valid_indices\")\n129\t        self.df_valid_indices = pd.merge_asof(\n130\t            self.df_valid_indices,\n131\t            self.ds_index,\n132\t            right_on=\"ds_index\",\n133\t            left_on=\"valid_indices\",\n134\t            direction=ds_match_direction,\n135\t        )\n136\t        # Remove duplicates keeping closest match\n137\t        self.df_valid_indices[\"index_delta\"] = np.abs(\n138\t            self.df_valid_indices[\"valid_indices\"] - self.df_valid_indices[\"ds_index\"]\n139\t        )\n140\t        self.df_valid_indices = self.df_valid_indices.sort_values(\n141\t            [\"ds_index\", \"index_delta\"]\n142\t        )\n143\t        self.df_valid_indices.drop_duplicates(\n144\t            subset=\"ds_index\", keep=\"first\", inplace=True\n145\t        )\n146\t        # Enforce a maximum time tolerance for matches\n147\t        if ds_time_tolerance is not None:\n148\t            self.df_valid_indices = self.df_valid_indices.loc[\n149\t                self.df_valid_indices[\"index_delta\"] <= pd.Timedelta(ds_time_tolerance),\n150\t                :,\n151\t            ]\n152\t            if len(self.df_valid_indices) == 0:\n153\t                raise ValueError(\"No intersection between Surya and DS indices\")\n154\t\n155\t        # Match each catalog row to its flare-region mask file by nearest timestamp.\n156\t        # self.df_valid_indices is sorted ascending by \"ds_index\" at this point, which\n157\t        # merge_asof requires.\n158\t        mask_index = _scan_mask_dir(mask_dir)\n159\t        self.df_valid_indices = pd.merge_asof(\n160\t            self.df_valid_indices,\n161\t            mask_index,\n162\t            left_on=\"ds_index\",\n163\t            right_on=\"mask_ts\",\n164\t            direction=\"nearest\",\n165\t            tolerance=pd.Timedelta(mask_time_tolerance),\n166\t        )\n167\t        unmatched = self.df_valid_indices[\"mask_path\"].isna()\n168\t        if unmatched.any():\n169\t            bad = self.df_valid_indices.loc[unmatched, \"ds_index\"].tolist()\n170\t            raise ValueError(\n171\t                f\"No mask file within {mask_time_tolerance} for ds_index timestamps: {bad}\"\n172\t            )\n173\t\n174\t        # Override valid indices variables to reflect matches between Surya and DS\n175\t        self.valid_indices = [\n176\t            pd.Timestamp(date) for date in self.df_valid_indices[\"valid_indices\"]\n177\t        ]\n178\t        self.adjusted_length = len(self.valid_indices)\n179\t        self.df_valid_indices.set_index(\"valid_indices\", inplace=True)\n180\t\n181\t        if max_number_of_samples is not None and max_number_of_samples < self.adjusted_length:\n182\t            self.valid_indices = self.valid_indices[:max_number_of_samples]\n183\t            self.df_valid_indices = self.df_valid_indices.iloc[:max_number_of_samples]\n184\t            self.adjusted_length = max_number_of_samples\n185\t\n186\t    def __len__(self):\n187\t        return self.adjusted_length\n188\t\n189\t    def _load_mask(self, path: str) -> np.ndarray:\n190\t        \"\"\"Load a SHARP bitmap FITS file as a binary (1, H, W) float32 mask.\"\"\"\n191\t        with fits.open(path) as hdul:\n192\t            data = np.asarray(hdul[0].data)\n193\t        mask = np.nan_to_num(data, nan=0.0)\n194\t        mask = (mask > 0).astype(np.float32)  # binarize defensively\n195\t        return mask[None, :, :]  # (1, H, W) -- channel-first, matches ts/forecast convention\n196\t\n197\t    def __getitem__(self, idx: int) -> dict:\n198\t        \"\"\"\n199\t        Args:\n200\t            idx: Dataset index.\n201\t\n202\t        Returns:\n203\t            Dictionary containing:\n204\t                forecast (np.float32): Binary flare-region mask, shape (1, H, W).\n205\t                ds_index (str): ISO-format timestamp from the flare index.\n206\t            When ``return_surya_stack=True``, also includes all keys from\n207\t            ``HelioNetCDFDataset.__getitem__`` (ts, time_delta_input, lead_time_delta, etc.).\n208\t        \"\"\"\n209\t        sample = super().__getitem__(idx=idx) if self.return_surya_stack else {}\n210\t        mask_path = self.df_valid_indices.iloc[idx][\"mask_path\"]\n211\t        sample[\"forecast\"] = self._load_mask(mask_path)\n212\t        sample[\"ds_index\"] = self.df_valid_indices[\"ds_index\"].iloc[idx].isoformat()\n213\t        return sample\n214\t"
          },
          {
            "raw_input": {
              "file_path": "/home/jovyan/adi_wdir/surya_workshop/downstream_apps/sf_triggers/models/simple_baseline.py"
            },
            "tool_call_id": "toolu_bdrk_01AiPLoKumgKqBJR3mnYePc7",
            "title": "Read models/simple_baseline.py",
            "raw_output": "1\t\"\"\"\n2\tA simple linear regression model to be used as a baseline for flare forecasting.\n3\t\"\"\"\n4\t\n5\timport torch\n6\timport torch.nn as nn\n7\tfrom einops import rearrange\n8\t\n9\t\n10\tdef destandardize_channels(batch: dict, channel_order: list, scalers: dict) -> dict:\n11\t    \"\"\"Return a new batch dict with 'ts' moved from normalized space to signum-log space.\n12\t\n13\t    This undoes the per-channel z-score ONLY. The signum-log compression applied by the\n14\t    dataset is deliberately left in place, so the result is\n15\t    ``sign(x*s) * log1p(|x*s|)`` \u2014 not raw DN/Gauss. Values spanning many orders of\n16\t    magnitude make poor features for a single linear layer, so log space is what the\n17\t    baseline wants.\n18\t\n19\t    If you need true physical units (plotting, a physical-space loss), use\n20\t    ``HelioNetCDFDataset.inverse_transform_data()`` instead, which undoes both stages.\n21\t    See the \"THE THREE SPACES\" block in ``workshop_infrastructure/datasets/helio.py``.\n22\t\n23\t    Args:\n24\t        batch: Batch dict containing at minimum a 'ts' key with shape (B, C, T, H, W).\n25\t        channel_order: Channel names in the same order as the C dimension of 'ts'.\n26\t        scalers: Dict mapping channel name -> scaler with an inverse_transform method.\n27\t\n28\t    Returns:\n29\t        A new batch dict with 'ts' replaced by the de-standardized (signum-log) tensor.\n30\t    \"\"\"\n31\t    x = batch[\"ts\"].clone()\n32\t    with torch.no_grad():\n33\t        for i, channel in enumerate(channel_order):\n34\t            x[:, i, ...] = scalers[channel].inverse_transform(x[:, i, ...])\n35\t    return {**batch, \"ts\": x}\n36\t\n37\t\n38\tclass RegressionFlareModel(nn.Module):\n39\t    def __init__(self, input_dim: int):\n40\t        \"\"\"\n41\t        Initializes the RegressionFlareModel.\n42\t\n43\t        Args:\n44\t            input_dim (int): The size of the input vector after channel and time dimensions are flattened.\n45\t\n46\t        Note:\n47\t            This model expects 'ts' in the batch dict to already be in **signum-log** space\n48\t            (channel z-scores undone, log compression retained). Use\n49\t            destandardize_channels() to pre-process normalized SDO inputs before passing\n50\t            them here (e.g., via the preprocess_fn argument of FlareLightningModule).\n51\t        \"\"\"\n52\t        super().__init__()\n53\t        self.linear = nn.Linear(input_dim, 1)\n54\t\n55\t    def forward(self, x: dict) -> torch.Tensor:\n56\t        \"\"\"\n57\t        Performs a forward pass through the model.\n58\t\n59\t        Args:\n60\t            x (dict): Batch dict with 'ts' of shape (B, C, T, H, W) in signum-log space.\n61\t\n62\t        B - Batch size\n63\t        C - Channels\n64\t        T - Time steps\n65\t        H - Height\n66\t        W - Width\n67\t        \"\"\"\n68\t        x = x[\"ts\"]\n69\t\n70\t        # Collapse input stack spatially and take absolute value for strictly positive flare fluxes\n71\t        x = x.abs().mean(dim=[3, 4])\n72\t\n73\t        # Rearrange in preparation for linear layer\n74\t        x = rearrange(x, \"b c t -> b (c t)\")\n75\t\n76\t        return self.linear(x)",
            "kind": "read",
            "locations": [
