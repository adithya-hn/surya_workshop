            "kind": "other",
            "raw_output": "{\"result\":[{\"cellType\":\"code\",\"source\":\"# One implementation, shared by the notebooks, the training script and the\\n# download_*.sh wrappers: workshop_infrastructure/assets.py.\\n# The linear baseline needs no backbone, so skip the 1.8 GB weights.\\nfrom workshop_infrastructure.assets import ensure_assets\\n\\nensure_assets(cfg, which=[\\\"scalers\\\"])\\n\\n# Now that scalers.yaml is guaranteed to be on disk, load it. build_scalers()\\n# accepts the resolved path directly.\\nscalers = build_scalers(info=cfg.data.scalers_path)\\nprint(f\\\"Loaded scalers for {len(scalers)} channels.\\\")\\n\",\"execution_count\":5,\"cell_id\":\"c74728d9\",\"language\":\"python\",\"outputs\":[{\"output_type\":\"error\",\"text\":\"ModuleNotFoundError: No module named 'workshop_infrastructure'\\n\\u001b[0;31m---------------------------------------------------------------------------\\u001b[0m\\n\\u001b[0;31mModuleNotFoundError\\u001b[0m                       Traceback (most recent call last)\\nCell \\u001b[0;32mIn[5], line 4\\u001b[0m\\n\\u001b[1;32m      1\\u001b[0m \\u001b[38;5;66;03m# One implementation, shared by the notebooks, the training script and the\\u001b[39;00m\\n\\u001b[1;32m      2\\u001b[0m \\u001b[38;5;66;03m# download_*.sh wrappers: workshop_infrastructure/assets.py.\\u001b[39;00m\\n\\u001b[1;32m      3\\u001b[0m \\u001b[38;5;66;03m# The linear baseline needs no backbone, so skip the 1.8 GB weights.\\u001b[39;00m\\n\\u001b[0;32m----> 4\\u001b[0m \\u001b[38;5;28;01mfrom\\u001b[39;00m\\u001b[38;5;250m \\u001b[39m\\u001b[38;5;21;01mworkshop_infrastructure\\u001b[39;00m\\u001b[38;5;21;01m.\\u001b[39;00m\\u001b[38;5;21;01massets\\u001b[39;00m\\u001b[38;5;250m \\u001b[39m\\u001b[38;5;28;01mimport\\u001b[39;00m ensure_assets\\n\\u001b[1;32m      6\\u001b[0m ensure_assets(cfg, which\\u001b[38;5;241m=\\u001b[39m[\\u001b[38;5;124m\\\"\\u001b[39m\\u001b[38;5;124mscalers\\u001b[39m\\u001b[38;5;124m\\\"\\u001b[39m])\\n\\u001b[1;32m      8\\u001b