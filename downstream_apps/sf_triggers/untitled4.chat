            "kind": "execute",
            "raw_output": "diff --git a/downstream_apps/sf_triggers/models/simple_baseline.py b/downstream_apps/sf_triggers/models/simple_baseline.py\nindex 009017b..2c76f03 100644\n--- a/downstream_apps/sf_triggers/models/simple_baseline.py\n+++ b/downstream_apps/sf_triggers/models/simple_baseline.py\n@@ -66,11 +66,20 @@ class RegressionFlareModel(nn.Module):\n         W - Width\n         \"\"\"\n         x = x[\"ts\"]\n+        B,C,T,H,W = x.shape\n \n         # Collapse input stack spatially and take absolute value for strictly positive flare fluxes\n-        x = x.abs().mean(dim=[3, 4])\n-\n+        x = x.abs()#.mean(dim=[3, 4])\n+        print('====================')\n         # Rearrange in preparation for linear layer\n-        x = rearrange(x, \"b c t -> b (c t)\")\n+        print(x.shape)\n+        x = rearrange(x, \"b c t h w -> (b h w) (c t)\")\n+        print(x.shape)\n+        x = self.linear(x)\n+        print(x.shape)\n+        x = rearrange(x,\"(b h w) ->  b h w \",b=B,h=H, w=W)\n+        print(x.shape)\n+        \n+        \n \n         return self.linear(x)\n\\ No newline at end of file\nShell cwd was reset to /home/jovyan/adi_wdir/surya_workshop/downstream_apps/sf_triggers",
            "status": "completed"
