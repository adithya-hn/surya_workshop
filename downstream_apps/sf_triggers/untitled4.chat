            "status": "completed",
            "raw_output": "1\t#!/usr/bin/env python3\n2\t\"\"\"\n3\tRunnable finetuning script derived from `2_finetune_template_1D.ipynb`.\n4\t\n5\tDesign goals\n6\t- Config-driven: all hyperparameters live in config_script.yaml\n7\t- Minimal CLI: --config plus a handful of per-run overrides\n8\t- Multi-GPU capable (DDP) when run as a script\n9\t\n10\tAssumptions\n11\t- Assets (`scalers.yaml` + model weights) are downloaded automatically on first run.\n12\t- You run this script from the repo root and specify devices via CUDA_VISIBLE_DEVICES:\n13\t    CUDA_VISIBLE_DEVICES=0,1 python -m downstream_apps.template.3_finetune_template_1D \\\n14\t        --config downstream_apps/template/configs/config_script.yaml\n15\t\n16\tAll parameters live in the YAML. The CLI overrides only what genuinely varies between\n17\truns of the same config: --max-epochs and --batch-size (sweeps), --s3-cache-dir\n18\t(per-machine scratch) and --deterministic (reproducibility, off by default for speed).\n19\tEverything else is a config edit.\n20\t\n21\tForking this script: build_datasets() and build_model() are the only two functions with\n22\ttask-specific content. build_trainer() and main() should need no changes.\n23\t\"\"\"\n24\t\n25\tfrom __future__ import annotations\n26\t\n27\timport argparse\n28\timport os\n29\t\n30\t# Must be set BEFORE torch is imported: cuBLAS reads this once, when it initializes, so\n31\t# setting it later has no effect. Deterministic cuBLAS on CUDA >= 10.2 requires it, and\n32\t# without it every run under training.deterministic warns (or raises, when set to true).\n33\t# setdefault so a deliberate \":16:8\" (smaller workspace, slightly slower) is respected.\n34\tos.environ.setdefault(\"CUBLAS_WORKSPACE_CONFIG\", \":4096:8\")\n35\t\n36\tfrom pathlib import Path\n37\tfrom typing import Tuple\n38\t\n39\timport torch\n40\timport lightning as L\n41\tfrom lightning.pytorch.callbacks import ModelCheckpoint\n42\tfrom lightning.pytorch.loggers import CSVLogger, WandbLogger\n43\tfrom torch.utils.data import DataLoader\n44\t\n45\tfrom downstream_apps.template.configs import TrainingConfig, load_flare_config\n46\tfrom downstream_apps.template.datasets.template_dataset import FlareDSDataset\n47\tfrom downstream_apps.template.lightning_modules.pl_simple_baseline import FlareLightningModule\n48\tfrom downstream_apps.template.metrics.template_metrics import FlareMetrics\n49\tfrom workshop_infrastructure.assets import ensure_assets\n50\tfrom workshop_infrastructure.datasets.builders import build_helio_dataloaders\n51\tfrom workshop_infrastructure.utils import (\n52\t    apply_peft_lora,\n53\t    build_scalers,\n54\t    load_pretrained_weights,\n55\t    UploadBestCheckpointToS3,\n56\t)\n57\t\n58\tDEFAULT_CONFIG = Path(__file__).parent / \"configs\" / \"config_script.yaml\"\n59\t\n60\t# --deterministic accepts the same three tokens as the YAML key. argparse hands back a\n61\t# string, so the two boolean ones are mapped to real bools -- TrainingConfig validates\n62\t# against True/False/\"warn\", not against their spellings.\n63\t_DETERMINISTIC_CLI = {\"false\": False, \"warn\": \"warn\", \"true\": True}\n64\t\n65\t\n66\t# ---------------------------------------------------------------------------\n67\t# Build functions\n68\t# ---------------------------------------------------------------------------\n69\t\n70\tdef parse_args() -> argparse.Namespace:\n71\t    parser = argparse.ArgumentParser()\n72\t    parser.add_argument(\"--config\", type=str, default=str(DEFAULT_CONFIG),\n73\t                        help=\"Path to the run config YAML (default: this app's config_script.yaml).\")\n74\t    # Dev toggles: flip without editing the YAML\n75\t    parser.add_argument(\"--no-wandb\", action=\"store_true\",\n76\t                        help=\"Disable WandB logging (useful for local runs).\")\n77\t    parser.add_argument(\"--train_baseline\", action=\"store_true\",\n78\t                        help=\"Train the simple linear baseline instead of HelioSpectformer.\")\n79\t    # Per-job / per-machine overrides: vary across runs without touching the YAML\n80\t    parser.add_argument(\"--max-epochs\", type=int, default=None,\n81\t                        help=\"Override training.max_epochs from the config YAML.\")\n82\t    parser.add_argument(\"--batch-size\", type=int, default=None,\n83\t                        help=\"Override training.batch_size from the config YAML.\")\n84\t    parser.add_argument(\"--s3-cache-dir\", type=str, default=None,\n85\t                        help=\"Override data.s3_cache_dir (the local cache for S3 reads). \"\n86\t                             \"Handy when the same config runs on machines with different scratch.\")\n87\t    parser.add_argument(\"--deterministic\", choices=tuple(_DETERMINISTIC_CLI), default=None,\n88\t                        help=\"Override training.deterministic. The config default is 'false', \"\n89\t                             \"which trades reproducibility for roughly 20%% throughput. Pass \"\n90\t                             \"'warn' when you need to tell whether a change in your results came \"\n91\t                             \"from your edit or from run-to-run drift.\")\n92\t    return parser.parse_args()\n93\t\n94\t\n95\tdef _flare_label_transform(intensity: \"pd.Series\") -> \"pd.Series\":\n96\t    \"\"\"Normalize flare peak intensity for the template task.\n97\t\n98\t    Converts raw GOES intensity to a z-score-like label:\n99\t      1. Take log10 (intensity values span many orders of magnitude).\n100\t      2. Shift so the minimum is 0.\n101\t      3. Scale by 2 * std so most values fall in [-1, 1].\n102\t    \"\"\"\n103\t    import numpy as np\n104\t    log_intensity = np.log10(intensity)\n105\t    shifted = log_intensity - log_intensity.min()\n106\t    return shifted / (2 * shifted.std())\n107\t\n108\t\n109\tdef build_datasets(cfg: TrainingConfig, scalers) -> Tuple[DataLoader, DataLoader]:\n110\t    \"\"\"Create train and validation DataLoaders from config.\n111\t\n112\t    Everything generic (channels, temporal sampling, S3 access, worker settings) is\n113\t    handled by build_helio_dataloaders(). Only the flare-specific arguments below are\n114\t    this app's business \u2014 when you fork the template, this is the list you replace.\n115\t\n116\t    ``scalers`` is built once in main() and shared with build_model(), so the two paths\n117\t    cannot end up with different normalization statistics.\n118\t    \"\"\"\n119\t    return build_helio_dataloaders(\n120\t        cfg,\n121\t        FlareDSDataset,\n122\t        scalers=scalers,\n123\t        seed=cfg.seed,\n124\t        return_surya_stack=True,\n125\t        max_number_of_samples=cfg.data.max_samples,\n126\t        label_transform=_flare_label_transform,\n127\t        ds_flare_index_path=cfg.data.flare_index_path,\n128\t        ds_time_column=cfg.data.ds_time_column,\n129\t        ds_time_tolerance=cfg.data.ds_time_tolerance,\n130\t        ds_match_direction=cfg.data.ds_match_direction,\n131\t    )\n132\t\n133\t\n134\tdef build_model(cfg: TrainingConfig, scalers, train_baseline: bool = False) -> L.LightningModule:\n135\t    \"\"\"Instantiate the model and wrap it in a LightningModule.\n136\t\n137\t    ``scalers`` is only needed by the linear baseline, which consumes its inputs in\n138\t    signum-log space; the HelioSpectformer path works directly on normalized inputs.\n139\t    \"\"\"\n140\t    metrics = {\n141\t        \"train_loss\": FlareMetrics(\"train_loss\"),\n142\t        # val_loss is what ModelCheckpoint monitors; val_metrics are reported only.\n143\t        \"val_loss\": FlareMetrics(\"val_loss\"),\n144\t        \"train_metrics\": FlareMetrics(\"train_metrics\"),\n145\t        \"val_metrics\": FlareMetrics(\"val_metrics\"),\n146\t    }\n147\t\n148\t    if train_baseline:\n149\t        from functools import partial\n150\t        from downstream_apps.template.models.simple_baseline import (\n151\t            RegressionFlareModel,\n152\t            destandardize_channels,\n153\t        )\n154\t        n_input_timestamps = cfg.model.time_embedding.time_dim\n155\t        n_channels = len(cfg.data.channels)\n156\t        model = RegressionFlareModel(n_input_timestamps * n_channels)\n157\t        preprocess_fn = partial(destandardize_channels, channel_order=cfg.data.channels, scalers=scalers)\n158\t        return FlareLightningModule(model, metrics, lr=cfg.learning_rate, batch_size=cfg.batch_size, preprocess_fn=preprocess_fn)\n159\t    else:\n160\t        from workshop_infrastructure.models.finetune_models import HelioSpectformer1D\n161\t        model = HelioSpectformer1D.from_config(\n162\t            cfg.model,\n163\t            num_outputs=1,\n164\t            dtype=cfg.dtype,\n165\t            use_latitude_in_learned_flow=cfg.use_latitude_in_learned_flow,\n166\t        )\n167\t        load_pretrained_weights(model, cfg.model.pretrained_path)\n168\t\n169\t        # Three fine-tuning regimes, selected from the model: section of the YAML:\n170\t        #   use_lora: true                        -> LoRA adapters (default)\n171\t        #   use_lora: false, freeze_backbone: true  -> linear probe (head only)\n172\t        #   use_lora: false, freeze_backbone: false -> full fine-tuning\n173\t        if cfg.model.freeze_backbone:\n174\t            for name, param in model.named_parameters():\n175\t                if name.startswith(\"backbone.\"):\n176\t                    param.requires_grad = False\n177\t        if cfg.model.use_lora:\n178\t            model = apply_peft_lora(model, cfg.model.lora_config)\n179\t\n180\t        _log_trainable_parameters(model)\n181\t\n182\t    return FlareLightningModule(model, metrics, lr=cfg.learning_rate, batch_size=cfg.batch_size)\n183\t\n184\t\n185\tdef _log_trainable_parameters(model) -> None:\n186\t    \"\"\"Print the trainable/total parameter counts, so the chosen regime is visible in the log.\"\"\"\n187\t    trainable = sum(p.numel() for p in model.parameters() if p.requires_grad)\n188\t    total = sum(p.numel() for p in model.parameters())\n189\t    pct = 100.0 * trainable / total if total else 0.0\n190\t    print(f\"[MODEL] Trainable parameters: {trainable:,} / {total:,} ({pct:.2f}%)\")\n191\t\n192\t\n193\tdef build_trainer(\n194\t    cfg: TrainingConfig,\n195\t    no_wandb: bool = False,\n196\t    max_epochs_override: int | None = None,\n197\t) -> Tuple[L.Trainer, ModelCheckpoint]:\n198\t    \"\"\"Configure loggers, callbacks, and the Lightning Trainer.\"\"\"\n199\t    max_epochs = max_epochs_override if max_epochs_override is not None else cfg.max_epochs\n200\t\n201\t    loggers = []\n202\t    if not no_wandb:\n203\t        loggers.append(WandbLogger(\n204\t            entity=cfg.wandb_entity,  # None = personal account; set in YAML for team runs\n205\t            project=cfg.wandb_project,\n206\t            name=cfg.job_id,\n207\t            log_model=False,\n208\t            save_dir=os.environ.get(\"TMPDIR\", \"./wandb/wandb_tmp\"),\n209\t        ))\n210\t    loggers.append(CSVLogger(\"runs\", name=cfg.job_id))\n211\t\n212\t    Path(cfg.output.ckpt_dir).mkdir(parents=True, exist_ok=True)\n213\t    checkpoint_cb = ModelCheckpoint(\n214\t        dirpath=cfg.output.ckpt_dir,\n215\t        filename=\"best-{epoch:02d}-{val_loss:.4f}\",\n216\t        monitor=\"val_loss\",\n217\t        mode=\"min\",\n218\t        save_top_k=1,\n219\t        save_last=False,\n220\t    )\n221\t    upload_cb = UploadBestCheckpointToS3(\n222\t        checkpoint_cb=checkpoint_cb,\n223\t        bucket=cfg.output.s3_bucket,\n224\t        prefix=cfg.output.s3_prefix,\n225\t        fixed_key_name=(cfg.output.s3_best_key or None),\n226\t    )\n227\t\n228\t    trainer = L.Trainer(\n229\t        max_epochs=max_epochs,\n230\t        accelerator=\"gpu\" if torch.cuda.is_available() else \"cpu\",\n231\t        devices=\"auto\",\n232\t        strategy=\"auto\",\n233\t        precision=\"bf16-mixed\" if torch.cuda.is_available() else \"32-true\",\n234\t        # Reproducibility. \"warn\" (the default) gives bit-identical runs wherever a\n235\t        # deterministic kernel exists and names the op where one does not, instead of\n236\t        # killing the run. benchmark is pinned rather than inherited: cuDNN autotuning\n237\t        # picks algorithms by timing, so leaving it on would reintroduce run-to-run drift.\n238\t        deterministic=cfg.deterministic,\n239\t        benchmark=False,\n240\t        logger=loggers,\n241\t        callbacks=[checkpoint_cb, upload_cb],\n242\t        log_every_n_steps=2,\n243\t    )\n244\t    return trainer, checkpoint_cb\n245\t\n246\t\n247\t# ---------------------------------------------------------------------------\n248\t# Entry point\n249\t# ---------------------------------------------------------------------------\n250\t\n251\tdef main() -> None:\n252\t    args = parse_args()\n253\t    torch.set_float32_matmul_precision(\"medium\")\n254\t\n255\t    cfg = load_flare_config(args.config)\n256\t    # Seeding comes after the config load, so the seed is a configured value rather than\n257\t    # a constant buried in the code. Seeds Python, NumPy and torch in this process;\n258\t    # workers=True extends it to DataLoader workers.\n259\t    L.seed_everything(cfg.seed, workers=True)\n260\t    if args.batch_size is not None:\n261\t        cfg.batch_size = args.batch_size\n262\t    if args.s3_cache_dir is not None:\n263\t        cfg.data.s3_cache_dir = args.s3_cache_dir\n264\t    if args.deterministic is not None:\n265\t        cfg.deterministic = _DETERMINISTIC_CLI[args.deterministic]\n266\t    # Fetch scalers, and the backbone weights unless we are training the baseline.\n267\t    ensure_assets(cfg, which=[\"scalers\"] if args.train_baseline else [\"scalers\", \"weights\"])\n268\t\n269\t    # Built once and shared: the dataset normalizes with these, and the linear baseline\n270\t    # de-standardizes with them. Two separate builds could silently disagree.\n271\t    scalers = build_scalers(info=cfg.data.scalers_path)\n272\t\n273\t    train_loader, val_loader = build_datasets(cfg, scalers)\n274\t    lit_model = build_model(cfg, scalers, train_baseline=args.train_baseline)\n275\t    trainer, checkpoint_cb = build_trainer(cfg, no_wandb=args.no_wandb, max_epochs_override=args.max_epochs)\n276\t\n277\t    trainer.fit(lit_model, train_loader, val_loader)\n278\t\n279\t    if checkpoint_cb.best_model_path:\n280\t        print(f\"[CKPT] Best checkpoint: {checkpoint_cb.best_model_path}\")\n281\t        if checkpoint_cb.best_model_score is not None:\n282\t            print(f\"[CKPT] Best val_loss: {float(checkpoint_cb.best_model_score):.6f}\")\n283\t    else:\n284\t        print(\"[CKPT] No best checkpoint was saved.\")\n285\t\n286\t\n287\tif __name__ == \"__main__\":\n288\t    main()\n289\t",
            "tool_call_id": "toolu_bdrk_01KSdb7biZjy4ZUwWtdn4xEA",
            "kind": "read",
