            "raw_output": "/home/jovyan/adi_wdir/surya_workshop/downstream_apps/sf_triggers/2_finetune_template_1D.ipynb\n/home/jovyan/adi_wdir/surya_workshop/downstream_apps/sf_triggers/A_shapes_and_broadcasting.ipynb\n/home/jovyan/adi_wdir/surya_workshop/downstream_apps/sf_triggers/0_dataset_dataloader_template.ipynb\n/home/jovyan/adi_wdir/surya_workshop/downstream_apps/sf_triggers/1_baseline_template.ipynb\n/home/jovyan/adi_wdir/surya_workshop/downstream_apps/sf_triggers/.ipynb_checkpoints/1_baseline_template-checkpoint.ipynb\n/home/jovyan/adi_wdir/surya_workshop/downstream_apps/sf_triggers/.ipynb_checkpoints/0_dataset_dataloader_template-checkpoint.ipynb",
