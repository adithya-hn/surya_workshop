          {
            "selected_option_id": "allow-once",
            "raw_input": {
              "command": "git remote -v && echo \"---\" && git config --get credential.helper && echo \"---global---\" && git config --global --get credential.helper && echo \"---\" && cat ~/.git-credentials 2>/dev/null | sed 's/:[^:@]*@/:***@/' ",
              "description": "Check git remote URL and credential helper config"
            },
            "status": "failed",
            "title": "git remote -v && echo \"---\" && git config --get credential.helper && echo \"---global---\" && git config --global --get credential.helper && echo \"---\" && cat ~/.git-credentials 2>/dev/null | sed 's/:[^:@]*@/:***@/'",
