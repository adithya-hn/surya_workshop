            "raw_output": "95\tdef _flare_label_transform(intensity: \"pd.Series\") -> \"pd.Series\":\n96\t    \"\"\"Normalize flare peak intensity for the template task.\n97\t\n98\t    Converts raw GOES intensity to a z-score-like label:\n99\t      1. Take log10 (intensity values span many orders of magnitude).\n100\t      2. Shift so the minimum is 0.\n101\t      3. Scale by 2 * std so most values fall in [-1, 1].\n102\t    \"\"\"\n103\t    import numpy as np\n104\t    log_intensity = np.log10(intensity)\n105\t    shifted = log_intensity - log_intensity.min()\n106\t    return shifted / (2 * shifted.std())\n107\t\n108\t\n109\tdef build_datasets(cfg: TrainingConfig, scalers) -> Tuple[DataLoader, DataLoader]:\n110\t    \"\"\"Create train and validation DataLoaders from config.\n111\t\n112\t    Everything generic (channels, temporal sampling, S3 access, worker settings) is\n113\t    handled by build_helio_dataloaders(). Only the flare-specific arguments below are\n114\t    this app's business \u2014 when you fork the template, this is the list you replace.\n115\t\n116\t    ``scalers`` is built once in main() and shared with build_model(), so the two paths\n117\t    cannot end up with different normalization statistics.\n118\t    \"\"\"\n119\t    return build_helio_dataloaders(\n120\t        cfg,\n121\t        FlareDSDataset,\n122\t        scalers=scalers,\n123\t        seed=cfg.seed,\n124\t        return_surya_stack=True,\n125\t        max_number_of_samples=cfg.data.max_samples,\n126\t        label_transform=_flare_label_transform,\n127\t        ds_flare_index_path=cfg.data.flare_index_path,\n128\t        ds_time_column=cfg.data.ds_time_column,\n129\t        ds_time_tolerance=cfg.data.ds_time_tolerance,\n130\t        ds_match_direction=cfg.data.ds_match_direction,\n131\t    )\n132\t\n133\t\n134\tdef build_model(cfg: TrainingConfig, scalers, train_baseline: bool = False) -> L.LightningModule:\n135\t    \"\"\"Instantiate the model and wrap it in a LightningModule.\n136\t\n137\t    ``scalers`` is only needed by the linear baseline, which consumes its inputs in\n138\t    signum-log space; the HelioSpectformer path works directly on normalized inputs.\n139\t    \"\"\"",
            "raw_input": {
