            "raw_output": "1\t\"\"\"\n2\tTask-specific configuration for the flare-forecasting template app.\n3\t\n4\tEverything generic \u2014 paths, channels, temporal sampling, S3 settings, the model and\n5\tLoRA configs, the training and logging sections, and ``load_config()`` itself \u2014 lives in\n6\t``workshop_infrastructure/configs.py``. This file holds only what is specific to *this*\n7\ttask: the flare catalog and how its events are aligned to the Surya index.\n8\t\n9\t**This is the pattern to copy when you fork the template.** Subclass ``DataConfig`` with\n10\tyour task's fields, then bind ``load_config`` to it. You never maintain a copy of the\n11\tbase config.\n12\t\"\"\"\n13\t\n14\tfrom __future__ import annotations\n15\t\n16\tfrom dataclasses import dataclass\n17\tfrom functools import partial\n18\tfrom typing import ClassVar\n19\t\n20\tfrom workshop_infrastructure.configs import (  # re-exported for convenience\n21\t    DataConfig,\n22\t    LoraAdapterConfig,\n23\t    ModelConfig,\n24\t    OutputConfig,\n25\t    TimeEmbeddingConfig,\n26\t    TrainingConfig,\n27\t    load_config,\n28\t)\n29\t\n30\t\n31\t@dataclass\n32\tclass FlareDataConfig(DataConfig):\n33\t    \"\"\"DataConfig plus the flare-catalog alignment settings used by ``FlareDSDataset``.\n34\t\n35\t    These keys are what makes this app's ``data:`` section different from any other\n36\t    downstream task's. Swap them for your own when you fork.\n37\t    \"\"\"\n38\t    # Path to the label catalog (relative paths resolve against the config file's dir).\n39\t    flare_index_path: str = \"\"\n40\t    # Column in the catalog holding the event timestamp.\n41\t    ds_time_column: str = \"start_time\"\n42\t    # Max allowed gap when matching catalog events to Surya timesteps.\n43\t    ds_time_tolerance: str = \"4d\"\n44\t    # \"forward\" uses the solar state *before* the flare (causal prediction).\n45\t    ds_match_direction: str = \"forward\"\n46\t    # Directory of SHARP bitmap FITS masks, one per flare event.\n47\t    mask_dir: str = \"\"\n48\t    # Max allowed gap when matching catalog rows to mask-file timestamps.\n49\t    mask_time_tolerance: str = \"10min\"\n50\t\n51\t    # flare_index_path and mask_dir are paths, so they must join the base class's list to\n52\t    # get the same relative-to-the-config-file resolution. Extend this whenever you add a\n53\t    # path field.\n54\t    PATH_FIELDS: ClassVar[tuple[str, ...]] = DataConfig.PATH_FIELDS + (\n55\t        \"flare_index_path\",\n56\t        \"mask_dir\",\n57\t    )\n58\t\n59\t\n60\t# The app's entry point. Identical to load_config() except that the data: section is\n61\t# parsed into FlareDataConfig, so the four keys above are recognized instead of rejected.\n62\tload_flare_config = partial(load_config, data_cls=FlareDataConfig)\n63\t\n64\t\n65\t__all__ = [\n66\t    \"FlareDataConfig\",\n67\t    \"load_flare_config\",\n68\t    # Re-exports so app code can import everything config-related from one place.\n69\t    \"DataConfig\",\n70\t    \"OutputConfig\",\n71\t    \"TrainingConfig\",\n72\t    \"ModelConfig\",\n73\t    \"LoraAdapterConfig\",\n74\t    \"TimeEmbeddingConfig\",\n75\t    \"load_config\",\n76\t]\n77\t",
