              "file_path": "/home/jovyan/adi_wdir/surya_workshop/downstream_apps/sf_triggers/datasets/sf_triggers_dataset.py"
            },
            "raw_output": "1\timport re\n2\tfrom pathlib import Path\n3\tfrom typing import Literal\n4\t\n5\timport numpy as np\n6\timport pandas as pd\n7\tfrom astropy.io import fits\n8\t\n9\tfrom workshop_infrastructure.datasets.helio import HelioNetCDFDataset\n10\t\n11\t# SHARP bitmap filenames are the only place the HARP number and observation timestamp\n12\t# are recorded -- there is no sidecar index mapping catalog rows to mask files.\n13\t_MASK_FILENAME_RE = re.compile(\n14\t    r\"hmi\\.sharp_720s\\.(?P<harp>\\d+)\\.(?P<date>\\d{8})_(?P<time>\\d{6})_TAI\\.bitmap\\.fits$\"\n15\t)\n16\t\n17\t\n18\tdef _scan_mask_dir(mask_dir: str) -> pd.DataFrame:\n19\t    \"\"\"Parse HARP number + timestamp out of every SHARP bitmap filename in ``mask_dir``.\"\"\"\n20\t    rows = []\n21\t    for path in sorted(Path(mask_dir).glob(\"*.bitmap.fits\")):\n22\t        m = _MASK_FILENAME_RE.match(path.name)\n23\t        if m is None:\n24\t            continue\n25\t        ts = pd.Timestamp(\n26\t            f\"{m['date'][:4]}-{m['date'][4:6]}-{m['date'][6:]}\"\n27\t            f\"T{m['time'][:2]}:{m['time'][2:4]}:{m['time'][4:]}\"\n28\t        )\n29\t        rows.append({\"harp\": int(m[\"harp\"]), \"mask_ts\": ts, \"mask_path\": str(path)})\n30\t    if not rows:\n31\t        raise ValueError(f\"No SHARP bitmap files found in {mask_dir}\")\n32\t    return pd.DataFrame(rows).sort_values(\"mask_ts\")\n33\t\n34\t\n35\tclass FlareDSDataset(HelioNetCDFDataset):\n36\t    \"\"\"\n37\t    Template child class of HelioNetCDFDataset showing how to build a downstream dataset.\n38\t    Extends the base class with a flare-region spatial mask label aligned to the Surya index.\n39\t\n40\t    All ``HelioNetCDFDataset`` keyword arguments (``index_path``, ``scalers``, ``channels``,\n41\t    ``s3_cache_dir``, etc.) are accepted via ``**kwargs`` and forwarded to the base class.\n42\t    ``load_forecast_frames`` defaults to ``False`` here (flare forecasting supplies its own\n43\t    labels, so future Surya frames are never fetched); pass it explicitly to override.\n44\t\n45\t    Additional Args:\n46\t        return_surya_stack: If True (default), include the Surya image stack in the returned dict.\n47\t            Set to False to return only the flare mask label (useful for label inspection).\n48\t        max_number_of_samples: Cap the dataset length at this value. Useful for quick experiments.\n49\t        ds_flare_index_path: Path to the downstream flare catalog CSV index.\n50\t        ds_time_column: Column name in the flare index to use as the event timestamp.\n51\t        ds_time_tolerance: Maximum allowed time offset when matching Surya and DS indices\n52\t            (e.g., ``\"15min\"``). Unmatched entries are dropped.\n53\t        ds_match_direction: Merge direction passed to ``pd.merge_asof``. Use ``\"forward\"``\n54\t            for causal prediction (predict flares from prior solar state).\n55\t        mask_dir: Directory of SHARP bitmap FITS masks (one per flare event), named\n56\t            ``hmi.sharp_720s.<HARPNUM>.<YYYYMMDD>_<HHMMSS>_TAI.bitmap.fits``.\n57\t        mask_time_tolerance: Maximum allowed gap between a catalog row's event timestamp and\n58\t            a mask file's embedded timestamp when matching the two (e.g., ``\"10min\"``).\n59\t\n60\t    Raises:\n61\t        ValueError: If ``ds_flare_index_path`` or ``mask_dir`` is not provided, if no overlap\n62\t            exists between the Surya and DS indices within the specified tolerance, or if any\n63\t            catalog row has no matching mask file within ``mask_time_tolerance``.\n64\t    \"\"\"\n65\t\n66\t    def __init__(\n67\t        self,\n68\t        # Downstream-specific parameters\n69\t        return_surya_stack: bool = True,\n70\t        max_number_of_samples: int | None = None,\n71\t        ds_flare_index_path: str | None = None,\n72\t        ds_time_column: str | None = None,\n73\t        ds_time_tolerance: str | None = None,\n74\t        ds_match_direction: Literal[\"forward\", \"backward\", \"nearest\"] = \"forward\",\n75\t        mask_dir: str | None = None,\n76\t        mask_time_tolerance: str = \"10min\",\n77\t        # All HelioNetCDFDataset parameters (index_path, scalers, channels, s3_*, etc.)\n78\t        **kwargs,\n79\t    ):\n80\t        if ds_match_direction not in [\"forward\", \"backward\", \"nearest\"]:\n81\t            raise ValueError(\"ds_match_direction must be one of 'forward', 'backward', or 'nearest'\")\n82\t        if mask_dir is None:\n83\t            raise ValueError(\"mask_dir must be provided for FlareDSDataset\")\n84\t\n85\t        # load_forecast_frames defaults to False here: flare forecasting supplies its\n86\t        # own labels, so future Surya frames never need to be fetched from disk/S3.\n87\t        kwargs.setdefault(\"load_forecast_frames\", False)\n88\t        super().__init__(**kwargs)\n89\t\n90\t        self.return_surya_stack = return_surya_stack\n91\t\n92\t        # Load ds index and find intersection with Surya index\n93\t        if ds_flare_index_path is not None:\n94\t            self.ds_index = pd.read_csv(ds_flare_index_path)\n95\t        else:\n96\t            raise ValueError(\"ds_flare_index_path must be provided for FlareDSDataset\")\n97\t\n98\t        self.ds_index[\"ds_index\"] = pd.to_datetime(\n99\t            self.ds_index[ds_time_column]\n100\t        ).values.astype(\"datetime64[ns]\")\n101\t        self.ds_index.sort_values(\"ds_index\", inplace=True)\n102\t\n103\t        # Create Surya valid indices and find closest match to DS index\n104\t        self.df_valid_indices = pd.DataFrame(\n105\t            {\"valid_indices\": self.valid_indices}\n106\t        ).sort_values(\"valid_indices\")\n107\t        self.df_valid_indices = pd.merge_asof(\n108\t            self.df_valid_indices,\n109\t            self.ds_index,\n110\t            right_on=\"ds_index\",\n111\t            left_on=\"valid_indices\",\n112\t            direction=ds_match_direction,\n113\t        )\n114\t        # Remove duplicates keeping closest match\n115\t        self.df_valid_indices[\"index_delta\"] = np.abs(\n116\t            self.df_valid_indices[\"valid_indices\"] - self.df_valid_indices[\"ds_index\"]\n117\t        )\n118\t        self.df_valid_indices = self.df_valid_indices.sort_values(\n119\t            [\"ds_index\", \"index_delta\"]\n120\t        )\n121\t        self.df_valid_indices.drop_duplicates(\n122\t            subset=\"ds_index\", keep=\"first\", inplace=True\n123\t        )\n124\t        # Enforce a maximum time tolerance for matches\n125\t        if ds_time_tolerance is not None:\n126\t            self.df_valid_indices = self.df_valid_indices.loc[\n127\t                self.df_valid_indices[\"index_delta\"] <= pd.Timedelta(ds_time_tolerance),\n128\t                :,\n129\t            ]\n130\t            if len(self.df_valid_indices) == 0:\n131\t                raise ValueError(\"No intersection between Surya and DS indices\")\n132\t\n133\t        # Match each catalog row to its flare-region mask file by nearest timestamp.\n134\t        # self.df_valid_indices is sorted ascending by \"ds_index\" at this point, which\n135\t        # merge_asof requires.\n136\t        mask_index = _scan_mask_dir(mask_dir)\n137\t        self.df_valid_indices = pd.merge_asof(\n138\t            self.df_valid_indices,\n139\t            mask_index,\n140\t            left_on=\"ds_index\",\n141\t            right_on=\"mask_ts\",\n142\t            direction=\"nearest\",\n143\t            tolerance=pd.Timedelta(mask_time_tolerance),\n144\t        )\n145\t        unmatched = self.df_valid_indices[\"mask_path\"].isna()\n146\t        if unmatched.any():\n147\t            bad = self.df_valid_indices.loc[unmatched, \"ds_index\"].tolist()\n148\t            raise ValueError(\n149\t                f\"No mask file within {mask_time_tolerance} for ds_index timestamps: {bad}\"\n150\t            )\n151\t\n152\t        # Override valid indices variables to reflect matches between Surya and DS\n153\t        self.valid_indices = [\n154\t            pd.Timestamp(date) for date in self.df_valid_indices[\"valid_indices\"]\n155\t        ]\n156\t        self.adjusted_length = len(self.valid_indices)\n157\t        self.df_valid_indices.set_index(\"valid_indices\", inplace=True)\n158\t\n159\t        if max_number_of_samples is not None and max_number_of_samples < self.adjusted_length:\n160\t            self.valid_indices = self.valid_indices[:max_number_of_samples]\n161\t            self.df_valid_indices = self.df_valid_indices.iloc[:max_number_of_samples]\n162\t            self.adjusted_length = max_number_of_samples\n163\t\n164\t    def __len__(self):\n165\t        return self.adjusted_length\n166\t\n167\t    def _load_mask(self, path: str) -> np.ndarray:\n168\t        \"\"\"Load a SHARP bitmap FITS file as a binary (1, H, W) float32 mask.\"\"\"\n169\t        with fits.open(path) as hdul:\n170\t            data = np.asarray(hdul[0].data)\n171\t        mask = np.nan_to_num(data, nan=0.0)\n172\t        mask = (mask > 0).astype(np.float32)  # binarize defensively\n173\t        return mask[None, :, :]  # (1, H, W) -- channel-first, matches ts/forecast convention\n174\t\n175\t    def __getitem__(self, idx: int) -> dict:\n176\t        \"\"\"\n177\t        Args:\n178\t            idx: Dataset index.\n179\t\n180\t        Returns:\n181\t            Dictionary containing:\n182\t                forecast (np.float32): Binary flare-region mask, shape (1, H, W).\n183\t                ds_index (str): ISO-format timestamp from the flare index.\n184\t            When ``return_surya_stack=True``, also includes all keys from\n185\t            ``HelioNetCDFDataset.__getitem__`` (ts, time_delta_input, lead_time_delta, etc.).\n186\t        \"\"\"\n187\t        sample = super().__getitem__(idx=idx) if self.return_surya_stack else {}\n188\t        mask_path = self.df_valid_indices.iloc[idx][\"mask_path\"]\n189\t        sample[\"forecast\"] = self._load_mask(mask_path)\n190\t        sample[\"ds_index\"] = self.df_valid_indices[\"ds_index\"].iloc[idx].isoformat()\n191\t        return sample\n192\t",
            "status": "completed",
