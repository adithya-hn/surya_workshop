            "raw_output": "567:    def __getitem__(self, idx: int) -> dict:\n568-        \"\"\"\n569-        Load and return a single sample.\n570-\n571-        Args:\n572-            idx: Dataset index.\n573-\n574-        Returns:\n575-            Dictionary with keys:\n576-                ts (np.ndarray):               (C, T, H, W) \u2014 input frames\n577-                time_delta_input (np.ndarray): (T,) \u2014 input time offsets in hours (relative to \"now\")\n578-            When ``load_forecast_frames=True`` (default), also includes:\n579-                forecast (np.ndarray):         (C, L, H, W) \u2014 target frames\n580-                lead_time_delta (np.ndarray):  (L,) \u2014 lead times in hours (negative = future)\n581-            When ``use_latitude_in_learned_flow=True``, also includes:\n582-                input_latitudes (list[float])\n583-                forecast_latitude (list[float])  \u2014 only when ``load_forecast_frames=True``\n584-        \"\"\"\n585-        self._ensure_logger()\n586-        self.logger.info(f\"Retrieving index {idx}.\")\n587-        return self._get_index_data(idx)\n588-\n589-    # ------------------------------------------------------------------\n590-    # Internal data loading\n591-    # ------------------------------------------------------------------\n592-\n593-    def _load_and_stack_frames(self, timesteps) -> np.ndarray:\n594-        \"\"\"Load, normalize, and stack NetCDF frames into a (C, T, H, W) array.\n595-\n596-        Args:\n597-            timesteps: Sequence of timestamps; one NetCDF file is loaded per entry.\n598-\n599-        Returns:\n600-            NumPy array of shape (C, T, H, W).\n601-        \"\"\"\n602-        return np.stack(\n603-            [self.transform_data(self.load_nc_data(self.index.loc[ts, \"path\"], ts, self.channels))\n604-             for ts in timesteps],\n605-            axis=1,\n606-        )\n607-\n608-    def _get_index_data(self, idx: int) -> dict:\n609-        \"\"\"Build and return the sample dict for a single reference timestep.\n610-\n611-        Samples historical input frames randomly from ``time_delta_input_minutes``,\n612-        applies channel masking and optional vertical flip, then assembles the sample\n613-        dict described in ``__getitem__``.\n614-        \"\"\"\n615-        reference_timestep = self.valid_indices[idx]\n616-\n617-        # The last entry in time_delta_input_minutes is always the \"now\" frame (offset 0\n618-        # relative to the reference timestep). The remaining n-1 input frames are sampled\n619-        # randomly from the earlier offsets, giving the model varied historical context\n620-        # across training steps.\n621-        input_time_deltas = np.array(\n622-            sorted(random.sample(self.time_delta_input_minutes[:-1], self.n_input_timestamps - 1))\n623-            + [self.time_delta_input_minutes[-1]]\n624-        )\n625-        input_timesteps = reference_timestep + input_time_deltas\n626-        stacked_inputs = self._load_and_stack_frames(input_timesteps)\n627-\n628-        if self.num_mask_aia_channels > 0 or self.drop_hmi_probability:\n629-            stacked_inputs = self.masker(stacked_inputs)\n630-\n631-        # All time deltas are expressed relative to \"now\" (the last input frame), in hours.\n632-        now_delta = input_time_deltas[-1]\n633-        time_delta_input_float = (\n634-            (now_delta - input_time_deltas) / np.timedelta64(1, \"h\")\n635-        ).astype(np.float32)\n636-\n637-        sample = {\nShell cwd was reset to /home/jovyan/adi_wdir/surya_workshop/downstream_apps/sf_triggers",
