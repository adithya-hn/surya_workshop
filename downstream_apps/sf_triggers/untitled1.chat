            "raw_output": "19:class HelioSpectformer1D(nn.Module):\n20-    \"\"\"\n21-    Fine-tuning wrapper for 1D outputs (e.g. regression or classification).\n22-\n23-    Holds a frozen-or-trainable HelioSpectFormer backbone and adds a pooling\n24-    layer plus a linear head on top. Only the head-specific parameters are\n25-    defined here; all backbone parameters are forwarded to HelioSpectFormer.\n26-    \"\"\"\n27-\n28-    def __init__(\n29-        self,\n30-        # --- Backbone ---\n31-        img_size: int,\n32-        patch_size: int,\n33-        in_chans: int,\n34-        embed_dim: int,\n35-        time_embedding: dict,\n36-        depth: int,\n37-        n_spectral_blocks: int,\n38-        num_heads: int,\n39-        mlp_ratio: float,\n40-        drop_rate: float,\n41-        window_size: int,\n42-        dp_rank: int,\n43-        learned_flow: bool = False,\n44-        use_latitude_in_learned_flow: bool = False,\n45-        init_weights: bool = False,\n46-        checkpoint_layers: list[int] | None = None,\n47-        rpe: bool = False,\n48-        ensemble: int | None = None,\n49-        nglo: int = 0,\n50-        dtype: torch.dtype = torch.bfloat16,\n51-        # --- Fine-tuning head ---\n52-        dropout: float = 0.1,\n53-        num_outputs: int = 1,\n54-        num_penultimate_transformer_layers: int = 1,\n55-        num_penultimate_heads: int = 8,\n56-        pooling: str = \"class_token\",\n57-        penultimate_linear_layer: bool = True,\n58-    ):\n59-        super().__init__()\n60-\n61-        if pooling not in _VALID_POOLINGS:\n62-            raise ValueError(f\"pooling must be one of {_VALID_POOLINGS}, got {pooling!r}\")\n63-\n64-        self.backbone = HelioSpectFormer(\n65-            img_size=img_size,\n66-            patch_size=patch_size,\n67-            in_chans=in_chans,\n68-            embed_dim=embed_dim,\n69-            time_embedding=time_embedding,\n70-            depth=depth,\n71-            n_spectral_blocks=n_spectral_