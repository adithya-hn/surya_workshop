            "raw_output": "    1\t#!/usr/bin/env python3\n    2\t\"\"\"\n    3\tRunnable finetuning script derived from `2_finetune_template_1D.ipynb`.\n    4\t\n    5\tDesign goals\n    6\t- Config-driven: all hyperparameters live in config_script.yaml\n    7\t- Minimal CLI: --config plus a handful of per-run overrides\n    8\t- Multi-GPU capable (DDP) when run as a script\n    9\t\n   10\tAssumptions\n   11\t- Assets (`scalers.yaml` + model weights) are downloaded automatically on first run.\n   12\t- You run this script from the repo root and specify devices via CUDA_VISIBLE_DEVICES:\n   13\t    CUDA_VISIBLE_DEVICES=0,1 python -m downstream_apps.template.3_finetune_template_1D \\\n   14\t        --config downstream_apps/template/configs/config_script.yaml\n   15\t\n   16\tAll parameters live in the YAML. The CLI overrides only what genuinely varies between\n   17\truns of the same config: --max-epochs and --batch-size (sweeps), --s3-cache-dir\n   18\t(per-machine scratch) and --deterministic (reproducibility, off by default for speed).\n   19\tEverything else is a config edit.\n   20\t\n   21\tForking this script: build_datasets() and build_model() are the only two functions with\n   22\ttask-specific content. build_trainer() and main() should need no changes.\n   23\t\"\"\"\n   24\t\n   25\tfrom __future__ import annotations\n   26\t\n   27\timport argparse\n   28\timport os\n   29\t\n   30\t# Must be set BEFORE torch is imported: cuBLAS reads this once, when it initializes, so\n   31\t# setting it later has no effect. Deterministic cuBLAS on CUDA >= 10.2 requires it, and\n   32\t# without it every run under training.deterministic warns (or raises, when set to true).\n   33\t# setdefault so a deliberate \":16:8\" (smaller workspace, slightly slower) is respected.\n   34\tos.environ.setdefault(\"CUBLAS_WORKSPACE_CONFIG\", \":4096:8\")\n   35\t\n   36\tfrom pathlib import Path\n   37\tfrom typing import Tuple\n   38\t\n   39\timport torch\n   40\timport lightning as L\n   41\tfrom lightning.pytorch.callbacks import ModelCheckpoint\n   42\tfrom lightning.pytorch.loggers import CSVLogger, WandbLogger\n   43\tfrom torch.utils.data import DataLoader\n   44\t\n   45\tfrom downstream_apps.template.configs import TrainingConfig, load_flare_config\n   46\tfrom downstream_apps.template.datasets.template_dataset import FlareDSDataset\n   47\tfrom downstream_apps.template.lightning_modules.pl_simple_baseline import FlareLightningModule\n   48\tfrom downstream_apps.template.metrics.template_metrics import FlareMetrics\n   49\tfrom workshop_infrastructure.assets import ensure_assets\n   50\tfrom workshop_infrastructure.datasets.builders import build_helio_dataloaders\n   51\tfrom workshop_infrastructure.utils import (\n   52\t    apply_peft_lora,\n   53\t    build_scalers,\n   54\t    load_pretrained_weights,\n   55\t    UploadBestCheckpointToS3,\n   56\t)\n   57\t\n   58\tDEFAULT_CONFIG = Path(__file__).parent / \"configs\" / \"config_script.yaml\"\n   59\t\n   60\t# --deterministic accepts the same three tokens as the YAML key. argparse hands back a\n   61\t# string, so the two boolean ones are mapped to real bools -- TrainingConfig validates\n   62\t# against True/False/\"warn\", not against their spellings.\n   63\t_DETERMINISTIC_CLI = {\"false\": False, \"warn\": \"warn\", \"true\": True}\n   64\t\n   65\t\n   66\t# ---------------------------------------------------------------------------\n   67\t# Build functions\n   68\t# ---------------------------------------------------------------------------\n   69\t\n   70\tdef parse_args() -> argparse.Namespace:\n   71\t    parser = argparse.ArgumentParser()\n   72\t    parser.add_argument(\"--config\", type=str, default=str(DEFAULT_CONFIG),\n   73\t                        help=\"Path to the run config YAML (default: this app's config_script.yaml).\")\n   74\t    # Dev toggles: flip without editing the YAML\n   75\t    parser.add_argument(\"--no-wandb\", action=\"store_true\",\n   76\t                        help=\"Disable WandB logging (useful for local runs).\")\n   77\t    parser.add_argument(\"--train_baseline\", action=\"store_true\",\n   78\t                        help=\"Train the simple linear baseline instead of HelioSpectformer.\")\n   79\t    # Per-job / per-machine overrides: vary across runs without touching the YAML\n   80\t    parser.add_argument(\"--max-epochs\", type=int, default=None,\n   81\t                        help=\"Override training.max_epochs from the config YAML.\")\n   82\t    parser.add_argument(\"--batch-size\", type=int, default=None,\n   83\t                        help=\"Override training.batch_size from the config YAML.\")\n   84\t    parser.add_argument(\"--s3-cache-dir\", type=str, default=None,\n   85\t                        help=\"Override data.s3_cache_dir (the local cache for S3 reads). \"\n   86\t                             \"Handy when the same config runs on machines with different scratch.\")\n   87\t    parser.add_argument(\"--deterministic\", choices=tuple(_DETERMINISTIC_CLI), default=None,\n   88\t                        help=\"Override training.deterministic. The config default is 'false', \"\n   89\t                             \"which trades reproducibility for roughly 20%% throughput. Pass \"\n   90\t                             \"'warn' when you need to tell whether a change in your results came \"\n   91\t                             \"from your edit or from run-to-run drift.\")\n   92\t    return parser.parse_args()\n   93\t\n   94\t\n   95\tdef _flare_label_transform(intensity: \"pd.Series\") -> \"pd.Series\":\n   96\t    \"\"\"Normalize flare peak intensity for the template task.\n   97\t\n   98\t    Converts raw GOES intensity to a z-score-like label:\n   99\t      1. Take log10 (intensity values span many orders of magnitude).\n  100\t      2. Shift so the minimum is 0.\n  101\t      3. Scale by 2 * std so most values fall in [-1, 1].\n  102\t    \"\"\"\n  103\t    import numpy as np\n  104\t    log_intensity = np.log10(intensity)\n  105\t    shifted = log_intensity - log_intensity.min()\n  106\t    return shifted / (2 * shifted.std())\n  107\t\n  108\t\n  109\tdef build_datasets(cfg: TrainingConfig, scalers) -> Tuple[DataLoader, DataLoader]:\n  110\t    \"\"\"Create train and validation DataLoaders from config.\n  111\t\n  112\t    Everything generic (channels, temporal sampling, S3 access, worker settings) is\n  113\t    handled by build_helio_dataloaders(). Only the flare-specific arguments below are\n  114\t    this app's business \u2014 when you fork the template, this is the list you replace.\n  115\t\n  116\t    ``scalers`` is built once in main() and shared with build_model(), so the two paths\n  117\t    cannot end up with different normalization statistics.\n  118\t    \"\"\"\n  119\t    return build_helio_dataloaders(\n  120\t        cfg,\n  121\t        FlareDSDataset,\n  122\t        scalers=scalers,\n  123\t        seed=cfg.seed,\n  124\t        return_surya_stack=True,\n  125\t        max_number_of_samples=cfg.data.max_samples,\n  126\t        label_transform=_flare_label_transform,\n  127\t        ds_flare_index_path=cfg.data.flare_index_path,\n  128\t        ds_time_column=cfg.data.ds_time_column,\n  129\t        ds_time_tolerance=cfg.data.ds_time_tolerance,\n  130\t        ds_match_direction=cfg.data.ds_match_direction,\n  131\t        ds_val_fraction=cfg.data.ds_val_fraction,\n  132\t        ds_split_seed=cfg.data.ds_split_seed,\n  133\t        mask_dir=cfg.data.mask_dir,\n  134\t        mask_time_tolerance=cfg.data.mask_time_tolerance,\n  135\t    )\n  136\t\n  137\t\n  138\tdef build_model(cfg: TrainingConfig, scalers, train_baseline: bool = False) -> L.LightningModule:\n  139\t    \"\"\"Instantiate the model and wrap it in a LightningModule.\n  140\t\n  141\t    ``scalers`` is only needed by the linear baseline, which consumes its inputs in\n  142\t    signum-log space; the HelioSpectformer path works directly on normalized inputs.\n  143\t    \"\"\"\n  144\t    metrics = {\n  145\t        \"train_loss\": FlareMetrics(\"train_loss\"),\n  146\t        # val_loss is what ModelCheckpoint monitors; val_metrics are reported only.\n  147\t        \"val_loss\": FlareMetrics(\"val_loss\"),\n  148\t        \"train_metrics\": FlareMetrics(\"train_metrics\"),\n  149\t        \"val_metrics\": FlareMetrics(\"val_metrics\"),\n  150\t    }\n  151\t\n  152\t    if train_baseline:\n  153\t        from functools import partial\n  154\t        from downstream_apps.template.models.simple_baseline import (\n  155\t            RegressionFlareModel,\n  156\t            destandardize_channels,\n  157\t        )\n  158\t        n_input_timestamps = cfg.model.time_embedding.time_dim\n  159\t        n_channels = len(cfg.data.channels)\n  160\t        model = RegressionFlareModel(n_input_timestamps * n_channels)\n  161\t        preprocess_fn = partial(destandardize_channels, channel_order=cfg.data.channels, scalers=scalers)\n  162\t        return FlareLightningModule(model, metrics, lr=cfg.learning_rate, batch_size=cfg.batch_size, preprocess_fn=preprocess_fn)\n  163\t    else:\n  164\t        from workshop_infrastructure.models.finetune_models import HelioSpectformer2D\n  165\t        model = HelioSpectformer2D.from_config(\n  166\t            cfg.model,\n  167\t            ft_out_chans=1,\n  168\t            dtype=cfg.dtype,\n  169\t            use_latitude_in_learned_flow=cfg.use_latitude_in_learned_flow,\n  170\t        )\n  171\t        load_pretrained_weights(model, cfg.model.pretrained_path)\n  172\t\n  173\t        # Three fine-tuning regimes, selected from the model: section of the YAML:\n  174\t        #   use_lora: true                          -> LoRA adapters + the whole head\n  175\t        #   use_lora: false, freeze_backbone: true  -> linear probe (head only)\n  176\t        #   use_lora: false, freeze_backbone: false -> full fine-tuning\n  177\t        #\n  178\t        # freeze_backbone is ignored when use_lora is true: PEFT freezes every\n  179\t        # parameter, then apply_peft_lora() re-enables the adapters plus every\n  180\t        # parameter outside backbone.* (the fine-tuning head).\n  181\t        if cfg.model.freeze_backbone:\n  182\t            for name, param in model.named_parameters():\n  183\t                if name.startswith(\"backbone.\"):\n  184\t                    param.requires_grad = False\n  185\t        if cfg.model.use_lora:\n  186\t            model = apply_peft_lora(model, cfg.model.lora_config)\n  187\t\n  188\t        _log_trainable_parameters(model)\n  189\t\n  190\t    return FlareLightningModule(model, metrics, lr=cfg.learning_rate, batch_size=cfg.batch_size)\n  191\t\n  192\t\n  193\tdef _log_trainable_parameters(model) -> None:\n  194\t    \"\"\"Print the trainable/total parameter counts, so the chosen regime is visible in the log.\"\"\"\n  195\t    trainable = sum(p.numel() for p in model.parameters() if p.requires_grad)\n  196\t    total = sum(p.numel() for p in model.parameters())\n  197\t    pct = 100.0 * trainable / total if total else 0.0\n  198\t    print(f\"[MODEL] Trainable parameters: {trainable:,} / {total:,} ({pct:.2f}%)\")\n  199\t\n  200",
