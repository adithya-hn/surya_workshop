            "raw_output": "   25\tfrom lightning.pytorch.plugins.precision.precision import Precision\n   26\tfrom lightning.pytorch.utilities import GradClipAlgorithmType\n   27\tfrom lightning.pytorch.utilities.exceptions import MisconfigurationException\n   28\t\n   29\t\n   30\tclass MixedPrecision(Precision):\n   31\t    \"\"\"Plugin for Automatic Mixed Precision (AMP) training with ``torch.autocast``.\n   32\t\n   33\t    Args:\n   34\t        precision: Whether to use ``torch.float16`` (``'16-mixed'``) or ``torch.bfloat16`` (``'bf16-mixed'``).\n   35\t        device: The device for ``torch.autocast``.\n   36\t        scaler: An optional :class:`torch.cuda.amp.GradScaler` to use.\n   37\t\n   38\t    \"\"\"\n   39\t\n   40\t    def __init__(\n   41\t        self,\n   42\t        precision: Literal[\"16-mixed\", \"bf16-mixed\"],\n   43\t        device: str,\n   44\t        scaler: Optional[\"torch.amp.GradScaler\"] = None,\n   45\t    ) -> None:\n   46\t        if precision not in (\"16-mixed\", \"bf16-mixed\"):\n   47\t            raise ValueError(\n   48\t                f\"`Passed `{type(self).__name__}(precision={precision!r})`.\"\n   49\t                f\" Precision must be '16-mixed' or 'bf16-mixed'.\"\n   50\t            )\n   51\t\n   52\t        self.precision = precision\n   53\t        if scaler is None and self.precision == \"16-mixed\":\n   54\t            scaler = torch.amp.GradScaler(device=device) if _TORCH_GREATER_EQUAL_2_4 else torch.cuda.amp.GradScaler()\n   55\t        if scaler is not None and self.precision == \"bf16-mixed\":\n   56\t            raise MisconfigurationException(f\"`precision='bf16-mixed'` does not use a scaler, found {scaler}.\")\n   57\t        self.device = device\n   58\t        self.scaler = scaler\n   59\t\n   60\t    @override\n   61\t    def pre_backward(self, tensor: Tensor, module: \"pl.LightningModule\") -> Tensor:  # type: ignore[override]\n   62\t        if self.scaler is not None:\n   63\t            tensor = self.scaler.scale(tensor)\n   64\t        return super().pre_backward(tensor, module)\n   65\t\n   66\t    @override\n   67\t    def optimizer_step(  # type: ignore[override]\n   68\t        self,\n   69\t        optimizer: Optimizable,\n   70\t        model: \"pl.LightningModule\",\n   71\t        closure: Callable[[], Any],\n   72\t        **kwargs: Any,\n   73\t    ) -> Any:\n   74\t        if self.scaler is None:\n   75\t            # skip scaler logic, as bfloat16 does not require scaler\n   76\t            return super().optimizer_step(optimizer, model=model, closure=closure, **kwargs)\n   77\t        if isinstance(optimizer, LBFGS):\n   78\t            raise MisconfigurationException(\"AMP and the LBFGS optimizer are not compatible.\")\n   79\t        closure_result = closure()\n   80\t\n   81\t        # If backward was skipped in automatic optimization (return None), unscaling is not needed\n   82\t        skip_unscaling = closure_result is None and model.automatic_optimization\n   83\t\n   84\t        if not _optimizer_handles_unscaling(optimizer) and not skip_unscaling:\n   85\t            # Unscaling needs to be performed here in case we are going to apply gradient clipping.\n   86\t            # Optimizers that perform unscaling in their `.step()` method are not supported (e.g., fused Adam).\n   87\t            # Note: `unscale` happens after the closure is executed, but before the `on_before_optimizer_step` hook.\n   88\t            self.scaler.unscale_(optimizer)  # type: ignore[arg-type]\n   89\t\n   90\t        self._after_closure(model, optimizer)\n   91\t\n   92\t        # in manual optimization, the closure does not return a value\n   93\t        if not skip_unscaling:\n   94\t            # note: the scaler will skip the `optimizer.step` if nonfinite gradients are found\n   95\t            step_output = self.scaler.step(optimizer, **kwargs)  # type: ignore[arg-type]\n   96\t            self.scaler.update()\n   97\t            return step_output\n   98\t        return closure_result\n   99\t\n  100\t    @override\n=== strategy setup order ===\n121:    def setup_environment(self) -> None:\n131:    def setup_optimizers(self, trainer: \"pl.Trainer\") -> None:\n141:    def setup(self, trainer: \"pl.Trainer\") -> None:\n154:        self.model = self.precision_plugin.convert_module(self.model)\n159:            self.setup_optimizers(trainer)\n164:    def setup_precision_plugin(self) -> None:\n=== single_device ==="
