            "raw_output": "     1\timport functools\n     2\timport os\n     3\timport logging\n     4\timport sys\n     5\timport urllib.request\n     6\timport urllib.error\n     7\tfrom pathlib import Path\n     8\tfrom typing import Dict, Optional\n     9\t\n    10\timport torch\n    11\timport torch.distributed as dist\n    12\timport lightning as L\n    13\tfrom lightning.pytorch.callbacks import ModelCheckpoint\n    14\tfrom workshop_infrastructure.configs import LoraAdapterConfig\n    15\t\n    16\t# Optional: S3 helpers below degrade to a clear ImportError when boto3 is absent.\n    17\ttry:\n    18\t    import boto3\n    19\t    from botocore import UNSIGNED\n    20\t    from botocore.config import Config as BotoConfig\n    21\texcept Exception:  # pragma: no cover\n    22\t    boto3 = None\n    23\t    UNSIGNED = None\n    24\t    BotoConfig = None\n    25\t\n    26\t\n    27\t# ---------------------------------------------------------------------------\n    28\t# AWS / infrastructure utilities\n    29\t# ---------------------------------------------------------------------------\n    30\t\n    31\t@functools.lru_cache(maxsize=1)\n    32\tdef detect_ec2_region() -> str | None:\n    33\t    \"\"\"Return the AWS region of the current EC2 instance, or None if not on EC2.\n    34\t\n    35\t    Queries the IMDSv2 endpoint (169.254.169.254), which is only reachable from\n    36\t    within an EC2 instance.  The 1-second timeout makes this a no-op on any\n    37\t    other machine.  Results are cached so the network round-trip happens at most\n    38\t    once per process.\n    39\t    \"\"\"\n    40\t    try:\n    41\t        token_req = urllib.request.Request(\n    42\t            \"http://169.254.169.254/latest/api/token\",\n    43\t            method=\"PUT\",\n    44\t            headers={\"X-aws-ec2-metadata-token-ttl-seconds\": \"21600\"},\n    45\t        )\n    46\t        with urllib.request.urlopen(token_req, timeout=1) as resp:\n    47\t            token = resp.read().decode()\n    48\t        region_req = urllib.request.Request(\n    49\t            \"http://169.254.169.254/latest/meta-data/placement/region\",\n    50\t            headers={\"X-aws-ec2-metadata-token\": token},\n    51\t        )\n    52\t        with urllib.request.urlopen(region_req, timeout=1) as resp:\n    53\t            return resp.read().decode()\n    54\t    except Exception:\n    55\t        return None\n    56\t\n    57\t\n    58\tdef parse_s3_uri(uri: str) -> tuple[str, str]:\n    59\t    \"\"\"Split ``s3://bucket/key`` into ``(bucket, key)``.\n    60\t\n    61\t    Raises:\n    62\t        ValueError: If ``uri`` is not an S3 URI, or has no key component.\n    63\t    \"\"\"\n    64\t    if not isinstance(uri, str) or not uri.startswith(\"s3://\"):\n    65\t        raise ValueError(f\"Expected an s3:// URI, got: {uri!r}\")\n    66\t    remainder = uri[len(\"s3://\"):]\n    67\t    if \"/\" not in remainder:\n    68\t        raise ValueError(f\"S3 URI is missing a key: {uri!r} (expected s3://bucket/key)\")\n    69\t    bucket, key = remainder.split(\"/\", 1)\n    70\t    return bucket, key\n    71\t\n    72\t\n    73\tdef make_s3_client(\n    74\t    anon: bool = False,\n    75\t    region: str | None = None,\n    76\t    pool_size: int = 32,\n    77\t    max_attempts: int = 10,\n    78\t):\n    79\t    \"\"\"Return a configured boto3 S3 client.\n    80\t\n    81\t    Shared by the dataset loader and the S3 benchmark so both use identical connection\n    82\t    pooling and retry behaviour.\n    83\t\n    84\t    Args:\n    85\t        anon: If True, sign requests anonymously (public buckets).\n    86\t        region: AWS region. Pass ``None`` to let boto3 resolve it.\n    87\t        pool_size: Max connections in the client's connection pool. Should be at least\n    88\t            twice the download concurrency, or threads will contend for connections.\n    89\t        max_attempts: Retry attempts in adaptive mode. The dataset uses a high value\n    90\t            because a failed read kills a training run; the benchmark uses a low one so\n    91\t            throughput measurements are not skewed by retries.\n    92\t    \"\"\"\n    93\t    if boto3 is None:\n    94\t        raise ImportError(\"boto3 is required for S3 access. Install via: pip install boto3\")\n    95\t\n    96\t    retry_cfg = {\"max_attempts\": max_attempts, \"mode\": \"adaptive\"}\n    97\t    if anon:\n    98\t        config = BotoConfig(\n    99\t            signature_version=UNSIGNED,\n   100\t            max_pool_connections=pool_size,\n   101\t            retries=retry_cfg,\n   102\t        )\n   103\t    else:\n   104\t        config = BotoConfig(max_pool_connections=pool_size, retries=retry_cfg)\n   105\t    return boto3.client(\"s3\", region_name=region, config=config)\n   106\t\n   107\t\n   108\t# ---------------------------------------------------------------------------\n   109\t# Distributed utilities\n   110\t# ---------------------------------------------------------------------------\n   111\t\n   112\tdef is_dist_avail_and_initialized() -> bool:\n   113\t    return dist.is_available() and dist.is_initialized()\n   114\t\n   115\t\n   116\tdef get_rank() -> int:\n   117\t    if not is_dist_avail_and_initialized():\n   118\t        return 0\n   119\t    return dist.get_rank()\n   120\t\n   121\t\n   122\t# ---------------------------------------------------------------------------\n   123\t# Logging utilities\n   124\t# ---------------------------------------------------------------------------\n   125\t\n   126\tdef create_logger(output_dir: str, dist_rank: int, name: str) -> logging.Logger:\n   127\t    \"\"\"Create a file+console logger identified by name and rank.\"\"\"\n   128\t    logger = logging.getLogger(name)\n   129\t    logger.setLevel(logging.DEBUG)\n   130\t    logger.propagate = False\n   131\t\n   132\t    fmt = \"[%(asctime)s %(name)s]: %(levelname)s %(message)s\"\n   133\t\n   134\t    if name.endswith(\"main\"):\n   135\t        console_handler = logging.StreamHandler(sys.stdout)\n   136\t        console_handler.setLevel(logging.INFO)\n   137\t        console_handler.setFormatter(logging.Formatter(fmt=fmt, datefmt=\"%Y-%m-%d %H:%M:%S\"))\n   138\t        logger.addHandler(console_handler)\n   139\t\n   140\t    file_handler = logging.FileHandler(os.path.join(output_dir, f\"{name}.log\"), mode=\"a\")\n   141\t    file_handler.setLevel(logging.DEBUG)\n   142\t    file_handler.setFormatter(logging.Formatter(fmt=fmt, datefmt=\"%Y-%m-%d %H:%M:%S\"))\n   143\t    logger.addHandler(file_handler)\n   144\t\n   145\t    return logger\n   146\t\n   147\t\n   148\t# ---------------------------------------------------------------------------\n   149\t# Scaler utilities\n   150\t# ---------------------------------------------------------------------------\n   151\t\n   152\tdef class_from_name(module_name: str, class_name: str):\n   153\t    \"\"\"Import and return a class by its module and class name strings.\"\"\"\n   154\t    m = __import__(module_name, globals(), locals(), [class_name])\n   155\t    return getattr(m, class_name)\n   156\t\n   157\t\n   158\tdef build_scalers(info) -> Dict:\n   159\t    \"\"\"Reconstruct per-channel scaler objects from a scalers YAML file or dict.\n   160\t\n   161\t    Args:\n   162\t        info: Path to a scalers YAML file, or an already-loaded dict mapping\n   163\t            channel name -> scaler parameters.\n   164\t\n   165\t    Returns:\n   166\t        Dict mapping channel name -> scaler instance (e.g. ``StandardScaler``), each\n   167\t        exposing ``.mean``, ``.std``, ``.epsilon`` and ``.sl_scale_factor``.\n   168\t\n   169\t    On the ``base:`` field\n   170\t    ---------------------\n   171\t    Every entry records the module the scaler was originally fitted in \u2014 in the\n   172\t    shipped ``scalers.yaml`` that is ``surya.datasets.transformations``, which does not\n   173\t    exist in this repo (the Surya code is vendored under ``workshop_infrastructure/``).\n   174\t\n   175\t    That field is deliberately **ignored**. Classes are always resolved from\n   176\t    ``workshop_infrastructure.datasets.transformations``, never imported from the\n   177\t    recorded path, so normalization does not depend on what happens to be installed in\n   178\t    the environment: were a real ``surya`` package ever added, honoring ``base`` would\n   179\t    silently switch which ``StandardScaler`` implementation runs, and results could move\n   180\t    because of an unrelated install. Determinism matters more here than deference to a\n   181\t    stale field. This is not warned about at runtime \u2014 the field is stale in every entry\n   182\t    of a file fetched from HuggingFace that nobody can edit, so a warning would fire\n   183\t    always and invite no action.\n   184\t    \"\"\"\n   185\t    import yaml\n   186\t    import workshop_infrastructure.datasets.transformations as _transformations\n   187\t\n   188\t    source = \"<dict>\"\n   189\t    if not isinstance(info, dict):\n   190\t        source = str(info)\n   191\t        if not os.path.isfile(source):\n   192\t            raise FileNotFoundError(\n   193\t                f\"Scalers file not found: {source}\\n\"\n   194\t                \"This is the data.scalers_path entry in your config. It is downloaded \"\n   195\t                \"automatically on the first run; to fetch it explicitly:\\n\"\n   196\t                \"    python -m workshop_infrastructure.assets --scalers --dest <assets dir>\"\n   197\t            )\n   198\t        with open(source, \"r\", encoding=\"utf-8\") as f:\n   199\t            info = yaml.safe_load(f)\n   200\t\n   201\t    if not isinstance(info, dict):\n   202\t        raise ValueError(f\"Scalers source {source} must contain a mapping of channel name -> parameters.\")\n   203\t\n   204\t    available = sorted(\n   205\t        name for name in dir(_transformations)\n   206\t        if isinstance(getattr(_transformations, name), type)\n   207\t    )\n   208\t\n   209\t    ret_dict = {}\n   210\t    for p_key, p_val in info.items():\n   211\t        if not isinstance(p_val, dict) or \"class\" not in p_val:\n   212\t            raise ValueError(\n   213\t                f\"Scalers entry {p_key!r} in {source} is malformed: expected a mapping \"\n   214\t                f\"with a 'class' key, got {type(p_val).__name__}.\"\n   215\t            )\n   216\t        class_name = p_val[\"class\"]\n   217\t        # Note: p_val[\"base\"] is intentionally not consulted \u2014 see the docstring.\n   218\t        if not hasattr(_transformations, class_name):\n   219\t            raise ValueError(\n   220\t                f\"Scalers entry {p_key!r} in {source} names class {class_name!r}, which does \"\n   221\t                \"not exist in workshop_infrastructure.datasets.transformations.\\n\"\n   222\t                f\"Available classes: {', '.join(available)}.\"\n   223\t            )\n   224\t        ret_dict[p_key] = getattr(_transformations, class_name).from_dict(p_val)\n   225\t    return ret_dict\n   226\t\n   227\t\n   228\tHEAD_PREFIX = \"head_\"\n   229\t\n   230\t\n   231\tdef discover_head_modules(model: torch.nn.Module) -> list[str]:\n   232\t    \"\"\"Find the fine-tuning head modules to keep trainable under LoRA.\n   233\t\n   234\t    Convention: every trainable component of a fine-tuning head is a **direct\n   235\t    child** of the top-level model whose attribute name starts with ``head_``\n   236\t    (e.g. ``head_linear``, ``head_unembed``, ``head_cls_token``).  The backbone\n   237\t    stays at ``backbone``.  Learners therefore never hand-maintain a list of\n   238\t    head layers -- adding ``self.head_foo = nn.Linear(...)`` is enough.\n   239\t\n   240\t    Only modules that own parameters are returned, so parameter-free layers\n   241\t    such as ``head_dropout`` are not needlessly duplicated by PEFT.\n   242\t\n   243\t    Raises:\n   244\t        ValueError: if the model violates the convention, with a message\n   245\t            naming the exact attribute to rename.\n   246\t    \"\"\"\n   247\t    head_names = []\n   248\t    missing_prefix = []\n   249\t    for name, module in model.named_children():\n   250\t        has_params = any(True for _ in module.parameters())\n   251\t        if name.startswith(HEAD_PREFIX):\n   252\t            if has_params:\n   253\t                head_names.append(name)\n   254\t        elif name != \"backbone\" and has_params:\n   255\t            missing_prefix.append(name)\n   256\t\n   257\t    if missing_prefix:\n   258\t        raise ValueError(\n   259\t            \"Fine-tuning head modules must be named with the \"\n   260\t            f\"{HEAD_PREFIX!r} prefix so LoRA can keep them trainable.\\n\"\n   261\t            f\"Rename these top-level attributes: \"\n   262\t            + \", \".join(f\"self.{n} -> self.{HEAD_PREFIX}{n}\" for n in missing_prefix)\n   263\t            + \"\\nWithout the prefix they are frozen during LoRA fine-tuning and \"\n   264\t            \"the model trains against a random readout.\"\n   265\t        )\n   266\t\n   267\t    # PEFT's modules_to_save cannot cover a bare nn.Parameter on the top-level\n   268\t    # model -- it would stay frozen.  Wrap it in a tiny module instead.\n   269\t    bare = [n for n, _ in model.named_parameters(recurse=False)]\n   270\t    if bare:\n   271\t        raise ValueError(\n   272\t            \"Top-level bare parameters cannot be kept trainable by PEFT, which \"\n   273\t            \"matches module names only, so these would be silently frozen: \"\n   274\t            + \", \".join(bare)\n   275\t            + \"\\nWrap each one in a small nn.Module (see ClassToken in \"\n   276\t            \"workshop_infrastructure/models/finetune_models.py) and name the \"\n   277\t            f\"attribute with the {HEAD_PREFIX!r} prefix.\"\n   278\t        )\n   279\t\n   280\t    # PEFT matches modules_to_save entries with a bare ``key.endswith(name)``\n   281\t    # -- no dot boundary -- so a head name that happens to be a suffix of any\n   282\t    # backbone module name would wrap that backbone module too.\n   283\t    backbone = getattr(model, \"backbone\", None)\n   284\t    if backbone is not None:\n   285\t        collisions = [\n   286\t            (head, f\"backbone.{qualified}\")\n   287\t            for head in head_names\n   288\t            for qualified, _ in backbone.named_modules()\n   289\t            if qualified and f\"backbone.{qualified}\".endswith(head)\n   290\t        ]\n   291\t        if collisions:\n   292\t            raise ValueError(\n   293\t                \"Head module names must not be a suffix of any backbone module \"\n   294\t                \"name, because PEFT would make the backbone module trainable \"\n   295\t                \"too:\\n\"\n   296\t                + \"\\n\".join(f\"  {h} collides with {q}\" for h, q in collisions)\n   297\t                + \"\\nRename the head attribute to something more specific.\"\n   298\t            )\n   299\t\n   300\t    return head_names\n   301\t\n   302\t\n   303\tdef apply_peft_lora(\n   304\t    model: torch.nn.Module,\n   305\t    lora_config: LoraAdapterConfig,\n   306\t) -> torch.nn.Module:\n   307\t    \"\"\"\n   308\t    Applies PEFT LoRA adapters to a model.\n   309\t\n   310\t    Adapters go on the modules named by ``lora_config.target_modules``.  Every\n   311\t    fine-tuning head module (see :func:`discover_head_modules`) is passed to\n   312\t    PEFT as ``modules_to_save``, so it stays **trainable** -- without this the\n   313\t    head is frozen at its random initialisation and LoRA fits adapters to a\n   314\t    random readout.\n   315\t\n   316\t    Args:\n   317\t        model: The model to apply LoRA to.\n   318\t        lora_config: A LoraAdapterConfig instance (from workshop_infrastructure.configs).\n   319\t\n   320\t    Returns:\n   321\t        Model with PEFT LoRA adapters applied.\n   322\t    \"\"\"\n   323\t    modules_to_save = discover_head_modules(model)\n   324\t\n   325\t    print(\n   326\t        f\"Applying PEFT LoRA: r={lora_config.r}, alpha={lora_config.lora_alpha}, \"\n   327\t        f\"dropout={lora_config.lora_dropout}, modules={lora_config.target_modules}\"\n   328\t    )\n   329\t\n   330\t    from peft import LoraConfig, get_peft_model\n   331\t    peft_config = LoraConfig(\n   332\t        r=lora_config.r,\n   333\t        lora_alpha=lora_config.lora_alpha,\n   334\t        target_modules=lora_config.target_modules,\n   335\t        lora_dropout=lora_config.lora_dropout,\n   336\t        bias=lora_config.bias,\n   337\t        modules_to_save=modules_to_save,\n   338\t    )\n   339\t\n   340\t    model = get_peft_model(model, peft_config)\n   341\t\n   342\t    # Show exactly what is being trained, so a misconfigured run is visible\n   343\t    # in the log instead of only in the loss curve.\n   344\t    adapted = sorted(\n   345\t        {\n   346\t            name.split(\".lora_A\")[0].replace(\"base_model.model.\", \"\")\n   347\t            for name, _ in model.named_parameters()\n   348\t            if \".lora_A\" in name\n   349\t        }\n   350\t    )\n   351\t    print(f\"[LoRA] Adapted modules ({len(adapted)}):\")\n   352\t    for name in adapted:\n   353\t        print(f\"[LoRA]   {name}\")\n   354\t    print(f\"[LoRA] Trainable head modules (modules_to_save): {modules_to_save}\")\n   355\t\n   356\t    # Defensive: current PEFT excludes modules_to_save from adapter injection.\n   357\t    # If that ever changes, a head module would get both, so fail loudly.\n   358\t    head_adapted = [n for n in adapted if n.split(\".\")[0].startswith(HEAD_PREFIX)]\n   359\t    if head_adapted:\n   360\t        raise RuntimeError(\n   361\t            \"PEFT applied LoRA adapters to fine-tuning head modules, which \"\n   362\t            f\"should be fully trainable instead: {head_adapted}. \"\n   363\t            \"Narrow lora_config.target_modules so it cannot match head layers.\"\n   364\t        )\n   365\t\n   366\t    # Log the number of trainable parameters\n   367\t    trainable_params = 0\n   368\t    all_param = 0\n   369\t    for _, param in model.named_parameters():\n   370\t        all_param += param.numel()\n   371\t        if param.requires_grad:\n   372\t            trainable_params += param.numel()\n   373\t\n   374\t    print(\n   375\t        f\"trainable params: {trainable_params:,} || \"\n   376\t        f\"all params: {all_param:,} || \"\n   377\t        f\"trainable%: {100 * trainable_params / all_param:.2f}%\"\n   378\t    )\n   379\t\n   380\t    return model\n   381\t\n   382\t\n   383\tdef load_pretrained_weights(model: torch.nn.Module, pretrained_path: Optional[str]) -> None:\n   384\t    \"\"\"Load pretrained weights into a fine-tuning model, skipping shape-mismatched keys.\n   385\t\n   386\t    The pretrained checkpoint was saved from HelioSpectFormer directly, so its keys\n   387\t    are flat (e.g. ``embedding.proj.weight``).  The composed fine-tuning models\n   388\t    (HelioSpectformer1D, HelioSpectformer2D) nest the backbone under ``backbone.*``,\n   389\t    so we try both the original key and the ``backbone.``-prefixed key when matching\n   390\t    against the current model's state dict.\n   391\t\n   392\t    Args:\n   393\t        model: The fine-tuning model to load weights into.\n   394\t        pretrained_path: Path to the pretrained checkpoint (.pt file). No-op if None.\n   395\t    \"\"\"\n   396\t    if not pretrained_path:\n   397\t        return\n   398\t    print(f\"Loading pretrained weights from {pretrained_path}.\")\n   399\t    model_state = model.state_dict()\n   400\t    checkpoint_state = torch.load(pretrained_path, weights_only=True, map_location=\"cpu\")\n   401\t\n   402\t    remapped = {}\n   403\t    for k, v in checkpoint_state.items():\n   404\t        for candidate in (k, f\"backbone.{k}\"):\n   405\t            if candidate in model_state and hasattr(v, \"shape\") and v.shape == model_state[candidate].shape:\n   406\t                remapped[candidate] = v\n   407\t                break\n   408\t\n   409\t    model_state.update(remapped)\n   410\t    model.load_state_dict(model_state, strict=True)\n   411\t    print(f\"Loaded {len(remapped)} / {len(checkpoint_state)} pretrained weights.\")\n   412\t\n   413\t\n   414\tclass UploadBestCheckpointToS3(L.Callback):\n   415\t    \"\"\"Lightning callback that uploads the best checkpoint to S3 after each validation epoch.\n   416\t\n   417\t    - No-op unless ``bucket`` is set (mirrors the ``output.s3_bucket: null`` YAML default).\n   418\t    - Only runs from global rank 0 under DDP to avoid duplicate uploads.\n   419\t    - Uses a stable S3 key (``fixed_key_name``) so the latest best is always at a\n   420\t      predictable location regardless of epoch number.\n   421\t\n   422\t    Args:\n   423\t        checkpoint_cb: The ModelCheckpoint callback whose ``best_model_path`` to watch.\n   424\t        bucket: S3 bucket name. Pass ``None`` to disable uploads entirely.\n   425\t        prefix: Key prefix (folder) within the bucket, e.g. ``\"flare/exp_001\"``.\n   426\t        fixed_key_name: Object name within the prefix. Defaults to ``\"best.ckpt\"``.\n   427\t    \"\"\"\n   428\t\n   429\t    def __init__(\n   430\t        self,\n   431\t        checkpoint_cb: ModelCheckpoint,\n   432\t        bucket: Optional[str],\n   433\t        prefix: str = \"\",\n   434\t        fixed_key_name: Optional[str] = \"best.ckpt\",\n   435\t    ):\n   436\t        super().__init__()\n   437\t        self.checkpoint_cb = checkpoint_cb\n   438\t        self.bucket = bucket\n   439\t        self.prefix = prefix.strip(\"/\")\n   440\t        self.fixed_key_name = fixed_key_name\n   441\t        self.last_uploaded_best = None\n   442\t        self._s3 = None\n   443\t\n   444\t    def _upload_if_new_best(self, trainer) -> None:\n   445\t        if not self.bucket:\n   446\t            return\n   447\t        if hasattr(trainer, \"is_global_zero\") and not trainer.is_global_zero:\n   448\t            return\n   449\t\n   450\t        best_path = getattr(self.checkpoint_cb, \"best_model_path\", None)\n   451\t        if not best_path or best_path == self.last_uploaded_best:\n   452\t            return\n   453\t\n   454\t        ckpt_path = Path(best_path)\n   455\t        if not ckpt_path.exists():\n   456\t            return\n   457\t\n   458\t        if self._s3 is None:\n   459\t            try:\n   460\t                import boto3\n   461\t            except ImportError as e:\n   462\t                raise RuntimeError(\n   463\t                    \"boto3 is required for S3 uploads. Install with: pip install boto3\"\n   464\t                ) from e\n   465\t            self._s3 = boto3.client(\"s3\")\n   466\t\n   467\t        object_name = self.fixed_key_name or ckpt_path.name\n   468\t        s3_key = f\"{self.prefix}/{object_name}\" if self.prefix else object_name\n   469\t\n   470\t        print(f\"[S3] Uploading {ckpt_path} -> s3://{self.bucket}/{s3_key}\")\n   471\t        self._s3.upload_file(str(ckpt_path), self.bucket, s3_key)\n   472\t        print(\"[S3] Upload complete.\")\n   473\t        self.last_uploaded_best = str(ckpt_path)\n   474\t\n   475\t    def on_validation_end(self, trainer, pl_module) -> None:\n   476\t        self._upload_if_new_best(trainer)\n   477\t\n   478\t    def on_fit_end(self, trainer, pl_module) -> None:\n   479\t        # Final check in case the last best update happens near fit end.\n   480\t        self._upload_if_new_best(trainer)",
            "title": "cd surya_workshop && cat -n workshop_infrastructure/utils.py",
            "kind": "execute"
          },
          {
            "title": "cd surya_workshop && cat -n workshop_infrastructure/configs.py | sed -n '200,560p'",
            "tool_call_id": "toolu_bdrk_01Sd4QUeMTVAwCn5K7F1n1D7",
            "raw_output": "   200\t    sdo_data_root_path: Optional[str] = None\n   201\t\n   202\t    # --- S3 (used only when the index contains s3:// paths) ---\n   203\t    s3_anon: bool = False\n   204\t    # One of VALID_S3_MODES (above). \"download\" is recommended for NetCDF/HDF5.\n   205\t    s3_mode: str = \"download\"\n   206\t    # Required unless s3_mode is \"stream\". Budget ~1 GB per unique timestep.\n   207\t    # Left unset here, load_config() falls back to $SURYA_WS_CACHE_DIR.\n   208\t    s3_cache_dir: Optional[str] = None\n   209\t    s3_boto3_max_concurrency: int = 4   # parallel threads per multipart download\n   210\t    s3_boto3_part_size_mb: int = 64     # part size in MB for multipart downloads\n   211\t\n   212\t    # --- Development ---\n   213\t    max_samples: Optional[int] = None\n   214\t\n   215\t    def __post_init__(self) -> None:\n   216\t        if self.s3_mode not in VALID_S3_MODES:\n   217\t            raise ValueError(\n   218\t                f\"Unknown data.s3_mode {self.s3_mode!r}. \"\n   219\t                f\"Valid modes are: {', '.join(VALID_S3_MODES)}.\"\n   220\t            )\n   221\t\n   222\t\n   223\t@dataclass\n   224\tclass OutputConfig:\n   225\t    \"\"\"Paths and S3 settings for checkpoints and artifacts.\"\"\"\n   226\t    ckpt_dir: str = \"checkpoints\"\n   227\t    # S3 upload of best checkpoint (all three used together; leave s3_bucket null to disable)\n   228\t    s3_bucket: Optional[str] = None\n   229\t    s3_prefix: str = \"\"\n   230\t    s3_best_key: str = \"best.ckpt\"\n   231\t\n   232\t\n   233\t@dataclass\n   234\tclass TrainingConfig:\n   235\t    \"\"\"Top-level configuration for a fine-tuning run.\"\"\"\n   236\t    job_id: str\n   237\t    data: DataConfig\n   238\t    model: ModelConfig\n   239\t    output: OutputConfig = field(default_factory=OutputConfig)\n   240\t    learning_rate: float = 1e-4\n   241\t    max_epochs: int = 20\n   242\t    batch_size: int = 2\n   243\t    num_workers: int = 8\n   244\t    # Seeds every RNG (Python, NumPy, torch, and each DataLoader worker) and the shuffle\n   245\t    # order. This applies regardless of `deterministic`: even with determinism off, the\n   246\t    # data order is pinned, so changing the seed is how you get a genuinely different run.\n   247\t    seed: int = 42\n   248\t    # One of VALID_DETERMINISTIC (above). Defaults to False for speed; set \"warn\" when\n   249\t    # you need reproducible results.\n   250\t    deterministic: Union[bool, str] = False\n   251\t    rollout_steps: int = 0\n   252\t    drop_hmi_probability: float = 0.0\n   253\t    use_latitude_in_learned_flow: bool = False\n   254\t    dtype: str = \"float32\"\n   255\t    wandb_project: str = \"surya_downstream\"\n   256\t    wandb_entity: Optional[str] = None\n   257\t\n   258\t    def __post_init__(self) -> None:\n   259\t        # Normalize the string form so YAML \"Warn\"/\"WARN\" behave like \"warn\"; bools pass\n   260\t        # through untouched (YAML true/false already parse as Python bools).\n   261\t        if isinstance(self.deterministic, str):\n   262\t            self.deterministic = self.deterministic.lower()\n   263\t        if self.deterministic not in VALID_DETERMINISTIC:\n   264\t            raise ValueError(\n   265\t                f\"Unknown training.deterministic {self.deterministic!r}. \"\n   266\t                \"Valid values are: true, false, \\\"warn\\\".\"\n   267\t            )\n   268\t        # A quoted seed in YAML (\"42\") would otherwise reach torch.manual_seed as a str\n   269\t        # and fail deep in the training loop. bool is excluded because it subclasses int.\n   270\t        if isinstance(self.seed, bool) or not isinstance(self.seed, int):\n   271\t            raise ValueError(\n   272\t                f\"training.seed must be an integer, got {self.seed!r} \"\n   273\t                f\"({type(self.seed).__name__}). Write it unquoted in the YAML, e.g. seed: 42.\"\n   274\t            )\n   275\t        if self.deterministic is True and self.model.learned_flow:\n   276\t            raise ValueError(\n   277\t                \"training.deterministic: true is incompatible with model.learned_flow: true \"\n   278\t                \"(F.grid_sample has no deterministic CUDA backward). Use \"\n   279\t                'training.deterministic: \"warn\" instead, or set model.learned_flow: false.'\n   280\t            )\n   281\t        time_dim = self.model.time_embedding.time_dim\n   282\t        n_available = len(self.data.time_delta_input_minutes)\n   283\t        if time_dim > n_available:\n   284\t            raise ValueError(\n   285\t                f\"model.time_embedding.time_dim ({time_dim}) must be <= \"\n   286\t                f\"len(data.time_delta_input_minutes) ({n_available}): the dataset samples \"\n   287\t                \"time_dim frames from that list and cannot sample more than it contains.\"\n   288\t            )\n   289\t\n   290\t\n   291\t# ---------------------------------------------------------------------------\n   292\t# YAML parsing\n   293\t# ---------------------------------------------------------------------------\n   294\t\n   295\tdef _from_dict(cls, d: dict, section: str):\n   296\t    \"\"\"Construct a dataclass from a dict, rejecting unrecognized keys.\n   297\t\n   298\t    Unknown keys are an error, not a silent no-op. A dropped key looks exactly like a\n   299\t    working one: adding ``s3_mode: stream`` to the YAML without a matching dataclass\n   300\t    field would otherwise change nothing and report nothing. Failing here names the\n   301\t    typo and lists what was expected.\n   302\t    \"\"\"\n   303\t    if not isinstance(d, dict):\n   304\t        raise ValueError(f\"Config section '{section}:' must be a mapping, got {type(d).__name__}.\")\n   305\t\n   306\t    known = {f.name for f in dc_fields(cls)}\n   307\t    unknown = sorted(set(d) - known)\n   308\t    if unknown:\n   309\t        raise ValueError(\n   310\t            f\"Unrecognized key(s) in '{section}:' section of the config: \"\n   311\t            f\"{', '.join(unknown)}.\\n\"\n   312\t            f\"Valid keys for {cls.__name__} are: {', '.join(sorted(known))}.\\n\"\n   313\t            \"If this is a new task-specific setting, add it to your DataConfig subclass \"\n   314\t            \"(see downstream_apps/template/configs.py).\"\n   315\t        )\n   316\t\n   317\t    missing = [\n   318\t        f.name for f in dc_fields(cls)\n   319\t        if f.name not in d\n   320\t        and f.default is MISSING\n   321\t        and f.default_factory is MISSING  # type: ignore[misc]\n   322\t    ]\n   323\t    if missing:\n   324\t        raise ValueError(\n   325\t            f\"Missing required key(s) in '{section}:' section of the config: \"\n   326\t            f\"{', '.join(missing)}.\"\n   327\t        )\n   328\t\n   329\t    return cls(**d)\n   330\t\n   331\t\n   332\tdef _resolve_path(value, config_dir: Path) -> str:\n   333\t    \"\"\"Expand ``~``/``$VARS`` and anchor a relative path to the config file's directory.\"\"\"\n   334\t    expanded = os.path.expandvars(os.path.expanduser(str(value)))\n   335\t    if not os.path.isabs(expanded):\n   336\t        expanded = str((config_dir / expanded).resolve())\n   337\t    return expanded\n   338\t\n   339\t\n   340\tdef _resolve_paths(data_cfg, config_dir: Path) -> None:\n   341\t    \"\"\"Expand ``~``/env vars and resolve relative path fields against the config's directory.\"\"\"\n   342\t    for name in getattr(type(data_cfg), \"PATH_FIELDS\", DataConfig.PATH_FIELDS):\n   343\t        value = getattr(data_cfg, name, None)\n   344\t        if value:\n   345\t            setattr(data_cfg, name, _resolve_path(value, config_dir))\n   346\t\n   347\t    # s3_cache_dir is a scratch location, not a repo path. Precedence is\n   348\t    # CLI flag > config value > $SURYA_WS_CACHE_DIR; expand ~ and $VARS, but never anchor\n   349\t    # it to the config directory (that would put ~1 GB files inside the repo).\n   350\t    cache_dir = getattr(data_cfg, \"s3_cache_dir\", None) or os.environ.get(S3_CACHE_DIR_ENV_VAR)\n   351\t    if cache_dir:\n   352\t        data_cfg.s3_cache_dir = os.path.expandvars(os.path.expanduser(str(cache_dir)))\n   353\t\n   354\t\n   355\tdef load_config(\n   356\t    path: Union[str, Path],\n   357\t    data_cls: type = DataConfig,\n   358\t) -> TrainingConfig:\n   359\t    \"\"\"Parse a run config YAML into a typed ``TrainingConfig``.\n   360\t\n   361\t    The YAML has five top-level sections (data, model, training, output, logging) plus\n   362\t    ``job_id``. Each is parsed into its dataclass; unknown keys raise rather than being\n   363\t    silently dropped.\n   364\t\n   365\t    Args:\n   366\t        path: Path to the config YAML.\n   367\t        data_cls: The ``DataConfig`` subclass to parse the ``data:`` section into. Pass\n   368\t            your app's subclass to accept task-specific keys.\n   369\t\n   370\t    Returns:\n   371\t        A fully typed ``TrainingConfig``. Relative paths in the ``data:`` section are\n   372\t        resolved against the config file's own directory.\n   373\t    \"\"\"\n   374\t    config_path = Path(path).expanduser().resolve()\n   375\t    if not config_path.is_file():\n   376\t        raise FileNotFoundError(f\"Config file not found: {config_path}\")\n   377\t\n   378\t    with open(config_path, \"r\", encoding=\"utf-8\") as f:\n   379\t        raw = yaml.safe_load(f)\n   380\t\n   381\t    if not isinstance(raw, dict):\n   382\t        raise ValueError(f\"Config {config_path} must contain a top-level mapping.\")\n   383\t\n   384\t    missing_sections = [k for k in (\"job_id\", \"data\", \"model\") if k not in raw]\n   385\t    if missing_sections:\n   386\t        raise ValueError(\n   387\t            f\"Config {config_path} is missing required top-level key(s): \"\n   388\t            f\"{', '.join(missing_sections)}. Expected: job_id, data, model \"\n   389\t            \"(training, output and logging are optional).\"\n   390\t        )\n   391\t\n   392\t    # model: build the nested configs first, then the ModelConfig around them.\n   393\t    model_raw = dict(raw[\"model\"])\n   394\t    model_raw[\"time_embedding\"] = _from_dict(\n   395\t        TimeEmbeddingConfig, model_raw.get(\"time_embedding\", {}), \"model.time_embedding\"\n   396\t    )\n   397\t    model_raw[\"lora_config\"] = _from_dict(\n   398\t        LoraAdapterConfig, model_raw.get(\"lora_config\", {}), \"model.lora_config\"\n   399\t    )\n   400\t    model_cfg = _from_dict(ModelConfig, model_raw, \"model\")\n   401\t\n   402\t    # pretrained_path is a path like the data: ones, and gets the same treatment.\n   403\t    if model_cfg.pretrained_path:\n   404\t        model_cfg.pretrained_path = _resolve_path(model_cfg.pretrained_path, config_path.parent)\n   405\t\n   406\t    data_cfg = _from_dict(data_cls, raw[\"data\"], \"data\")\n   407\t    _resolve_paths(data_cfg, config_path.parent)\n   408\t\n   409\t    training = raw.get(\"training\", {}) or {}\n   410\t    logging_cfg = raw.get(\"logging\", {}) or {}\n   411\t    _check_section_keys(training, _TRAINING_KEYS, \"training\")\n   412\t    _check_section_keys(logging_cfg, _LOGGING_KEYS, \"logging\")\n   413\t\n   414\t    return TrainingConfig(\n   415\t        job_id=raw[\"job_id\"],\n   416\t        data=data_cfg,\n   417\t        model=model_cfg,\n   418\t        output=_from_dict(OutputConfig, raw.get(\"output\", {}) or {}, \"output\"),\n   419\t        learning_rate=training.get(\"learning_rate\", 1e-4),\n   420\t        max_epochs=training.get(\"max_epochs\", 20),\n   421\t        batch_size=training.get(\"batch_size\", 2),\n   422\t        num_workers=training.get(\"num_workers\", 8),\n   423\t        seed=training.get(\"seed\", 42),\n   424\t        deterministic=training.get(\"deterministic\", False),\n   425\t        rollout_steps=training.get(\"rollout_steps\", 0),\n   426\t        drop_hmi_probability=training.get(\"drop_hmi_probability\", 0.0),\n   427\t        use_latitude_in_learned_flow=training.get(\"use_latitude_in_learned_flow\", False),\n   428\t        dtype=training.get(\"dtype\", \"float32\"),\n   429\t        wandb_project=logging_cfg.get(\"wandb_project\", \"surya_downstream\"),\n   430\t        wandb_entity=logging_cfg.get(\"wandb_entity\"),\n   431\t    )\n   432\t\n   433\t\n   434\t# The training: and logging: sections map onto flat TrainingConfig fields rather than\n   435\t# onto a dataclass of their own, so their keys are checked explicitly.\n   436\t_TRAINING_KEYS = frozenset({\n   437\t    \"learning_rate\", \"max_epochs\", \"batch_size\", \"num_workers\", \"seed\", \"deterministic\",\n   438\t    \"rollout_steps\", \"drop_hmi_probability\", \"use_latitude_in_learned_flow\", \"dtype\",\n   439\t})\n   440\t_LOGGING_KEYS = frozenset({\"wandb_project\", \"wandb_entity\"})\n   441\t\n   442\t\n   443\tdef _check_section_keys(section: dict, valid: frozenset, name: str) -> None:\n   444\t    \"\"\"Raise on unrecognized keys in a section that has no dataclass of its own.\"\"\"\n   445\t    unknown = sorted(set(section) - valid)\n   446\t    if unknown:\n   447\t        raise ValueError(\n   448\t            f\"Unrecognized key(s) in '{name}:' section of the config: {', '.join(unknown)}.\\n\"\n   449\t            f\"Valid keys are: {', '.join(sorted(valid))}.\"\n   450\t        )",
