          {
            "kind": "execute",
            "raw_output": "  # -- Fine-tuning head --\n  pooling: class_token  # Options: class_token | global_average | global_max | attention | transformer\n  penultimate_linear_layer: true\n  dropout: 0.2\n  freeze_backbone: false\n\n  # -- LoRA adapters --\n  use_lora: true\n  lora_config:\n    r: 2\n    lora_alpha: 8\n    lora_dropout: 0.1\n    bias: none\n    target_modules: [fc1, fc2, attn.qkv, attn.proj]\n    \n\n===200-210===\n  # just the *same* noise every time, so a change in it can be attributed to your edit.\n\n  # Task-specific\n  rollout_steps: 0\n  drop_hmi_probability: 0.0\n  use_latitude_in_learned_flow: false\n  dtype: float32        # Options: float32 | bfloat16\n\n\n# -----------------------------------------------------------------------------\n# Output\n# -----------------------------------------------------------------------------\noutput:\nShell cwd was reset to /home/jovyan/adi_wdir/surya_workshop/workshop_infrastructure/models",
            "raw_input": {
              "command": "cd /home/jovyan/adi_wdir/surya_workshop && sed -n '145,160p' downstream_apps/sf_triggers/configs/config_script.yaml && echo \"===200-210===\" && sed -n '198,210p' downstream_apps/sf_triggers/configs/config_script.yaml",
