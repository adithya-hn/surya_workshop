              "command": "cd /home/jovyan/adi_wdir/surya_workshop && /home/jovyan/envs/surya_ws/bin/python - <<'PY'\nimport torch, time, torch.nn as nn\ndef bench_mm(dt, M=16384, K=1280, N=5120, iters=20):\n    a=torch.randn(M,K,device='cuda',dtype=dt); b=torch.randn(K,N,device='cuda',dtype=dt)\n    for _ in range(3): a@b\n    torch.cuda.synchronize(); t=time.time()\n    for _ in range(iters): a@b\n    torch.cuda.synchronize(); del a,b; torch.cuda.empty_cache()\n    return (time.time()-t)/iters*1e3\nfor dt in (torch.float32, torch.bfloat16, torch.float16):\n    print(f\"mlp-shaped GEMM 16384x1280x5120 {dt}: {bench_mm(dt):.2f} ms\")\nw = torch.randn(256,129,1280,2)*0.02\nfor dt in (torch.bfloat16, torch.float16):\n    rel=((w.to(dt).float()-w).abs()/w.abs().clamp_min(1e-12))\n    print(f\"complex_weight {dt} rel err mean {rel.mean():.5f} max {rel.max():.5f}\")\nseq = nn.Sequential(nn.Conv2d(1280,256,1), nn.PixelShuffle(16)).cuda().half()\no = seq(torch.randn(1,1280,16,16,device='cuda',dtype=torch.float16))\nprint(\"fp16 Conv2d+PixelShuffle ->\", o.dtype, tuple(o.shape))\n# elementwise / LN throughput bf16 vs fp16 vs fp32\ndef bench_ln(dt, n=1<<22, iters=30):\n    ln=nn.LayerNorm(1280).cuda().to(dt); x=torch.randn(n//1280,1280,device='cuda',dtype=dt)\n    for _ in range(3): ln(x)\n    torch.cuda.synchronize(); t=time.time()\n    for _ in range(iters): ln(x)\n    torch.cuda.synchronize(); del x; torch.cuda.empty_cache()\n    return (time.time()-t)/iters*1e3\nfor dt in (torch.float32, torch.bfloat16, torch.float16):\n    print(f\"LayerNorm {dt}: {bench_ln(dt):.3f} ms\")\nPY",
