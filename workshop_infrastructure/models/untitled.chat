 self._desired_input_dtype = torch.bfloat16 if precision == \"bf16-true\" else torch.float16\n    41\t\n    42\t    @override\n    43\t    def convert_module(self, module: Module) -> Module:\n    44\t        return module.to(dtype=self._desired_input_dtype)\n    45\t\n    46\t    @override\n    47\t    def tensor_init_context(self) -> AbstractContextManager:\n    48\t        return _DtypeContextManager(self._desired_input_dtype)\n    49\t\n    50\t    @override\n    51\t    def module_init_context(self) -> AbstractContextManager:\n    52\t        return self.tensor_init_context()\n    53\t\n    54\t    @override\n    55\t    @contextmanager\n    56\t    def forward_context(self) -> Generator[None, None, None]:\n    57\t        \"\"\"A context manager to change the default tensor type when tensors get created during the module's forward.\n    58\t\n    59\t        See: :meth:`torch.set_default_tensor_type`\n    60\t\n    61\t        \"\"\"\n    62\t        default_dtype = torch.get_default_dtype()\n    63\t        torch.set_default_dtype(self._desired_input_dtype)\n    64\t        try:\n    65\t            yield\n    66\t        finally:\n    67\t            torch.set_default_dtype(default_dtype)\n    68\t\n    69\t    @override\n    70\t    def convert_input(self, data: Any) -> Any:\n    71\t        return apply_to_collection(data, function=_convert_fp_tensor, dtype=Tensor, dst_type=self._desired_input_dtype)"
