              "command": "cd /home/jovyan/adi_wdir/surya_workshop && /home/jovyan/envs/surya_ws/bin/python - <<'PY'\nimport torch, torch.nn as nn\nfrom peft import LoraConfig, get_peft_model\nfrom peft.tuners.tuners_utils import BaseTunerLayer\n\nclass Mlp(nn.Module):\n    def __init__(self):\n        super().__init__(); self.fc1=nn.Linear(8,16); self.act=nn.GELU(); self.fc2=nn.Linear(16,8)\n    def forward(self,x): return self.fc2(self.act(self.fc1(x)))\nclass M(nn.Module):\n    def __init__(self):\n        super().__init__(); self.backbone=Mlp(); self.head_unembed=nn.Linear(8,2)\n    def forward(self,x): return self.head_unembed(self.backbone(x))\n\ndef probe(disable):\n    m = get_peft_model(M(), LoraConfig(r=2, lora_alpha=8, target_modules=[\"fc1\",\"fc2\"],\n                                       lora_dropout=0.1, bias=\"none\", modules_to_save=[\"head_unembed\"]))\n    if disable:\n        for mod in m.modules():\n            if isinstance(mod, BaseTunerLayer):\n                mod.cast_input_dtype_enabled = False\n    fc2 = m.base_model.model.backbone.fc2\n    rec = {}\n    orig = fc2._cast_input_dtype\n    def spy(x, dt):\n        y = orig(x, dt); rec['in']=x.dtype; rec['out']=y.dtype; rec['same_obj']=(y is x); return y\n    fc2._cast_input_dtype = spy\n    with torch.autocast(\"cpu\", dtype=torch.bfloat16):\n        m(torch.randn(2,8))\n    return rec\nprint(\"cast ENABLED (current): \", probe(False))\nprint(\"cast DISABLED (fix):    \", probe(True))\nPY",
