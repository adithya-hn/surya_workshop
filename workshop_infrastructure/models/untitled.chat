            "kind": "execute",
            "raw_output": "    import numpy as np\n    log_intensity = np.log10(intensity)\n    shifted = log_intensity - log_intensity.min()\n    return shifted / (2 * shifted.std())\n\n\ndef build_datasets(cfg: TrainingConfig, scalers) -> Tuple[DataLoader, DataLoader]:\n    \"\"\"Create train and validation DataLoaders from config.\n\n    Everything generic (channels, temporal sampling, S3 access, worker settings) is\n    handled by build_helio_dataloaders(). Only the flare-specific arguments below are\n    this app's business \u2014 when you fork the template, this is the list you replace.\n\n    ``scalers`` is built once in main() and shared with build_model(), so the two paths\n    cannot end up with different normalization statistics.\n    \"\"\"\n    return build_helio_dataloaders(\n        cfg,\n        FlareDSDataset,\n        scalers=scalers,\n        seed=cfg.seed,\n        return_surya_stack=True,\n        max_number_of_samples=cfg.data.max_samples,\n        label_transform=_flare_label_transform,\n        ds_flare_index_path=cfg.data.flare_index_path,\n        ds_time_column=cfg.data.ds_time_column,\n=== template dataset signature ===\n38:    def __init__(\n39-        self,\n40-        # Downstream-specific parameters\n41-        return_surya_stack: bool = True,\n42-        max_number_of_samples: int | None = None,\n43-        label_transform: Callable[[pd.Series], pd.Series] | None = None,\n44-        ds_flare_index_path: str | None = None,\n45-        ds_time_column: str | None = None,\n46-        ds_time_tolerance: str | None = None,\n47-        ds_match_direction: Literal[\"forward\", \"backward\", \"nearest\"] = \"forward\",\n48-        # All HelioNetCDFDataset parameters (index_path, scalers, channels, s3_*, etc.)\n49-        **kwargs,\n50-    ):\n51-        if ds_match_direction not in [\"forward\", \"backward\", \"nearest\"]:\n52-            raise ValueError(\"ds_match_direction must be one of 'forward', 'backward', or 'nearest'\")\n53-\n54-        # load_forecast_frames defaults to False here: flare forecasting supplies its\n55-        # own labels, so future Surya frames never need to be fetched from disk/S3.\n56-        kwargs.setdefault(\"load_forecast_frames\", False)\n57-        super().__init__(**kwargs)\n58-\n59-        self.return_surya_stack = return_surya_stack\n60-\nShell cwd was reset to /home/jovyan/adi_wdir/surya_workshop/workshop_infrastructure/models",
            "tool_call_id": "toolu_bdrk_01StQ1b4NPMG7qHKQENaVSVz",
