            "title": "cd surya_workshop && nvidia-smi --query-gpu=memory.used,memory.free --format=csv,noheader && python - <<'PYEOF' 2>&1 | grep -v FutureWarning | tail -30 import sys, torch sys.path.insert(0, \".\") sys.path.insert(0, \"tests\") from workshop_infrastructure.models.finetune_models import HelioSpectformer2D from workshop_infrastructure.configs import LoraAdapterConfig from workshop_infrastructure.utils import apply_peft_lora, cast_frozen_to, disable_peft_input_dtype_cast m = HelioSpectformer2D( img_size=64, patch_size=16, in_chans=13, embed_dim=32, time_embedding={\"type\": \"linear\", \"time_dim\": 1}, depth=3, n_spectral_blocks=1, num_heads=2, mlp_ratio=4, drop_rate=0.0, window_size=2, dp_rank=2, dtype=torch.float32, ft_out_chans=1, ) print(\"head:\", type(m.head_unembed).__name__) m = apply_peft_lora(m, LoraAdapterConfig()) disable_peft_input_dtype_cast(m) cast_frozen_to(m, torch.float16) batch = {\"ts\": torch.randn(2, 13, 1, 64, 64), \"time_delta_input\": torch.zeros(2, 1)} before = [p.detach().clone() for p in m.parameters() if p.requires_grad] opt = torch.optim.Adam([p for p in m.parameters() if p.requires_grad], lr=1e-2) with torch.autocast(\"cpu\", dtype=torch.bfloat16): out = m(batch) print(\"2D output shape:\", tuple(out.shape), \"dtype:\", out.dtype) loss = out.float().square().mean() loss.backward() opt.step() after = [p for p in m.parameters() if p.requires_grad] moved = sum(1 for b, a in zip(before, after) if not torch.equal(b, a)) print(f\"trainable tensors that moved: {moved}/{len(before)}\") # ft_checkpoint_head path m2 = HelioSpectformer2D( img_size=64, patch_size=16, in_chans=13, embed_dim=32, time_embedding={\"type\": \"linear\", \"time_dim\": 1}, depth=3, n_spectral_blocks=1, num_heads=2, mlp_ratio=4, drop_rate=0.0, window_size=2, dp_rank=2, dtype=torch.float32, ft_out_chans=1, ft_checkpoint_head=True, ) m2 = apply_peft_lora(m2, LoraAdapterConfig()) m2.train() o2 = m2(batch) o2.float().square().mean().backward() g = [n for n, p in m2.named_parameters() if p.requires_grad and p.grad is not None] print(f\"ft_checkpoint_head=True: forward+backward ok, {len(g)} trainable tensors got grads\") PYEOF",
            "raw_output": "12383 MiB, 2713 MiB\n[LoRA]   backbone.backbone.blocks_attention.0.attn.qkv\n[LoRA]   backbone.backbone.blocks_attention.0.mlp.fc1\n[LoRA]   backbone.backbone.blocks_attention.0.mlp.fc2\n[LoRA]   backbone.backbone.blocks_attention.1.attn.proj\n[LoRA]   backbone.backbone.blocks_attention.1.attn.qkv\n[LoRA]   backbone.backbone.blocks_attention.1.mlp.fc1\n[LoRA]   backbone.backbone.blocks_attention.1.mlp.fc2\n[LoRA]   backbone.backbone.blocks_spectral_gating.0.mlp.fc1\n[LoRA]   backbone.backbone.blocks_spectral_gating.0.mlp.fc2\n[LoRA] Trainable head modules (modules_to_save): ['head_unembed']\ntrainable params: 19,200 || all params: 169,160 || trainable%: 11.35%\n[LoRA] Disabled PEFT input-dtype casting on 10 tuner layer(s).\n[PRECISION] Cast 27 frozen parameter(s) and 1 buffer(s) to torch.float16; left 10 normalization layer(s) in fp32.\n2D output shape: (2, 1, 64, 64) dtype: torch.bfloat16\ntrainable tensors that moved: 12/22\nApplying PEFT LoRA: r=8, alpha=8, dropout=0.1, modules=['fc1', 'fc2', 'attn.qkv', 'attn.proj']\n[LoRA] Adapted modules (10):\n[LoRA]   backbone.backbone.blocks_attention.0.attn.proj\n[LoRA]   backbone.backbone.blocks_attention.0.attn.qkv\n[LoRA]   backbone.backbone.blocks_attention.0.mlp.fc1\n[LoRA]   backbone.backbone.blocks_attention.0.mlp.fc2\n[LoRA]   backbone.backbone.blocks_attention.1.attn.proj\n[LoRA]   backbone.backbone.blocks_attention.1.attn.qkv\n[LoRA]   backbone.backbone.blocks_attention.1.mlp.fc1\n[LoRA]   backbone.backbone.blocks_attention.1.mlp.fc2\n[LoRA]   backbone.backbone.blocks_spectral_gating.0.mlp.fc1\n[LoRA]   backbone.backbone.blocks_spectral_gating.0.mlp.fc2\n[LoRA] Trainable head modules (modules_to_save): ['head_unembed']\ntrainable params: 19,200 || all params: 169,160 || trainable%: 11.35%\nft_checkpoint_head=True: forward+backward ok, 22 trainable tensors got grads\nShell cwd was reset to /home/jovyan/adi_wdir/surya_workshop/workshop_infrastructure/models"
