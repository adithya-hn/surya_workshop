            "raw_output": "  200\t\n  201\tdef build_trainer(\n  202\t    cfg: TrainingConfig,\n  203\t    no_wandb: bool = False,\n  204\t    max_epochs_override: int | None = None,\n  205\t) -> Tuple[L.Trainer, ModelCheckpoint]:\n  206\t    \"\"\"Configure loggers, callbacks, and the Lightning Trainer.\"\"\"\n  207\t    max_epochs = max_epochs_override if max_epochs_override is not None else cfg.max_epochs\n  208\t\n  209\t    loggers = []\n  210\t    if not no_wandb:\n  211\t        loggers.append(WandbLogger(\n  212\t            entity=cfg.wandb_entity,  # None = personal account; set in YAML for team runs\n  213\t            project=cfg.wandb_project,\n  214\t            name=cfg.job_id,\n  215\t            log_model=False,\n  216\t            save_dir=os.environ.get(\"TMPDIR\", \"./wandb/wandb_tmp\"),\n  217\t        ))\n  218\t    loggers.append(CSVLogger(\"runs\", name=cfg.job_id))\n  219\t\n  220\t    Path(cfg.output.ckpt_dir).mkdir(parents=True, exist_ok=True)\n  221\t    checkpoint_cb = ModelCheckpoint(\n  222\t        dirpath=cfg.output.ckpt_dir,\n  223\t        filename=\"best-{epoch:02d}-{val_loss:.4f}\",\n  224\t        monitor=\"val_loss\",\n  225\t        mode=\"min\",\n  226\t        save_top_k=1,\n  227\t        save_last=False,\n  228\t    )\n  229\t    upload_cb = UploadBestCheckpointToS3(\n  230\t        checkpoint_cb=checkpoint_cb,\n  231\t        bucket=cfg.output.s3_bucket,\n  232\t        prefix=cfg.output.s3_prefix,\n  233\t        fixed_key_name=(cfg.output.s3_best_key or None),\n  234\t    )\n  235\t\n  236\t    trainer = L.Trainer(\n  237\t        max_epochs=max_epochs,\n  238\t        accelerator=\"gpu\" if torch.cuda.is_available() else \"cpu\",\n  239\t        devices=\"auto\",\n  240\t        strategy=\"auto\",\n  241\t        precision=\"bf16-mixed\" if torch.cuda.is_available() else \"32-true\",\n  242\t        # Reproducibility. \"warn\" (the default) gives bit-identical runs wherever a\n  243\t        # deterministic kernel exists and names the op where one does not, instead of\n  244\t        # killing the run. benchmark is pinned rather than inherited: cuDNN autotuning\n  245\t        # picks algorithms by timing, so leaving it on would reintroduce run-to-run drift.\n  246\t        deterministic=cfg.deterministic,\n  247\t        benchmark=False,\n  248\t        logger=loggers,\n  249\t        callbacks=[checkpoint_cb, upload_cb],\n  250\t        log_every_n_steps=2,\n  251\t    )\n  252\t    return trainer, checkpoint_cb\n  253\t\n  254\t\n  255\t# ---------------------------------------------------------------------------\n  256\t# Entry point\n  257\t# ---------------------------------------------------------------------------\n  258\t\n  259\tdef main() -> None:\n  260\t    args = parse_args()\n  261\t    torch.set_float32_matmul_precision(\"medium\")\n  262\t\n  263\t    cfg = load_flare_config(args.config)\n  264\t    # Seeding comes after the config load, so the seed is a configured value rather than\n  265\t    # a constant buried in the code. Seeds Python, NumPy and torch in this process;\n  266\t    # workers=True extends it to DataLoader workers.\n  267\t    L.seed_everything(cfg.seed, workers=True)\n  268\t    if args.batch_size is not None:\n  269\t        cfg.batch_size = args.batch_size\n  270\t    if args.s3_cache_dir is not None:\n  271\t        cfg.data.s3_cache_dir = args.s3_cache_dir\n  272\t    if args.deterministic is not None:\n  273\t        cfg.deterministic = _DETERMINISTIC_CLI[args.deterministic]\n  274\t    # Fetch scalers, and the backbone weights unless we are training the baseline.\n  275\t    ensure_assets(cfg, which=[\"scalers\"] if args.train_baseline else [\"scalers\", \"weights\"])\n  276\t\n  277\t    # Built once and shared: the dataset normalizes with these, and the linear baseline\n  278\t    # de-standardizes with them. Two separate builds could silently disagree.\n  279\t    scalers = build_scalers(info=cfg.data.scalers_path)\n  280\t\n  281\t    train_loader, val_loader = build_datasets(cfg, scalers)\n  282\t    lit_model = build_model(cfg, scalers, train_baseline=args.train_baseline)\n  283\t    trainer, checkpoint_cb = build_trainer(cfg, no_wandb=args.no_wandb, max_epochs_override=args.max_epochs)\n  284\t\n  285\t    trainer.fit(lit_model, train_loader, val_loader)\n  286\t\n  287\t    if checkpoint_cb.best_model_path:\n  288\t        print(f\"[CKPT] Best checkpoint: {checkpoint_cb.best_model_path}\")\n  289\t        if checkpoint_cb.best_model_score is not None:\n  290\t            print(f\"[CKPT] Best val_loss: {float(checkpoint_cb.best_model_score):.6f}\")\n  291\t    else:\n  292\t        print(\"[CKPT] No best checkpoint was saved.\")\n  293\t\n  294\t\n  295\tif __name__ == \"__main__\":\n  296\t    main()\n=== metrics ===\n    1\t\"\"\"\n    2\tTemplate metrics for flare forecasting.\n    3\t\n    4\tFlareMetrics defines four metric sets:\n    5\t- \"train_loss\"    \u2014 differentiable loss that drives backpropagation (MSE).\n    6\t- \"val_loss\"      \u2014 the quantity logged as `val_loss` and used to select checkpoints.\n    7\t                    Defaults to the same MSE as \"train_loss\"; override it when your task\n    8\t                    needs a different validation objective.\n    9\t- \"train_metrics\" \u2014 non-differentiable metrics logged during training (RRSE).\n   10\t- \"val_metrics\"   \u2014 metrics logged at validation for reporting only (MSE + RRSE). These\n   11\t                    do NOT influence checkpoint selection \u2014 \"val_loss\" does.\n   12\t\n   13\tThe __call__ method selects the appropriate metric set based on the mode passed at\n   14\tconstruction time. The dictionary keys returned by each method become the metric names\n   15\tpropagated to the logger (e.g. WandB, CSV).\n   16\t\"\"\"\n   17\t\n   18\timport torch\n   19\timport torchmetrics as tm  # Lots of possible metrics in here https://lightning.ai/docs/torchmetrics/stable/all-metrics.html\n   20\t\n   21\t# Shape contract: predictions arrive as (B,) from HelioSpectformer1D or (B, 1) from the\n   22\t# linear baseline, while targets are always (B, 1). Every metric below flattens both with\n   23\t# reshape(-1) rather than squeeze(-1): squeeze is shape-dependent and collapses a\n   24\t# batch of one to a 0-d scalar, which then fails to broadcast against a (1,) target.\n   25\tclass FlareMetrics:\n   26\t    def __init__(self, mode: str):\n   27\t        \"\"\"\n   28\t        Initialize FlareMetrics class.\n   29\t\n   30\t        Args:\n   31\t            mode (str): Mode to use for metric evaluation. One of \"train_loss\",\n   32\t                        \"val_loss\", \"train_metrics\", or \"val_metrics\".\n   33\t        \"\"\"\n   34\t        self.mode = mode\n   35\t\n   36\t        # Cache torchmetrics instances once (instead of recreating each call)\n   37\t        self._rrse = tm.RelativeSquaredError(squared=False)\n   38\t\n   39\t    def _ensure_device(self, preds: torch.Tensor) -> None:\n   40\t        \"\"\"Move torchmetrics modules to the same device as ``preds``, if needed.\"\"\"\n   41\t        if self._rrse.device != preds.device:\n   42\t            self._rrse = self._rrse.to(preds.device)\n   43\t\n   44\t    def train_loss(\n   45\t        self, preds: torch.Tensor, target: torch.Tensor\n   46\t    ) -> tuple[dict[str, torch.Tensor], list[float]]:\n   47\t        \"\"\"\n   48\t        Calculate loss metrics for training.\n   49\t\n   50\t        Args:\n   51\t            preds (torch.Tensor): Model predictions.\n   52\t            target (torch.Tensor): Ground truth labels.\n   53\t\n   54\t        Returns:\n   55\t            tuple[dict[str, torch.Tensor], list[float]]:\n   56\t                - dict[str, torch.Tensor]: Dictionary containing the calculated loss metrics.\n   57\t                                        Keys are metric names (e.g., \"mse\"), and values are the\n   58\t                                        corresponding torch.Tensor values.\n   59\t                - list[float]: List of weights for each calculated metric.\n   60\t        \"\"\"\n   61\t\n   62\t        output_metrics = {}\n   63\t        output_weights = []\n   64\t\n   65\t        output_metrics[\"mse\"] = torch.nn.functional.mse_loss(preds.reshape(-1), target.reshape(-1))\n   66\t        output_weights.append(1)\n   67\t\n   68\t        return output_metrics, output_weights\n   69\t\n   70\t    def val_loss(\n   71\t        self, preds: torch.Tensor, target: torch.Tensor\n   72\t    ) -> tuple[dict[str, torch.Tensor], list[float]]:\n   73\t        \"\"\"\n   74\t        Calculate the validation loss \u2014 the quantity logged as ``val_loss`` and used by\n   75\t        ModelCheckpoint to select the best model.\n   76\t\n   77\t        By default this delegates to ``train_loss``, so the monitored quantity has the same\n   78\t        form as the training objective and the two cannot drift apart by accident. This is\n   79\t        the hook to override when your task needs a different validation objective (a\n   80\t        different weighting, a metric that is meaningful only on held-out data, etc.)."
          },
