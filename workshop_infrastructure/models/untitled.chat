      "metadata": {
        "tool_calls": [
          {
            "tool_call_id": "toolu_bdrk_01LEh9uZ8pPSxbjMhkaaBje4",
            "kind": "execute",
            "raw_output": "ok downstream_apps/template/3_finetune_template_1D.py\nok downstream_apps/sf_triggers/3_finetune_template_1D.py\nok notebook\nok CLAUDE.md\nShell cwd was reset to /home/jovyan/adi_wdir/surya_workshop/workshop_infrastructure/models",
            "title": "cd surya_workshop && cat > allocnote.py <<'PYEOF' import json from pathlib import Path note = '''# Lets the caching allocator grow a segment instead of reserving fixed-size blocks. This run # allocates tensors of many different shapes -- every gradient-checkpoint recompute is a # different shape -- which strands memory as \"reserved but unallocated\": visible in # nvidia-smi, unusable by the next allocation. The failure this replaces reported 1.82 GiB # stranded that way. # # torch 2.9 prints \"PYTORCH_CUDA_ALLOC_CONF is deprecated, use PYTORCH_ALLOC_CONF instead\". # Ignore it: PYTORCH_ALLOC_CONF is silently ignored for this setting on 2.9.1 (verified via # torch.cuda.memory_snapshot()[i][\"is_expandable\"], which is only True under the old name). # Do not \"fix\" the warning without re-checking that flag, or expandable segments turn off # without a word. Unlike CUBLAS_WORKSPACE_CONFIG this only needs to precede the first CUDA # *allocation*, not the torch import. os.environ.setdefault(\"PYTORCH_CUDA_ALLOC_CONF\", \"expandable_segments:True\")''' # --- both scripts --- old_script = '''# Lets the caching allocator grow a segment instead of reserving fixed-size blocks, which # recovers the reserved-but-unallocated memory that otherwise strands several GiB when a # run allocates tensors of many different shapes -- as this one does, since every # gradient-checkpoint recompute allocates and frees a different shape. Unlike # CUBLAS_WORKSPACE_CONFIG this only has to precede the first CUDA *allocation*, but it # lives here so there is one \"set before torch does anything\" block rather than two. os.environ.setdefault(\"PYTORCH_CUDA_ALLOC_CONF\", \"expandable_segments:True\")''' for path in (\"downstream_apps/template/3_finetune_template_1D.py\", \"downstream_apps/sf_triggers/3_finetune_template_1D.py\"): p = Path(path) s = p.read_text() assert s.count(old_script) == 1, path p.write_text(s.replace(old_script, note)) print(\"ok\", path) # --- notebook cell 3 --- nbp = Path(\"downstream_apps/sf_triggers/2_finetune_template_1D.ipynb\") nb = json.loads(nbp.read_text()) c = nb[\"cells\"][3] src = \"\".join(c[\"source\"]) old_nb = '''# Lets the caching allocator grow a segment instead of reserving fixed-size blocks. This run # allocates tensors of many different shapes -- every gradient-checkpoint recompute is a # different shape -- which strands memory as \"reserved but unallocated\": present in # nvidia-smi, unusable by the next allocation. The failure this notebook used to hit reported # 1.82 GiB stranded that way. Unlike CUBLAS_WORKSPACE_CONFIG this only needs to precede the # first CUDA *allocation*, but it lives here so there is one \"set before torch does # anything\" block instead of two. os.environ.setdefault(\"PYTORCH_CUDA_ALLOC_CONF\", \"expandable_segments:True\")''' assert src.count(old_nb) == 1 src = src.replace(old_nb, note) c[\"source\"] = [l + \"\\n\" for l in src.split(\"\\n\")[:-1]] + ([src.split(\"\\n\")[-1]] if src.split(\"\\n\")[-1] else []) nbp.write_text(json.dumps(nb, indent=1, ensure_ascii=False) + \"\\n\") print(\"ok notebook\") # --- CLAUDE.md --- cp = Path(\"CLAUDE.md\") s = cp.read_text() old_doc = '''**Also set, and worth keeping:** `PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True` alongside `CUBLAS_WORKSPACE_CONFIG` in the entry points (this one only needs to precede the first CUDA *allocation*, not the torch import). Every recompute allocates a different shape, which strands memory as reserved-but-unallocated \u2014 1.82 GiB of it in the original failure.''' new_doc = '''**Also set, and worth keeping:** `PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True` alongside `CUBLAS_WORKSPACE_CONFIG` in the entry points (this one only needs to precede the first CUDA *allocation*, not the torch import). Every recompute allocates a different shape, which strands memory as reserved-but-unallocated \u2014 1.82 GiB of it in the original failure. **torch 2.9 warns that this variable is deprecated in favour of `PYTORCH_ALLOC_CONF`; do not act on that warning.** On 2.9.1 the new name is silently ignored for this setting \u2014 verified via `torch.cuda.memory_snapshot()[i][\"is_expandable\"]`, which is `True` only under the old name. Re-check that flag before changing it, or expandable segments switch off with no error.''' assert s.count(old_doc) == 1 cp.write_text(s.replace(old_doc, new_doc)) print(\"ok CLAUDE.md\") PYEOF python allocnote.py",
            "raw_input": {
              "command": "cd /home/jovyan/adi_wdir/surya_workshop && cat > /tmp/allocnote.py <<'PYEOF'\nimport json\nfrom pathlib import Path\n\nnote = '''# Lets the caching allocator grow a segment instead of reserving fixed-size blocks. This run\n# allocates tensors of many different shapes -- every gradient-checkpoint recompute is a\n# different shape -- which strands memory as \"reserved but unallocated\": visible in\n# nvidia-smi, unusable by the next allocation. The failure this replaces reported 1.82 GiB\n# stranded that way.\n#\n# torch 2.9 prints \"PYTORCH_CUDA_ALLOC_CONF is deprecated, use PYTORCH_ALLOC_CONF instead\".\n# Ignore it: PYTORCH_ALLOC_CONF is silently ignored for this setting on 2.9.1 (verified via\n# torch.cuda.memory_snapshot()[i][\"is_expandable\"], which is only True under the old name).\n# Do not \"fix\" the warning without re-checking that flag, or expandable segments turn off\n# without a word. Unlike CUBLAS_WORKSPACE_CONFIG this only needs to precede the first CUDA\n# *allocation*, not the torch import.\nos.environ.setdefault(\"PYTORCH_CUDA_ALLOC_CONF\", \"expandable_segments:True\")'''\n\n# --- both scripts ---\nold_script = '''# Lets the caching allocator grow a segment instead of reserving fixed-size blocks, which\n# recovers the reserved-but-unallocated memory that otherwise strands several GiB when a\n# run allocates tensors of many different shapes -- as this one does, since every\n# gradient-checkpoint recompute allocates and frees a different shape. Unlike\n# CUBLAS_WORKSPACE_CONFIG this only has to precede the first CUDA *allocation*, but it\n# lives here so there is one \"set before torch does anything\" block rather than two.\nos.environ.setdefault(\"PYTORCH_CUDA_ALLOC_CONF\", \"expandable_segments:True\")'''\n\nfor path in (\"downstream_apps/template/3_finetune_template_1D.py\",\n             \"downstream_apps/sf_triggers/3_finetune_template_1D.py\"):\n    p = Path(path)\n    s = p.read_text()\n    assert s.count(old_script) == 1, path\n    p.write_text(s.replace(old_script, note))\n    print(\"ok\", path)\n\n# --- notebook cell 3 ---\nnbp = Path(\"downstream_apps/sf_triggers/2_finetune_template_1D.ipynb\")\nnb = json.loads(nbp.read_text())\nc = nb[\"cells\"][3]\nsrc = \"\".join(c[\"source\"])\nold_nb = '''# Lets the caching allocator grow a segment instead of reserving fixed-size blocks. This run\n# allocates tensors of many different shapes -- every gradient-checkpoint recompute is a\n# different shape -- which strands memory as \"reserved but unallocated\": present in\n# nvidia-smi, unusable by the next allocation. The failure this notebook used to hit reported\n# 1.82 GiB stranded that way. Unlike CUBLAS_WORKSPACE_CONFIG this only needs to precede the\n# first CUDA *allocation*, but it lives here so there is one \"set before torch does\n# anything\" block instead of two.\nos.environ.setdefault(\"PYTORCH_CUDA_ALLOC_CONF\", \"expandable_segments:True\")'''\nassert src.count(old_nb) == 1\nsrc = src.replace(old_nb, note)\nc[\"source\"] = [l + \"\\n\" for l in src.split(\"\\n\")[:-1]] + ([src.split(\"\\n\")[-1]] if src.split(\"\\n\")[-1] else [])\nnbp.write_text(json.dumps(nb, indent=1, ensure_ascii=False) + \"\\n\")\nprint(\"ok notebook\")\n\n# --- CLAUDE.md ---\ncp = Path(\"CLAUDE.md\")\ns = cp.read_text()\nold_doc = '''**Also set, and worth keeping:** `PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True` alongside\n`CUBLAS_WORKSPACE_CONFIG` in the entry points (this one only needs to precede the first CUDA\n*allocation*, not the torch import). Every recompute allocates a different shape, which strands\nmemory as reserved-but-unallocated \u2014 1.82 GiB of it in the original failure.'''\nnew_doc = '''**Also set, and worth keeping:** `PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True` alongside\n`CUBLAS_WORKSPACE_CONFIG` in the entry points (this one only needs to precede the first CUDA\n*allocation*, not the torch import). Every recompute allocates a different shape, which strands\nmemory as reserved-but-unallocated \u2014 1.82 GiB of it in the original failure. **torch 2.9 warns\nthat this variable is deprecated in favour of `PYTORCH_ALLOC_CONF`; do not act on that warning.**\nOn 2.9.1 the new name is silently ignored for this setting \u2014 verified via\n`torch.cuda.memory_snapshot()[i][\"is_expandable\"]`, which is `True` only under the old name.\nRe-check that flag before changing it, or expandable segments switch off with no error.'''\nassert s.count(old_doc) == 1\ncp.write_text(s.replace(old_doc, new_doc))\nprint(\"ok CLAUDE.md\")\nPYEOF\n/home/jovyan/envs/surya_ws/bin/python /tmp/allocnote.py",
              "description": "Document the misleading deprecation warning"
            },
            "status": "completed"
          }
        ]
