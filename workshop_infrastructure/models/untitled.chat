              "command": "cd /home/jovyan/adi_wdir/surya_workshop && echo \"=== sf_triggers metrics ===\" && cat downstream_apps/sf_triggers/metrics/sf_triggers_metrics.py && echo \"=== lightning module (template) ===\" && cat downstream_apps/template/lightning_modules/pl_simple_baseline.py && echo \"=== diff configs ===\" && diff -u downstream_apps/template/configs/config_script.yaml downstream_apps/sf_triggers/configs/config_script.yaml",
