;32m    633\u001b[0m \u001b[38;5;28mself\u001b[39m\u001b[38;5;241m.\u001b[39mtraining \u001b[38;5;241m=\u001b[39m \u001b[38;5;28;01mFalse\u001b[39;00m\n\nFile \u001b[0;32m~/envs/surya_ws/lib/python3.12/site-packages/lightning/pytorch/trainer/trainer.py:1079\u001b[0m, in \u001b[0;36mTrainer._run\u001b[0;34m(self, model, ckpt_path, weights_only)\u001b[0m\n\u001b[1;32m   1074\u001b[0m \u001b[38;5;28mself\u001b[39m\u001b[38;5;241m.\u001b[39m_signal_connector\u001b[38;5;241m.\u001b[39mregister_signal_handlers()\n\u001b[1;32m   1076\u001b[0m \u001b[38;5;66;03m# ----------------------------\u001b[39;00m\n\u001b[1;32m   1077\u001b[0m \u001b[38;5;66;03m# RUN THE TRAINER\u001b[39;00m\n\u001b[1;32m   1078\u001b[0m \u001b[38;5;66;03m# ----------------------------\u001b[39;00m\n\u001b[0;32m-> 1079\u001b[0m results \u001b[38;5;241m=\u001b[39m \u001b[38;5;28;43mself\u001b[39;49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43m_run_stage\u001b[49m\u001b[43m(\u001b[49m\u001b[43m)\u001b[49m\n\u001b[1;32m   1081\u001b[0m \u001b[38;5;66;03m# ----------------------------\u001b[39;00m\n\u001b[1;32m   1082\u001b[0m \u001b[38;5;66;03m# POST-Training CLEAN UP\u001b[39;00m\n\u001b[1;32m   1083\u001b[0m \u001b[38;5;66;03m# ----------------------------\u001b[39;00m\n\u001b[1;32m   1084\u001b[0m log\u001b[38;5;241m.\u001b[39mdebug(\u001b[38;5;124mf\u001b[39m\u001b[38;5;124m\"\u001b[39m\u001b[38;5;132;01m{\u001b[39;00m\u001b[38;5;28mself\u001b[39m\u001b[38;5;241m.\u001b[39m\u001b[38;5;18m__class__\u001b[39m\u001b[38;5;241m.\u001b[39m\u001b[38;5;18m__name__\u001b[39m\u001b[38;5;132;01m}\u001b[39;00m\u001b[38;5;124m: trainer tearing down\u001b[39m\u001b[38;5;124m\"\u001b[39m)\n\nFile \u001b[0;32m~/envs/surya_ws/lib/python3.12/site-packages/lightning/pytorch/trainer/trainer.py:1123\u001b[0m, in \u001b[0;36mTrainer._run_stage\u001b[0;34m(self)\u001b[0m\n\u001b[1;32m   1121\u001b[0m         \u001b[38;5;28mself\u001b[39m\u001b[38;5;241m.\u001b[39m_run_sanity_check()\n\u001b[1;32m   1122\u001b[0m     \u001b[38;5;28;01mwith\u001b[39;00m torch\u001b[38;5;241m.\u001b[39mautograd\u001b[38;5;241m.\u001b[39mset_detect_anomaly(\u001b[38;5;28mself\u001b[39m\u001b[38;5;241m.\u001b[39m_detect_anomaly):\n\u001b[0;32m-> 1123\u001b[0m         \u001b[38;5;28;43mself\u001b[39;49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43mfit_loop\u001b[49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43mrun\u001b[49m\u001b[43m(\u001b[49m\u001b[43m)\u001b[49m\n\u001b[1;32m   1124\u001b[0m     \u001b[38;5;28;01mreturn\u001b[39;00m \u001b[38;5;28;01mNone\u001b[39;00m\n\u001b[1;32m   1125\u001b[0m \u001b[38;5;28;01mraise\u001b[39;00m \u001b[38;5;167;01mRuntimeError\u001b[39;00m(\u001b[38;5;124mf\u001b[39m\u001b[38;5;124m\"\u001b[39m\u001b[38;5;124mUnexpected state \u001b[39m\u001b[38;5;132;01m{\u001b[39;00m\u001b[38;5;28mself\u001b[39m\u001b[38;5;241m.\u001b[39mstate\u001b[38;5;132;01m}\u001b[39;00m\u001b[38;5;124m\"\u001b[39m)\n\nFile \u001b[0;32m~/envs/surya_ws/lib/python3.12/site-packages/lightning/pytorch/loops/fit_loop.py:217\u001b[0m, in \u001b[0;36m_FitLoop.run\u001b[0;34m(self)\u001b[0m\n\u001b[1;32m    215\u001b[0m \u001b[38;5;28;01mtry\u001b[39;00m:\n\u001b[1;32m    216\u001b[0m     \u001b[38;5;28mself\u001b[39m\u001b[38;5;241m.\u001b[39mon_advance_start()\n\u001b[0;32m--> 217\u001b[0m     \u001b[38;5;28;43mself\u001b[39;49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43madvance\u001b[49m\u001b[43m(\u001b[49m\u001b[43m)\u001b[49m\n\u001b[1;32m    218\u001b[0m     \u001b[38;5;28mself\u001b[39m\u001b[38;5;241m.\u001b[39mon_advance_end()\n\u001b[1;32m    219\u001b[0m \u001b[38;5;28;01mexcept\u001b[39;00m \u001b[38;5;167;01mStopIteration\u001b[39;00m:\n\nFile \u001b[0;32m~/envs/surya_ws/lib/python3.12/site-packages/lightning/pytorch/loops/fit_loop.py:469\u001b[0m, in \u001b[0;36m_FitLoop.advance\u001b[0;34m(self)\u001b[0m\n\u001b[1;32m    467\u001b[0m \u001b[38;5;28;01mwith\u001b[39;00m \u001b[38;5;28mself\u001b[39m\u001b[38;5;241m.\u001b[39mtrainer\u001b[38;5;241m.\u001b[39mprofiler\u001b[38;5;241m.\u001b[39mprofile(\u001b[38;5;124m\"\u001b[39m\u001b[38;5;124mrun_training_epoch\u001b[39m\u001b[38;5;124m\"\u001b[39m):\n\u001b[1;32m    468\u001b[0m     \u001b[38;5;28;01massert\u001b[39;00m \u001b[38;5;28mself\u001b[39m\u001b[38;5;241m.\u001b[39m_data_fetcher \u001b[38;5;129;01mis\u001b[39;00m \u001b[38;5;129;01mnot\u001b[39;00m \u001b[38;5;28;01mNone\u001b[39;00m\n\u001b[0;32m--> 469\u001b[0m     \u001b[38;5;28;43mself\u001b[39;49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43mepoch_loop\u001b[49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43mrun\u001b[49m\u001b[43m(\u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43m_data_fetcher\u001b[49m\u001b[43m)\u001b[49m\n\nFile \u001b[0;32m~/envs/surya_ws/lib/python3.12/site-packages/lightning/pytorch/loops/training_epoch_loop.py:153\u001b[0m, in \u001b[0;36m_TrainingEpochLoop.run\u001b[0;34m(self, data_fetcher)\u001b[0m\n\u001b[1;32m    151\u001b[0m \u001b[38;5;28;01mwhile\u001b[39;00m \u001b[38;5;129;01mnot\u001b[39;00m \u001b[38;5;28mself\u001b[39m\u001b[38;5;241m.\u001b[39mdone:\n\u001b[1;32m    152\u001b[0m     \u001b[38;5;28;01mtry\u001b[39;00m:\n\u001b[0;32m--> 153\u001b[0m         \u001b[38;5;28;43mself\u001b[39;49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43madvance\u001b[49m\u001b[43m(\u001b[49m\u001b[43mdata_fetcher\u001b[49m\u001b[43m)\u001b[49m\n\u001b[1;32m    154\u001b[0m         \u001b[38;5;28mself\u001b[39m\u001b[38;5;241m.\u001b[39mon_advance_end(data_fetcher)\n\u001b[1;32m    155\u001b[0m     \u001b[38;5;28;01mexcept\u001b[39;00m \u001b[38;5;167;01mStopIteration\u001b[39;00m:\n\nFile \u001b[0;32m~/envs/surya_ws/lib/python3.12/site-packages/lightning/pytorch/loops/training_epoch_loop.py:352\u001b[0m, in \u001b[0;36m_TrainingEpochLoop.advance\u001b[0;34m(self, data_fetcher)\u001b[0m\n\u001b[1;32m    349\u001b[0m \u001b[38;5;28;01mwith\u001b[39;00m trainer\u001b[38;5;241m.\u001b[39mprofiler\u001b[38;5;241m.\u001b[39mprofile(\u001b[38;5;124m\"\u001b[39m\u001b[38;5;124mrun_training_batch\u001b[39m\u001b[38;5;124m\"\u001b[39m):\n\u001b[1;32m    350\u001b[0m     \u001b[38;5;28;01mif\u001b[39;00m trainer\u001b[38;5;241m.\u001b[39mlightning_module\u001b[38;5;241m.\u001b[39mautomatic_optimization:\n\u001b[1;32m    351\u001b[0m         \u001b[38;5;66;03m# in automatic optimization, there can only be one optimizer\u001b[39;00m\n\u001b[0;32m--> 352\u001b[0m         batch_output \u001b[38;5;241m=\u001b[39m \u001b[38;5;28;43mself\u001b[39;49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43mautomatic_optimization\u001b[49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43mrun\u001b[49m\u001b[43m(\u001b[49m\u001b[43mtrainer\u001b[49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43moptimizers\u001b[49m\u001b[43m[\u001b[49m\u001b[38;5;241;43m0\u001b[39;49m\u001b[43m]\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mbatch_idx\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mkwargs\u001b[49m\u001b[43m)\u001b[49m\n\u001b[1;32m    353\u001b[0m     \u001b[38;5;28;01melse\u001b[39;00m:\n\u001b[1;32m    354\u001b[0m         batch_output \u001b[38;5;241m=\u001b[39m \u001b[38;5;28mself\u001b[39m\u001b[38;5;241m.\u001b[39mmanual_optimization\u001b[38;5;241m.\u001b[39mrun(kwargs)\n\nFile \u001b[0;32m~/envs/surya_ws/lib/python3.12/site-packages/lightning/pytorch/loops/optimization/automatic.py:192\u001b[0m, in \u001b[0;36m_AutomaticOptimization.run\u001b[0;34m(self, optimizer, batch_idx, kwargs)\u001b[0m\n\u001b[1;32m    185\u001b[0m         closure()\n\u001b[1;32m    187\u001b[0m \u001b[38;5;66;03m# ------------------------------\u001b[39;00m\n\u001b[1;32m    188\u001b[0m \u001b[38;5;66;03m# BACKWARD PASS\u001b[39;00m\n\u001b[1;32m    189\u001b[0m \u001b[38;5;66;03m# ------------------------------\u001b[39;00m\n\u001b[1;32m    190\u001b[0m \u001b[38;5;66;03m# gradient update with accumulated gradients\u001b[39;00m\n\u001b[1;32m    191\u001b[0m \u001b[38;5;28;01melse\u001b[39;00m:\n\u001b[0;32m--> 192\u001b[0m     \u001b[38;5;28;43mself\u001b[39;49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43m_optimizer_step\u001b[49m\u001b[43m(\u001b[49m\u001b[43mbatch_idx\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mclosure\u001b[49m\u001b[43m)\u001b[49m\n\u001b[1;32m    194\u001b[0m result \u001b[38;5;241m=\u001b[39m closure\u001b[38;5;241m.\u001b[39mconsume_result()\n\u001b[1;32m    195\u001b[0m \u001b[38;5;28;01mif\u001b[39;00m result\u001b[38;5;241m.\u001b[39mloss \u001b[38;5;129;01mis\u001b[39;00m \u001b[38;5;28;01mNone\u001b[39;00m:\n\nFile \u001b[0;32m~/envs/surya_ws/lib/python3.12/site-packages/lightning/pytorch/loops/optimization/automatic.py:270\u001b[0m, in \u001b[0;36m_AutomaticOptimization._optimizer_step\u001b[0;34m(self, batch_idx, train_step_and_backward_closure)\u001b[0m\n\u001b[1;32m    267\u001b[0m     \u001b[38;5;28mself\u001b[39m\u001b[38;5;241m.\u001b[39moptim_progress\u001b[38;5;241m.\u001b[39moptimizer\u001b[38;5;241m.\u001b[39mstep\u001b[38;5;241m.\u001b[39mincrement_ready()\n\u001b[1;32m    269\u001b[0m \u001b[38;5;66;03m# model hook\u001b[39;00m\n\u001b[0;32m--> 270\u001b[0m \u001b[43mcall\u001b[49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43m_call_lightning_module_hook\u001b[49m\u001b[43m(\u001b[49m\n\u001b[1;32m    271\u001b[0m \u001b[43m    \u001b[49m\u001b[43mtrainer\u001b[49m\u001b[43m,\u001b[49m\n\u001b[1;32m    272\u001b[0m \u001b[43m    \u001b[49m\u001b[38;5;124;43m\"\u001b[39;49m\u001b[38;5;124;43moptimizer_step\u001b[39;49m\u001b[38;5;124;43m\"\u001b[39;49m\u001b[43m,\u001b[49m\n\u001b[1;32m    273\u001b[0m \u001b[43m    \u001b[49m\u001b[43mtrainer\u001b[49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43mcurrent_epoch\u001b[49m\u001b[43m,\u001b[49m\n\u001b[1;32m    274\u001b[0m \u001b[43m    \u001b[49m\u001b[43mbatch_idx\u001b[49m\u001b[43m,\u001b[49m\n\u001b[1;32m    275\u001b[0m \u001b[43m    \u001b[49m\u001b[43moptimizer\u001b[49m\u001b[43m,\u001b[49m\n\u001b[1;32m    276\u001b[0m \u001b[43m    \u001b[49m\u001b[43mtrain_step_and_backward_closure\u001b[49m\u001b[43m,\u001b[49m\n\u001b[1;32m    277\u001b[0m \u001b[43m\u001b[49m\u001b[43m)\u001b[49m\n\u001b[1;32m    279\u001b[0m \u001b[38;5;28;01mif\u001b[39;00m \u001b[38;5;129;01mnot\u001b[39;00m should_accumulate:\n\u001b[1;32m    280\u001b[0m     \u001b[38;5;28mself\u001b[39m\u001b[38;5;241m.\u001b[39moptim_progress\u001b[38;5;241m.\u001b[39moptimizer\u001b[38;5;241m.\u001b[39mstep\u001b[38;5;241m.\u001b[39mincrement_completed()\n\nFile \u001b[0;32m~/envs/surya_ws/lib/python3.12/site-packages/lightning/pytorch/trainer/call.py:177\u001b[0m, in \u001b[0;36m_call_lightning_module_hook\u001b[0;34m(trainer, hook_name, pl_module, *args, **kwargs)\u001b[0m\n\u001b[1;32m    174\u001b[0m pl_module\u001b[38;5;241m.\u001b[39m_current_fx_name \u001b[38;5;241m=\u001b[39m hook_name\n\u001b[1;32m    176\u001b[0m \u001b[38;5;28;01mwith\u001b[39;00m trainer\u001b[38;5;241m.\u001b[39mprofiler\u001b[38;5;241m.\u001b[39mprofile(\u001b[38;5;124mf\u001b[39m\u001b[38;5;124m\"\u001b[39m\u001b[38;5;124m[LightningModule]\u001b[39m\u001b[38;5;132;01m{\u001b[39;00mpl_module\u001b[38;5;241m.\u001b[39m\u001b[38;5;18m__class__\u001b[39m\u001b[38;5;241m.\u001b[39m\u001b[38;5;18m__name__\u001b[39m\u001b[38;5;132;01m}\u001b[39;00m\u001b[38;5;124m.\u001b[39m\u001b[38;5;132;01m{\u001b[39;00mhook_name\u001b[38;5;132;01m}\u001b[39;00m\u001b[38;5;124m\"\u001b[3\n######################################################################\n### CELL 45 markdown exec_count= None\n-------------------- SOURCE --------------------\n## Conclusion\n\nWith this we have now integrated our dataset, dataloaders, metrics, and DS into an end-2-end training loop and we are ready to experiment!",
            "kind": "execute"
          },
          {
            "raw_output": "1\t\"\"\"\n2\tDataset and DataLoader construction shared by every Surya downstream app.\n3\t\n4\t``HelioNetCDFDataset`` takes ~20 constructor arguments, all of which come straight from\n5\tthe ``data:`` and ``training:`` sections of the config. Spelling that block out at every\n6\tentry point means the same 20 lines get copied into every notebook and every training\n7\tscript, and they drift: one copy forgets ``phase=\"val\"``, another hardcodes a flag the\n8\tYAML was supposed to control.\n9\t\n10\tThese builders own that block once. A downstream app supplies its dataset subclass and\n11\twhatever task-specific keyword arguments that subclass adds::\n12\t\n13\t    train_loader, val_loader = build_helio_dataloaders(\n14\t        cfg,\n15\t        FlareDSDataset,\n16\t        ds_flare_index_path=cfg.data.flare_index_path,\n17\t        label_transform=my_label_transform,\n18\t    )\n19\t\"\"\"\n20\t\n21\tfrom __future__ import annotations\n22\t\n23\timport random\n24\tfrom functools import partial\n25\tfrom typing import Any, Tuple, Type\n26\t\n27\timport numpy as np\n28\timport torch\n29\tfrom torch.utils.data import DataLoader, Dataset\n30\t\n31\tfrom workshop_infrastructure.utils import build_scalers\n32\t\n33\t\n34\tdef _seed_worker(worker_id: int, base_seed: int) -> None:\n35\t    \"\"\"Seed every RNG a DataLoader worker might draw from.\n36\t\n37\t    Seeding torch alone is not enough: ``RandomChannelMaskerTransform`` in\n38\t    ``workshop_infrastructure/datasets/helio.py`` draws from Python's ``random``\n39\t    (``random.sample`` / ``random.random``), and downstream datasets commonly use NumPy.\n40\t\n41\t    Supplying this deliberately displaces Lightning's auto-injected\n42\t    ``pl_worker_init_function``, which derives worker seeds from ``torch.initial_seed()``\n43\t    \u2014 i.e. from the ambient global RNG state, which is exactly the coupling we are\n44\t    removing here.\n45\t    \"\"\"\n46\t    seed = (base_seed + worker_id) % (2 ** 32)\n47\t    random.seed(seed)\n48\t    np.random.seed(seed)\n49\t    torch.manual_seed(seed)\n50\t\n51\t\n52\tdef _base_dataset_kwargs(cfg, scalers) -> dict:\n53\t    \"\"\"Map a TrainingConfig onto the HelioNetCDFDataset constructor arguments.\n54\t\n55\t    This is the single place where config field names meet dataset parameter names.\n56\t    \"\"\"\n57\t    return dict(\n58\t        # Temporal sampling\n59\t        time_delta_input_minutes=cfg.data.time_delta_input_minutes,\n60\t        time_delta_target_minutes=cfg.data.time_delta_target_minutes,\n61\t        n_input_timestamps=cfg.model.time_embedding.time_dim,\n62\t        rollout_steps=cfg.rollout_steps,\n63\t        # Channels and normalization\n64\t        channels=cfg.data.channels,\n65\t        scalers=scalers,\n66\t        # Augmentation\n67\t        drop_hmi_probability=cfg.drop_hmi_probability,\n68\t        use_latitude_in_learned_flow=cfg.use_latitude_in_learned_flow,\n69\t        # Storage: local root, and how s3:// paths in the index are read\n70\t        sdo_data_root_path=cfg.data.sdo_data_root_path,\n71\t        s3_mode=cfg.data.s3_mode,\n72\t        s3_storage_options={\"anon\": cfg.data.s3_anon},\n73\t        s3_cache_dir=cfg.data.s3_cache_dir,\n74\t        s3_boto3_max_concurrency=cfg.data.s3_boto3_max_concurrency,\n75\t        s3_boto3_part_size_mb=cfg.data.s3_boto3_part_size_mb,\n76\t    )\n77\t\n78\t\n79\tdef build_helio_datasets(\n80\t    cfg,\n81\t    dataset_cls: Type[Dataset],\n82\t    scalers: Any = None,\n83\t    **task_kwargs,\n84\t) -> Tuple[Dataset, Dataset]:\n85\t    \"\"\"Build the train and validation datasets described by ``cfg``.\n86\t\n87\t    Args:\n88\t        cfg: A ``TrainingConfig`` from ``load_config()``.\n89\t        dataset_cls: ``HelioNetCDFDataset`` or a subclass of it.\n90\t        scalers: Normalization statistics. Built from ``cfg.data.scalers_path`` if omitted;\n91\t            pass an existing dict to avoid re-reading the YAML.\n92\t        **task_kwargs: Extra keyword arguments forwarded to ``dataset_cls`` \u2014 the\n93\t            task-specific parameters your subclass adds.\n94\t\n95\t    Returns:\n96\t        ``(train_dataset, val_dataset)``. They differ only in the index they read and in\n97\t        ``phase``: the validation set uses ``phase=\"val\"``, which disables the random\n98\t        channel masking and vertical flips that are applied during training.\n99\t    \"\"\"\n100\t    if scalers is None:\n101\t        scalers = build_scalers(info=cfg.data.scalers_path)\n102\t\n103\t    common = {**_base_dataset_kwargs(cfg, scalers), **task_kwargs}\n104\t\n105\t    train_dataset = dataset_cls(index_path=cfg.data.train_data_path, phase=\"train\", **common)\n106\t    val_dataset = dataset_cls(index_path=cfg.data.valid_data_path, phase=\"val\", **common)\n107\t    return train_dataset, val_dataset\n108\t\n109\t\n110\tdef build_helio_dataloaders(\n111\t    cfg,\n112\t    dataset_cls: Type[Dataset],\n113\t    scalers: Any = None,\n114\t    num_workers: int | None = None,\n115\t    seed: int | None = None,\n116\t    **task_kwargs,\n117\t) -> Tuple[DataLoader, DataLoader]:\n118\t    \"\"\"Build the train and validation DataLoaders described by ``cfg``.\n119\t\n120\t    Args:\n121\t        cfg: A ``TrainingConfig`` from ``load_config()``.\n122\t        dataset_cls: ``HelioNetCDFDataset`` or a subclass of it.\n123\t        scalers: Normalization statistics; built from the config if omitted.\n124\t        num_workers: Override for ``cfg.num_workers`` (useful in notebooks, where fewer\n125\t            workers start faster).\n126\t        seed: Seed for the shuffle order and the per-worker RNGs. Defaults to ``cfg.seed``.\n127\t            Pinning it explicitly is what makes the epoch order depend only on the config:\n128\t            a bare ``shuffle=True`` seeds its sampler from whatever the global torch RNG\n129\t            state happens to be when the iterator is created, so anything that consumes\n130\t            RNG earlier in the program silently reshuffles the data.\n131\t        **task_kwargs: Extra keyword arguments forwarded to ``dataset_cls``.\n132\t\n133\t    Returns:\n134\t        ``(train_loader, val_loader)``. Only the training loader shuffles.\n135\t    \"\"\"\n136\t    train_dataset, val_dataset = build_helio_datasets(\n137\t        cfg, dataset_cls, scalers=scalers, **task_kwargs\n138\t    )\n139\t\n140\t    workers = cfg.num_workers if num_workers is None else num_workers\n141\t    base_seed = cfg.seed if seed is None else seed\n142\t\n143\t    loader_kwargs = dict(\n144\t        batch_size=cfg.batch_size,\n145\t        num_workers=workers,\n146\t        pin_memory=True,\n147\t        drop_last=True,\n148\t    )\n149\t    if workers > 0:\n150\t        # \"spawn\": the dataset holds an s3fs/boto3 handle that does not survive fork.\n151\t        # Both of these are rejected outright when num_workers == 0.\n152\t        loader_kwargs[\"multiprocessing_context\"] = \"spawn\"\n153\t        loader_kwargs[\"persistent_workers\"] = True\n154\t        loader_kwargs[\"worker_init_fn\"] = partial(_seed_worker, base_seed=base_seed)\n155\t\n156\t    # An explicit generator makes the shuffle a function of the seed alone, rather than\n157\t    # of the global RNG state at the moment the iterator happens to be created.\n158\t    shuffle_generator = torch.Generator()\n159\t    shuffle_generator.manual_seed(base_seed)\n160\t\n161\t    train_loader = DataLoader(\n162\t        train_dataset, shuffle=True, generator=shuffle_generator, **loader_kwargs\n163\t    )\n164\t    # No generator for validation: it is not shuffled, so there is nothing to seed.\n165\t    val_loader = DataLoader(val_dataset, shuffle=False, **loader_kwargs)\n166\t    return train_loader, val_loader\n167\t",
            "tool_call_id": "toolu_bdrk_01JcdhLrcHv9r1kMoQ77uMjz",
