            "raw_output": "303:def apply_peft_lora(\n304-    model: torch.nn.Module,\n305-    lora_config: LoraAdapterConfig,\n306-) -> torch.nn.Module:\n307-    \"\"\"\n308-    Applies PEFT LoRA adapters to a model.\n309-\n310-    Adapters go on the modules named by ``lora_config.target_modules``.  Every\n311-    fine-tuning head module (see :func:`discover_head_modules`) is passed to\n312-    PEFT as ``modules_to_save``, so it stays **trainable** -- without this the\n313-    head is frozen at its random initialisation and LoRA fits adapters to a\n314-    random readout.\n315-\n316-    Args:\n317-        model: The model to apply LoRA to.\n318-        lora_config: A LoraAdapterConfig instance (from workshop_infrastructure.configs).\n319-\n320-    Returns:\n321-        Model with PEFT LoRA adapters applied.\n322-    \"\"\"\n323-    modules_to_save = discover_head_modules(model)\n324-\n325-    print(\n326-        f\"Applying PEFT LoRA: r={lora_config.r}, alpha={lora_config.lora_alpha}, \"\n327-        f\"dropout={lora_config.lora_dropout}, modules={lora_config.target_modules}\"\n328-    )\n329-\n330-    from peft import LoraConfig, get_peft_model\n331-    peft_config = LoraConfig(\n332-        r=lora_config.r,\n333-        lora_alpha=lora_config.lora_alpha,\n334-        target_modules=lora_config.target_modules,\n335-        lora_dropout=lora_config.lora_dropout,\n336-        bias=lora_config.bias,\n337-        modules_to_save=modules_to_save,\n338-    )\n339-\n340-    model = get_peft_model(model, peft_config)\n341-\n342-    # Show exactly what is being trained, so a misconfigured run is visible\n343-    # in the log instead of only in the loss curve.\n344-    adapted = sorted(\n345-        {\n346-            name.split(\".lora_A\")[0].replace(\"base_model.model.\", \"\")\n347-            for name, _ in model.named_parameters()\n348-            if \".lora_A\" in name\n349-        }\n350-    )\n351-    print(f\"[LoRA] Adapted modules ({len(adapted)}):\")\n352-    for name in adapted:\n353-        print(f\"[LoRA]   {name}\")\n354-    print(f\"[LoRA] Trainable head modules (modules_to_save): {modules_to_save}\")\n355-\n356-    # Defensive: current PEFT excludes modules_to_save from adapter injection.\n357-    # If that ever changes, a head module would get both, so fail loudly.\n358-    head_adapted = [n for n in adapted if n.split(\".\")[0].startswith(HEAD_PREFIX)]\n359-    if head_adapted:\n360-        raise RuntimeError(\n361-            \"PEFT applied LoRA adapters to fine-tuning head modules, which \"\n362-            f\"should be fully trainable instead: {head_adapted}. \"\n363-            \"Narrow lora_config.target_modules so it cannot match head layers.\"\n364-        )\n365-\n366-    # Log the number of trainable parameters\n367-    trainable_params = 0\n368-    all_param = 0\n369-    for _, param in model.named_parameters():\n370-        all_param += param.numel()\n371-        if param.requires_grad:\n372-            trainable_params += param.numel()\n373-\n374-    print(\n375-        f\"trainable params: {trainable_params:,} || \"\n376-        f\"all params: {all_param:,} || \"\n377-        f\"trainable%: {100 * trainable_params / all_param:.2f}%\"\n378-    )\n379-\n380-    return model\n381-\n382-\n383-def load_pretrained_weights(model: torch.nn.Module, pretrained_path: Optional[str]) -> None:",
