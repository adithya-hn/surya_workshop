p_infrastructure.models.finetune_models import HelioSpectformer2D def build(checkpoint_head): model = HelioSpectformer2D( img_size=IMG_SIZE, patch_size=PATCH_SIZE, in_chans=IN_CHANS, embed_dim=EMBED_DIM, time_embedding={\"type\": \"linear\", \"time_dim\": 1}, depth=DEPTH, n_spectral_blocks=N_SPECTRAL_BLOCKS, num_heads=2, mlp_ratio=4, drop_rate=0.0, window_size=2, dp_rank=2, dtype=torch.float32, ft_out_chans=1, ft_checkpoint_head=checkpoint_head, ) return apply_peft_lora(model, LoraAdapterConfig()) torch.manual_seed(0) batch = make_batch() grads = {} for label, flag in ((\"plain\", False), (\"checkpointed\", True)): model = build(flag) model.train() model(batch).float().square().mean().backward() grads[label] = { n: p.grad for n, p in model.named_parameters() if p.requires_grad } assert all(g is not None for g in grads[label].values()), ( f\"{label}: some trainable parameter received no gradient\" ) assert grads[\"plain\"].keys() == grads[\"checkpointed\"].keys() PYEOF python -m pytest tests/ -q 2>&1 | tail -4",
