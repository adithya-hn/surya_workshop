            "tool_call_id": "toolu_bdrk_01EqnrmQANonUPwHURBR7f3P",
            "kind": "execute",
            "title": "cd surya_workshop && python - <<'PYEOF' from pathlib import Path # --- YAML: the 1.4-2.2 GiB claim is measurably wrong --- p = Path(\"downstream_apps/sf_triggers/configs/config_script.yaml\") s = p.read_text() old = ''' # 0.0 rather than the usual 0.1 on purpose. PEFT builds nn.Dropout when p > 0 and # nn.Identity when p == 0, and every dropout allocates an output tensor plus a bool # mask the same shape as its input. On fc2 that input is (1, 65536, 5120), so p > 0 # costs 1.4-2.2 GiB of peak GPU memory across the adapted layers. At r=2 on a handful # of samples the regularization is not worth that. lora_dropout: 0.0''' new = ''' # 0.0 rather than the usual 0.1. PEFT builds nn.Dropout when p > 0 and nn.Identity when # p == 0, so p > 0 allocates an output tensor plus a bool mask the same shape as its # input -- on fc2 that input is (1, 65536, 5120). Measured, though, the saving is small # (~0.5% of peak): under gradient checkpointing those tensors are transient and do not # coexist with the actual peak. Kept at 0.0 because it is free and because at r=2 on a # handful of samples the regularization is not doing useful work -- not because it is a # significant memory lever. The real levers are training.precision below and the two # helper calls in build_model(). lora_dropout: 0.0''' assert s.count(old) == 1 p.write_text(s.replace(old, new)) print(\"yaml comment corrected\") # --- notebook: replace the unmeasured \"roughly 5 GiB\" --- import json np_ = Path(\"downstream_apps/sf_triggers/2_finetune_template_1D.ipynb\") nb = json.loads(np_.read_text()) c = nb[\"cells\"][20] src = \"\".join(c[\"source\"]) old = \"The same cell applies two precision adjustments, and they are worth understanding rather than copying, because between them they are worth roughly 5 GiB on a 15 GiB card.\" new = \"The same cell applies two precision adjustments, and they are worth understanding rather than copying. Measured on this T4 at reduced resolution they cut peak memory by 29%; at the full 4096\u00d74096 the saving is larger, because the biggest term scales with the token count.\" assert src.count(old) == 1 src = src.replace(old, new) c[\"source\"] = [l + \"\\n\" for l in src.split(\"\\n\")[:-1]] + ([src.split(\"\\n\")[-1]] if src.split(\"\\n\")[-1] else []) np_.write_text(json.dumps(nb, indent=1, ensure_ascii=False) + \"\\n\") print(\"notebook claim corrected\") PYEOF",
            "status": "completed",
            "raw_input": {
              "description": "Correct the overstated lora_dropout and GiB claims",
              "command": "cd /home/jovyan/adi_wdir/surya_workshop && /home/jovyan/envs/surya_ws/bin/python - <<'PYEOF'\nfrom pathlib import Path\n\n# --- YAML: the 1.4-2.2 GiB claim is measurably wrong ---\np = Path(\"downstream_apps/sf_triggers/configs/config_script.yaml\")\ns = p.read_text()\nold = '''    # 0.0 rather than the usual 0.1 on purpose. PEFT builds nn.Dropout when p > 0 and\n    # nn.Identity when p == 0, and every dropout allocates an output tensor plus a bool\n    # mask the same shape as its input. On fc2 that input is (1, 65536, 5120), so p > 0\n    # costs 1.4-2.2 GiB of peak GPU memory across the adapted layers. At r=2 on a handful\n    # of samples the regularization is not worth that.\n    lora_dropout: 0.0'''\nnew = '''    # 0.0 rather than the usual 0.1. PEFT builds nn.Dropout when p > 0 and nn.Identity when\n    # p == 0, so p > 0 allocates an output tensor plus a bool mask the same shape as its\n    # input -- on fc2 that input is (1, 65536, 5120). Measured, though, the saving is small\n    # (~0.5% of peak): under gradient checkpointing those tensors are transient and do not\n    # coexist with the actual peak. Kept at 0.0 because it is free and because at r=2 on a\n    # handful of samples the regularization is not doing useful work -- not because it is a\n    # significant memory lever. The real levers are training.precision below and the two\n    # helper calls in build_model().\n    lora_dropout: 0.0'''\nassert s.count(old) == 1\np.write_text(s.replace(old, new))\nprint(\"yaml comment corrected\")\n\n# --- notebook: replace the unmeasured \"roughly 5 GiB\" ---\nimport json\nnp_ = Path(\"downstream_apps/sf_triggers/2_finetune_template_1D.ipynb\")\nnb = json.loads(np_.read_text())\nc = nb[\"cells\"][20]\nsrc = \"\".join(c[\"source\"])\nold = \"The same cell applies two precision adjustments, and they are worth understanding rather than copying, because between them they are worth roughly 5 GiB on a 15 GiB card.\"\nnew = \"The same cell applies two precision adjustments, and they are worth understanding rather than copying. Measured on this T4 at reduced resolution they cut peak memory by 29%; at the full 4096\u00d74096 the saving is larger, because the biggest term scales with the token count.\"\nassert src.count(old) == 1\nsrc = src.replace(old, new)\nc[\"source\"] = [l + \"\\n\" for l in src.split(\"\\n\")[:-1]] + ([src.split(\"\\n\")[-1]] if src.split(\"\\n\")[-1] else [])\nnp_.write_text(json.dumps(nb, indent=1, ensure_ascii=False) + \"\\n\")\nprint(\"notebook claim corrected\")\nPYEOF"
