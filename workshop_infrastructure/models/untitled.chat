kshop_infrastructure.utils import ( HEAD_PREFIX,\"\"\" new_imp = \"\"\"from workshop_infrastructure.utils import ( _NORM_LAYERS, HEAD_PREFIX,\"\"\" assert s.count(old_imp) == 1 s = s.replace(old_imp, new_imp) p.write_text(s) print(\"ok\") PYEOF python -m pytest tests/ -q 2>&1 | tail -5"
