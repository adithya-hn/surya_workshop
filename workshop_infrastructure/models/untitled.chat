              "command": "cd /home/jovyan/adi_wdir/surya_workshop && cat > /tmp/tpl_yaml.py <<'PYEOF'\nfrom pathlib import Path\np = Path(\"downstream_apps/template/configs/config_script.yaml\")\ns = p.read_text()\nold = '''  dtype: float32        # Options: float32 | bfloat16\n'''\nnew = '''  dtype: float32        # Options: float32 | bfloat16. NOTE: inert -- the backbone accepts\n                        # this and drops it. `precision` below is the real control.\n\n  # Mixed-precision mode, passed to lightning.Trainer. Both a memory and a speed lever, and\n  # the right value is hardware dependent:\n  #   16-mixed    fp16 autocast + fp32 master weights + GradScaler. Correct for T4/V100\n  #               (SM70/75), which have native fp16 tensor cores but EMULATE bf16. Measured\n  #               on a T4 at a 16384x1280x5120 GEMM: 9.3 ms fp16, 56.8 ms fp32, 90.1 ms\n  #               bf16 -- bf16 there is slower than plain fp32.\n  #   bf16-mixed  Prefer on A100/H100 (SM80+): native, and no GradScaler needed.\n  #   32-true     No autocast. Fine for the 1D head; will not fit a 2D head at 4096x4096.\n  #   bf16-true   Do not use. Lightning casts the module before building the optimizer, so\n  #               Adam's second moment lives in bf16 and stops accumulating.\n  precision: 16-mixed\n\n  # Effective batch = batch_size * accumulate_grad_batches, at the memory cost of\n  # batch_size alone. The lever to reach for when batch_size is pinned at 1 by memory.\n  accumulate_grad_batches: 1\n'''\nassert s.count(old) == 1\np.write_text(s.replace(old, new))\nprint(\"ok\")\nPYEOF\n/home/jovyan/envs/surya_ws/bin/python /tmp/tpl_yaml.py && /home/jovyan/envs/surya_ws/bin/python -c \"\nimport sys; sys.path.insert(0, '.')\nfrom downstream_apps.sf_triggers.configs import load_flare_config\nc = load_flare_config('downstream_apps/sf_triggers/configs/config_script.yaml')\nprint('sf_triggers  precision:', c.precision, '| agb:', c.accumulate_grad_batches, '| lora_dropout:', c.model.lora_config.lora_dropout)\nfrom downstream_apps.template.configs import load_flare_config as lt\nt = lt('downstream_apps/template/configs/config_script.yaml')\nprint('template     precision:', t.precision, '| agb:', t.accumulate_grad_batches)\n\" 2>&1 | grep -v Warning",
