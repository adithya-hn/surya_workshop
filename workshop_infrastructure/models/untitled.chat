            "title": "cd surya_workshop && cat > real_probe.py <<'PYEOF' \"\"\"Full-resolution probe at the real sf_triggers config, before vs after. Weights are randomly initialized rather than loaded from surya.366m.v1.pt: shapes and dtypes are identical, so peak memory is unaffected, and this avoids needing the checkpoint. The batch is synthetic for the same reason -- (1,13,1,4096,4096) fp32 is what the loader emits. \"\"\" import gc, io, contextlib, sys, traceback sys.path.insert(0, \".\") import torch from downstream_apps.sf_triggers.configs import load_flare_config from workshop_infrastructure.models.finetune_models import HelioSpectformer2D from workshop_infrastructure.utils import ( apply_peft_lora, cast_frozen_to, disable_peft_input_dtype_cast, ) cfg = load_flare_config(\"downstream_apps/sf_triggers/configs/config_script.yaml\") TOTAL = torch.cuda.get_device_properties(0).total_memory / 2**30 print(f\"GPU: {torch.cuda.get_device_name(0)}, {TOTAL:.2f} GiB total, \" f\"free now {torch.cuda.mem_get_info(0)[0]/2**30:.2f} GiB\") print(f\"config: img_size={cfg.model.img_size} patch={cfg.model.patch_size} \" f\"embed={cfg.model.embed_dim} depth={cfg.model.depth} \" f\"checkpoint_layers={len(cfg.model.checkpoint_layers)} batch={cfg.batch_size}\\n\") def run(label, precision, lora_dropout, disable_cast, cast_half): gc.collect(); torch.cuda.empty_cache(); torch.cuda.reset_peak_memory_stats() autocast_dtype = torch.bfloat16 if precision.startswith(\"bf16\") else torch.float16 try: with contextlib.redirect_stdout(io.StringIO()): lora = type(cfg.model.lora_config)( r=cfg.model.lora_config.r, lora_alpha=cfg.model.lora_config.lora_alpha, target_modules=list(cfg.model.lora_config.target_modules), lora_dropout=lora_dropout, bias=cfg.model.lora_config.bias, ) model = HelioSpectformer2D.from_config(cfg.model, ft_out_chans=1) model = apply_peft_lora(model, lora) if disable_cast: disable_peft_input_dtype_cast(model) if cast_half: cast_frozen_to(model, autocast_dtype) model = model.to(\"cuda\").train() static = torch.cuda.memory_allocated() / 2**30 batch = { \"ts\": torch.randn(cfg.batch_size, 13, 1, 4096, 4096, device=\"cuda\"), \"time_delta_input\": torch.zeros(cfg.batch_size, 1, device=\"cuda\"), \"forecast\": torch.randn(cfg.batch_size, 1, 4096, 4096, device=\"cuda\"), } opt = torch.optim.Adam([p for p in model.parameters() if p.requires_grad], lr=1e-4) with torch.autocast(\"cuda\", dtype=autocast_dtype): out = model(batch) loss = torch.nn.functional.mse_loss( out.reshape(-1), batch[\"forecast\"].reshape(-1).float()) loss.backward(); opt.step() peak = torch.cuda.max_memory_allocated() / 2**30 resv = torch.cuda.max_memory_reserved() / 2**30 print(f\"{label}\\n static {static:5.2f} | peak {peak:5.2f} | reserved {resv:5.2f} \" f\"| frag {resv-peak:4.2f} | headroom {TOTAL-resv:5.2f} GiB -> RAN\") del out, loss, batch, opt, model except torch.OutOfMemoryError as e: peak = torch.cuda.max_memory_allocated() / 2**30 first = str(e).split(\".\")[0] print(f\"{label}\\n peak before failure {peak:5.2f} GiB -> OOM: {first}\") except Exception: traceback.print_exc() finally: gc.collect(); torch.cuda.empty_cache() run(\"(a) BEFORE: bf16-mixed, PEFT cast ON, lora_dropout 0.1\", \"bf16-mixed\", 0.1, disable_cast=False, cast_half=False) run(\"(b) AFTER: 16-mixed, cast OFF, dropout 0.0, cast_frozen_to(fp16)\", cfg.precision, cfg.model.lora_config.lora_dropout, disable_cast=True, cast_half=True) PYEOF python real_probe.py 2>&1 | grep -viE \"futurewarning|warnings.warn|Warning: PYTORCH\"",
            "raw_input": {
              "description": "Full-resolution before/after probe on the T4",
              "command": "cd /home/jovyan/adi_wdir/surya_workshop && cat > /tmp/real_probe.py <<'PYEOF'\n\"\"\"Full-resolution probe at the real sf_triggers config, before vs after.\n\nWeights are randomly initialized rather than loaded from surya.366m.v1.pt: shapes and dtypes\nare identical, so peak memory is unaffected, and this avoids needing the checkpoint. The\nbatch is synthetic for the same reason -- (1,13,1,4096,4096) fp32 is what the loader emits.\n\"\"\"\nimport gc, io, contextlib, sys, traceback\nsys.path.insert(0, \".\")\nimport torch\nfrom downstream_apps.sf_triggers.configs import load_flare_config\nfrom workshop_infrastructure.models.finetune_models import HelioSpectformer2D\nfrom workshop_infrastructure.utils import (\n    apply_peft_lora, cast_frozen_to, disable_peft_input_dtype_cast,\n)\n\ncfg = load_flare_config(\"downstream_apps/sf_triggers/configs/config_script.yaml\")\nTOTAL = torch.cuda.get_device_properties(0).total_memory / 2**30\nprint(f\"GPU: {torch.cuda.get_device_name(0)}, {TOTAL:.2f} GiB total, \"\n      f\"free now {torch.cuda.mem_get_info(0)[0]/2**30:.2f} GiB\")\nprint(f\"config: img_size={cfg.model.img_size} patch={cfg.model.patch_size} \"\n      f\"embed={cfg.model.embed_dim} depth={cfg.model.depth} \"\n      f\"checkpoint_layers={len(cfg.model.checkpoint_layers)} batch={cfg.batch_size}\\n\")\n\n\ndef run(label, precision, lora_dropout, disable_cast, cast_half):\n    gc.collect(); torch.cuda.empty_cache(); torch.cuda.reset_peak_memory_stats()\n    autocast_dtype = torch.bfloat16 if precision.startswith(\"bf16\") else torch.float16\n    try:\n        with contextlib.redirect_stdout(io.StringIO()):\n            lora = type(cfg.model.lora_config)(\n                r=cfg.model.lora_config.r,\n                lora_alpha=cfg.model.lora_config.lora_alpha,\n                target_modules=list(cfg.model.lora_config.target_modules),\n                lora_dropout=lora_dropout,\n                bias=cfg.model.lora_config.bias,\n            )\n            model = HelioSpectformer2D.from_config(cfg.model, ft_out_chans=1)\n            model = apply_peft_lora(model, lora)\n            if disable_cast:\n                disable_peft_input_dtype_cast(model)\n            if cast_half:\n                cast_frozen_to(model, autocast_dtype)\n            model = model.to(\"cuda\").train()\n\n        static = torch.cuda.memory_allocated() / 2**30\n        batch = {\n            \"ts\": torch.randn(cfg.batch_size, 13, 1, 4096, 4096, device=\"cuda\"),\n            \"time_delta_input\": torch.zeros(cfg.batch_size, 1, device=\"cuda\"),\n            \"forecast\": torch.randn(cfg.batch_size, 1, 4096, 4096, device=\"cuda\"),\n        }\n        opt = torch.optim.Adam([p for p in model.parameters() if p.requires_grad], lr=1e-4)\n        with torch.autocast(\"cuda\", dtype=autocast_dtype):\n            out = model(batch)\n            loss = torch.nn.functional.mse_loss(\n                out.reshape(-1), batch[\"forecast\"].reshape(-1).float())\n        loss.backward(); opt.step()\n        peak = torch.cuda.max_memory_allocated() / 2**30\n        resv = torch.cuda.max_memory_reserved() / 2**30\n        print(f\"{label}\\n    static {static:5.2f} | peak {peak:5.2f} | reserved {resv:5.2f} \"\n              f\"| frag {resv-peak:4.2f} | headroom {TOTAL-resv:5.2f} GiB  -> RAN\")\n        del out, loss, batch, opt, model\n    except torch.OutOfMemoryError as e:\n        peak = torch.cuda.max_memory_allocated() / 2**30\n        first = str(e).split(\".\")[0]\n        print(f\"{label}\\n    peak before failure {peak:5.2f} GiB  -> OOM: {first}\")\n    except Exception:\n        traceback.print_exc()\n    finally:\n        gc.collect(); torch.cuda.empty_cache()\n\n\nrun(\"(a) BEFORE: bf16-mixed, PEFT cast ON, lora_dropout 0.1\",\n    \"bf16-mixed\", 0.1, disable_cast=False, cast_half=False)\nrun(\"(b) AFTER:  16-mixed, cast OFF, dropout 0.0, cast_frozen_to(fp16)\",\n    cfg.precision, cfg.model.lora_config.lora_dropout, disable_cast=True, cast_half=True)\nPYEOF\n/home/jovyan/envs/surya_ws/bin/python /tmp/real_probe.py 2>&1 | grep -viE \"futurewarning|warnings.warn|Warning: PYTORCH\""
            },
            "raw_output": "GPU: Tesla T4, 14.74 GiB total, free now 14.64 GiB\nconfig: img_size=4096 patch=16 embed=1280 depth=10 checkpoint_layers=10 batch=1\n\n(a) BEFORE: bf16-mixed, PEFT cast ON, lora_dropout 0.1\n    peak before failure 12.29 GiB  -> OOM: CUDA out of memory\n(b) AFTER:  16-mixed, cast OFF, dropout 0.0, cast_frozen_to(fp16)\n    static  0.85 | peak 11.44 | reserved 13.64 | frag 2.20 | headroom  1.10 GiB  -> RAN\nShell cwd was reset to /home/jovyan/adi_wdir/surya_workshop/workshop_infrastructure/models",
