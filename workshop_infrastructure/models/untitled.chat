              "command": "L=/home/jovyan/envs/surya_ws/lib/python3.12/site-packages/lightning/pytorch; awk 'NR>=141 && NR<=170 {printf \"%5d\\t%s\\n\", NR, $0}' $L/strategies/strategy.py",
