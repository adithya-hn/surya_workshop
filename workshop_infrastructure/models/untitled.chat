            "raw_input": {
              "file_path": "/home/jovyan/adi_wdir/surya_workshop/workshop_infrastructure/models/helio_spectformer.py"
            },
            "raw_output": "1\timport torch\n2\tfrom einops import rearrange\n3\tfrom itertools import chain\n4\tfrom torch import nn\n5\tfrom torch.utils.checkpoint import checkpoint\n6\t\n7\timport numpy as np\n8\t\n9\tfrom .spectformer import SpectFormer, BlockSpectralGating, BlockAttention\n10\tfrom .embedding import (\n11\t    LinearEmbedding,\n12\t    PatchEmbed3D,\n13\t    PerceiverChannelEmbedding,\n14\t    LinearDecoder,\n15\t    PerceiverDecoder,\n16\t)\n17\tfrom .flow import HelioFlowModel\n18\t\n19\t\n20\tclass HelioSpectFormer(nn.Module):\n21\t    \"\"\"\n22\t    A note on the ensemble capability:\n23\t        Ensembles of size E are generated by setting `ensemble=E`. In this case, the forward\n24\t        pass generates ensemble members after tokenization by increasing the batch dimension\n25\t        B to B x E. Noise is injected in the `self.backbone` Specformer blocks. After the\n26\t        backbone, ensemble members ride along implicitly in the batch dimension. (This is\n27\t        mainly through the `self.unembed` pass.) An explicit ensemble dimension is only\n28\t        generated at the end.\n29\t    \"\"\"\n30\t\n31\t    def __init__(\n32\t        self,\n33\t        img_size: int,\n34\t        patch_size: int,\n35\t        in_chans: int,\n36\t        embed_dim: int,\n37\t        time_embedding: dict,\n38\t        depth: int,\n39\t        n_spectral_blocks: int,\n40\t        num_heads: int,\n41\t        mlp_ratio: float,\n42\t        drop_rate: float,\n43\t        window_size: int,\n44\t        dp_rank: int,\n45\t        learned_flow: bool = False,\n46\t        use_latitude_in_learned_flow: bool = False,\n47\t        init_weights: bool = False,\n48\t        checkpoint_layers: list[int] | None = None,\n49\t        rpe: bool = False,\n50\t        ensemble: int | None = None,\n51\t        finetune: bool = True,\n52\t        nglo: int = 0,\n53\t        dtype: torch.dtype | None = None,\n54\t    ) -> None:\n55\t        \"\"\"\n56\t        Args:\n57\t            img_size: input image size\n58\t            patch_size: patch size\n59\t            in_chans: number of iput channels\n60\t            embed_dim: embeddin dimension\n61\t            time_embedding: dictionary to configure temporal embedding:\n62\t                `type` (str, required): indicates embedding type. `linear`, `perceiver`.\n63\t                `time_dim` (int): indicates length of time dimension. required for linear embedding.\n64\t                `n_queries` (int): indicates number of perceiver queries. required for perceiver.\n65\t            depth: number of transformer blocks\n66\t            n_spectral_blocks: number of spectral gating blocks\n67\t            num_heads: Number of transformer heads\n68\t            mlp_ratio: MLP ratio for transformer blocks\n69\t            drop_rate: dropout rate\n70\t            window_size: window size for long/short attention\n71\t            dp_rank: dp rank for long/short attention\n72\t            learned_flow: if true, combine learned flow model with spectformer\n73\t            use_latitude_in_learned_flow: use latitudes in learned flow\n74\t            init_weights: use optimized weight initialization\n75\t            checkpoint_layers: indicate which layers to use for checkpointing\n76\t            rpe: Use relative position encoding in Long-Short attention blocks.\n77\t            ensemble: Integer indicating ensemble size or None for deterministic model.\n78\t            finetune: Indicates whether to train from scrach or fine-tune the model. If set to `True`, the final output layers are removed.\n79\t            nglo: Number of (additional) global tokens.\n80\t            dtype: A torch data type. Not used and added only for compatibility with the remainder of the codebase.\n81\t        \"\"\"\n82\t        super().__init__()\n83\t\n84\t        self.learned_flow = learned_flow\n85\t        self.patch_size = patch_size\n86\t        self.embed_dim = embed_dim\n87\t        self.in_chans = in_chans\n88\t        self.time_embedding = time_embedding\n89\t        self.ensemble = ensemble\n90\t        self.finetune = finetune\n91\t        self.nglo = nglo\n92\t\n93\t        if learned_flow:\n94\t            self.learned_flow_model = HelioFlowModel(\n95\t                img_size=(img_size, img_size),\n96\t                use_latitude_in_learned_flow=use_latitude_in_learned_flow,\n97\t            )\n98\t\n99\t        match time_embedding[\"type\"]:\n100\t            case \"linear\":\n101\t                self.time_dim = time_embedding[\"time_dim\"]\n102\t                if learned_flow:\n103\t                    self.time_dim += 1\n104\t                self.embedding = LinearEmbedding(\n105\t                    img_size, patch_size, in_chans, self.time_dim, embed_dim, drop_rate\n106\t                )\n107\t\n108\t                if not self.finetune:\n109\t                    self.unembed = LinearDecoder(\n110\t                        patch_size=patch_size, out_chans=in_chans, embed_dim=embed_dim\n111\t                    )\n112\t            case \"perceiver\":\n113\t                self.embedding = PerceiverChannelEmbedding(\n114\t                    in_chans=in_chans,\n115\t                    img_size=img_size,\n116\t                    patch_size=patch_size,\n117\t                    time_dim=time_embedding[\"time_dim\"],\n118\t                    num_queries=time_embedding[\"n_queries\"],\n119\t                    embed_dim=embed_dim,\n120\t                    drop_rate=drop_rate,\n121\t                )\n122\t                if not self.finetune:\n123\t                    self.unembed = PerceiverDecoder(\n124\t                        embed_dim=embed_dim,\n125\t                        patch_size=patch_size,\n126\t                        out_chans=in_chans,\n127\t                    )\n128\t            case _:\n129\t                raise NotImplementedError(\n130\t                    f'Embedding {time_embedding[\"type\"]} has not been implemented.'\n131\t                )\n132\t\n133\t        if isinstance(depth, list):\n134\t            raise NotImplementedError(\n135\t                \"Multi scale models are no longer supported. Depth should be a single integer.\"\n136\t            )\n137\t        self.backbone = SpectFormer(\n138\t            grid_size=img_size // patch_size,\n139\t            embed_dim=embed_dim,\n140\t            depth=depth,\n141\t            n_spectral_blocks=n_spectral_blocks,\n142\t            num_heads=num_heads,\n143\t            mlp_ratio=mlp_ratio,\n144\t            drop_rate=drop_rate,\n145\t            window_size=window_size,\n146\t            dp_rank=dp_rank,\n147\t            checkpoint_layers=checkpoint_layers,\n148\t            rpe=rpe,\n149\t            ensemble=ensemble,\n150\t            nglo=nglo,\n151\t        )\n152\t\n153\t        if init_weights:\n154\t            self.apply(self._init_weights)\n155\t\n156\t    # @staticmethod\n157\t    # def _checkpoint_wrapper(\n158\t    #    model: nn.Module, data: tuple[Tensor, Tensor | None]\n159\t    # ) -> Tensor:\n160\t    #    return checkpoint(model, data, use_reentrant=False)\n161\t\n162\t    def _init_weights(self, module):\n163\t\n164\t        if self.time_embedding[\"type\"] == \"linear\":\n165\t            # sampling_step * embed_dim = patch_size**2 * in_chans * time_dim\n166\t            sampling_step = int(\n167\t                np.sqrt(\n168\t                    (self.patch_size**2 * self.in_chans * self.time_dim)\n169\t                    / self.embed_dim\n170\t                )\n171\t            )\n172\t        else:\n173\t            sampling_step = int(\n174\t                np.sqrt((self.patch_size**2 * self.in_chans) / self.embed_dim)\n175\t            )\n176\t        if isinstance(module, PatchEmbed3D):\n177\t            torch.nn.init.zeros_(module.proj.weight)\n178\t            c_out = 0\n179\t            w_pool = 1.0 / sampling_step\n180\t            for k in range(self.in_chans * self.time_dim):\n181\t                for i in range(0, self.patch_size, sampling_step):\n182\t                    for j in range(0, self.patch_size, sampling_step):\n183\t                        module.proj.weight.data[\n184\t                            c_out, k, i : i + sampling_step, j : j + sampling_step\n185\t                        ] = w_pool\n186\t                        c_out += 1\n187\t            if module.proj.bias is not None:\n188\t                module.proj.bias.data.zero_()\n189\t        if isinstance(module, BlockSpectralGating):\n190\t            for m in [\n191\t                module.mlp.fc1,\n192\t                module.mlp.fc2,\n193\t            ]:\n194\t                # m.weight.data.normal_(mean=0.0, std=0.01)\n195\t                # torch.nn.init.eye_(m.weight)\n196\t                torch.nn.init.eye_(m.weight)\n197\t                if m.bias is not None:\n198\t                    m.bias.data.zero_()\n199\t        if isinstance(module, BlockAttention):\n200\t            for m in [\n201\t                module.mlp.fc1,\n202\t                module.mlp.fc2,\n203\t            ]:\n204\t                # torch.nn.init.eye_(m.weight)\n205\t                torch.nn.init.zeros_(m.weight)\n206\t                if m.bias is not None:\n207\t                    m.bias.data.zero_()\n208\t            for m in [\n209\t                module.attn.qkv,\n210\t                module.attn.proj,\n211\t                module.attn.to_dynamic_projection,\n212\t            ]:\n213\t                # m.weight.data.normal_(mean=0.0, std=0.01)\n214\t                # torch.nn.init.eye_(m.weight)\n215\t                torch.nn.init.zeros_(m.weight)\n216\t                if m.bias is not None:\n217\t                    m.bias.data.zero_()\n218\t        if isinstance(module, torch.nn.Sequential):\n219\t            if isinstance(module[1], torch.nn.PixelShuffle):\n220\t                # torch.nn.init.eye_(module[0].weight.data[:,:,0,0])\n221\t                torch.nn.init.zeros_(module[0].weight)\n222\t                if self.time_embedding[\"type\"] == \"linear\":\n223\t                    c_out = 0\n224\t                    for k in range(1, self.in_chans + 1):\n225\t                        for i in range(\n226\t                            self.patch_size**2 // (self.patch_size * sampling_step)\n227\t                        ):\n228\t                            for j in range(self.patch_size):\n229\t                                module[0].weight.data[\n230\t                                    c_out : c_out + sampling_step,\n231\t                                    j + (k * self.time_dim - 1) * self.patch_size,\n232\t                                ] = 1.0\n233\t                                c_out += sampling_step\n234\t                else:\n235\t                    c_out = 0\n236\t                    for k in range(2 * self.in_chans):\n237\t                        # l = 0\n238\t                        for l_feat in range(self.backbone.embed_dim):\n239\t                            module[0].weight.data[c_out, l_feat] = 1.0\n240\t                            c_out += 1\n241\t                if module[0].bias is not None:\n242\t                    module[0].bias.data.zero_()\n243\t\n244\t    def forward_with_cls_token(self, batch, cls_token: torch.nn.Parameter) -> torch.Tensor:\n245\t        \"\"\"Run the backbone with a CLS token injected between spectral and attention blocks.\n246\t\n247\t        The CLS token is inserted at the boundary between spectral gating blocks and\n248\t        attention blocks so that it attends over all patch tokens. Only the CLS token\n249\t        output is returned.\n250\t\n251\t        Args:\n252\t            batch: Dictionary with keys ``ts`` (B, C, T, H, W) and ``time_delta_input`` (B, T).\n253\t            cls_token: Learnable CLS token parameter of shape (1, 1, embed_dim).\n254\t\n255\t        Returns:\n256\t            Tensor of shape (B, 1, embed_dim) \u2014 the CLS token after the full forward pass.\n257\t        \"\"\"\n258\t        x = batch[\"ts\"]\n259\t        dt = batch[\"time_delta_input\"]\n260\t        B = x.shape[0]\n261\t\n262\t        if self.learned_flow:\n263\t            y_hat_flow = self.learned_flow_model(batch)\n264\t            if any(param.requires_grad for param in self.learned_flow_model.parameters()):\n265\t                return y_hat_flow\n266\t            else:\n267\t                x = torch.concat((x, y_hat_flow.unsqueeze(2)), dim=2)\n268\t                if self.time_embedding[\"type\"] == \"perceiver\":\n269\t                    dt = torch.cat((dt, batch[\"lead_time_delta\"].reshape(-1, 1)), dim=1)\n270\t\n271\t        tokens = self.embedding(x, dt)\n272\t\n273\t        if self.ensemble:\n274\t            raise NotImplementedError(\n275\t                \"CLS token pooling has not been implemented with ensemble modifications.\"\n276\t            )\n277\t\n278\t        noise = None\n279\t        for i, blk in enumerate(\n280\t            chain(self.backbone.blocks_spectral_gating, self.backbone.blocks_attention)\n281\t        ):\n282\t            if i == self.backbone.n_spectral_blocks:\n283\t                tokens = torch.cat(\n284\t                    (cls_token.expand(B, 1, self.embed_dim), tokens),\n285\t                    dim=1,\n286\t                )\n287\t            tokens = (\n288\t                checkpoint(blk, tokens, noise, use_reentrant=False)\n289\t                if i in self.backbone._checkpoint_layers\n290\t                else blk(tokens, noise)\n291\t            )\n292\t\n293\t        return tokens[:, [0], :]\n294\t\n295\t    def forward(self, batch):\n296\t        \"\"\"\n297\t        Args:\n298\t            batch: Dictionary containing keys `ts` and `time_delta_input`.\n299\t            Their values are tensors with shapes as follows.\n300\t                ts:                B, C, T, H, W\n301\t                time_delta_input:  B, T\n302\t        Returns:\n303\t            Tensor fo shape (B, C, H, W) for deterministic or (B, E, C, H, W) for ensemble forecasts.\n304\t        \"\"\"\n305\t        x = batch[\"ts\"]\n306\t        dt = batch[\"time_delta_input\"]\n307\t        B, C, T, H, W = x.shape\n308\t\n309\t        if self.learned_flow:\n310\t            y_hat_flow = self.learned_flow_model(batch)  # B, C, H, W\n311\t            if any(\n312\t                [param.requires_grad for param in self.learned_flow_model.parameters()]\n313\t            ):\n314\t                return y_hat_flow\n315\t            else:\n316\t                x = torch.concat((x, y_hat_flow.unsqueeze(2)), dim=2)  # B, C, T+1, H, W\n317\t                if self.time_embedding[\"type\"] == \"perceiver\":\n318\t                    dt = torch.cat((dt, batch[\"lead_time_delta\"].reshape(-1, 1)), dim=1)\n319\t\n320\t        # embed the data\n321\t        tokens = self.embedding(x, dt)\n322\t\n323\t        # copy tokens in case of ensemble forecast\n324\t        if self.ensemble:\n325\t            # B L D -> (B E) L D == BE L D\n326\t            tokens = torch.repeat_interleave(tokens, repeats=self.ensemble, dim=0)\n327\t\n328\t        # pass the time series through the encoder\n329\t        tokens = self.backbone(tokens)\n330\t\n331\t        if self.finetune:\n332\t            return tokens\n333\t\n334\t        # Unembed the tokens\n335\t        # BE L D -> BE C H W\n336\t        forecast_hat = self.unembed(tokens)\n337\t\n338\t        assert forecast_hat.shape == (\n339\t            B * self.ensemble if self.ensemble else B,\n340\t            C,\n341\t            H,\n342\t            W,\n343\t        ), f\"forecast_hat has shape {forecast_hat.shape} yet expected {(B*self.ensemble if self.ensemble else B, C, H, W)}.\"\n344\t\n345\t        if self.learned_flow:\n346\t            assert y_hat_flow.shape == (\n347\t                B,\n348\t                C,\n349\t                H,\n350\t                W,\n351\t            ), f\"y_hat_flow has shape {y_hat_flow.shape} yet expected {(B, C, H, W)}.\"\n352\t            if self.ensemble:\n353\t                y_hat_flow = torch.repeat_interleave(\n354\t                    y_hat_flow, repeats=self.ensemble, dim=0\n355\t                )\n356\t            assert y_hat_flow.shape == forecast_hat.shape\n357\t            forecast_hat = forecast_hat + y_hat_flow\n358\t\n359\t        assert forecast_hat.shape == (\n360\t            B * self.ensemble if self.ensemble else B,\n361\t            C,\n362\t            H,\n363\t            W,\n364\t        ), f\"forecast_hat has shape {forecast_hat.shape} yet expected {(B*self.ensemble if self.ensemble else B, C, H, W)}.\"\n365\t\n366\t        if self.ensemble:\n367\t            forecast_hat = rearrange(\n368\t                forecast_hat, \"(B E) C H W -> B E C H W\", B=B, E=self.ensemble\n369\t            )\n370\t\n371\t        return forecast_hat\n372\t",
            "locations": [
              "/home/jovyan/adi_wdir/surya_workshop/workshop_infrastructure/models/helio_spectformer.py"
            ],
            "title": "Read helio_spectformer.py"
          },
          {
            "raw_input": {
              "file_path": "/home/jovyan/adi_wdir/surya_workshop/workshop_infrastructure/configs.py"
            },
            "locations": [
              "/home/jovyan/adi_wdir/surya_workshop/workshop_infrastructure/configs.py"
            ],
            "raw_output": "1\t\"\"\"\n2\tTyped configuration for Surya downstream applications.\n3\t\n4\tEverything a fine-tuning run needs is declared here:\n5\t\n6\t- ``TimeEmbeddingConfig`` / ``LoraAdapterConfig`` / ``ModelConfig`` \u2014 the backbone\n7\t  architecture and fine-tuning head, mirroring the HelioSpectformer constructors.\n8\t- ``DataConfig`` / ``OutputConfig`` / ``TrainingConfig`` \u2014 the parts of a run that every\n9\t  downstream task has: what data to load, where checkpoints go, and the optimizer /\n10\t  logging settings.\n11\t- ``load_config()`` \u2014 the single entry point. Reads the YAML and returns a fully typed\n12\t  ``TrainingConfig``, so downstream code never passes raw dicts around.\n13\t\n14\t**Adding task-specific settings:** subclass ``DataConfig`` in your app and pass the\n15\tsubclass to ``load_config(path, data_cls=YourDataConfig)``. You do not copy this file.\n16\tSee ``downstream_apps/template/configs.py`` for a worked example.\n17\t\"\"\"\n18\t\n19\tfrom __future__ import annotations\n20\t\n21\timport os\n22\tfrom dataclasses import MISSING, dataclass, field, fields as dc_fields\n23\tfrom pathlib import Path\n24\tfrom typing import ClassVar, List, Optional, Union\n25\t\n26\timport yaml\n27\t\n28\t# Environment variable consulted when data.s3_cache_dir is left unset in the config.\n29\t# It lets one committed config run on machines with different scratch space, without an\n30\t# absolute path pointing into one user's home ending up in version control.\n31\tS3_CACHE_DIR_ENV_VAR = \"SURYA_WS_CACHE_DIR\"\n32\t\n33\t\n34\t# How HelioNetCDFDataset reads s3:// paths. Declared here rather than in helio.py so the\n35\t# config layer can reject a bad value at startup, before any dataset is constructed.\n36\t#   \"download\"    \u2014 fetch the whole object into s3_cache_dir, then open it locally.\n37\t#                   Recommended: NetCDF/HDF5 needs random seeks that streaming cannot serve.\n38\t#   \"simplecache\" \u2014 fsspec read-through cache into s3_cache_dir.\n39\t#   \"stream\"      \u2014 direct s3fs handle, no local cache. Works, but roughly 9x slower on\n40\t#                   full SDO frames: HDF5 random access becomes many small ranged GETs.\n41\tVALID_S3_MODES = (\"download\", \"simplecache\", \"stream\")\n42\t\n43\t# Accepted values for training.deterministic, passed straight to lightning.Trainer.\n44\t#   False   \u2014 no determinism guarantees; two identical runs may differ. The default,\n45\t#             chosen for throughput: determinism costs roughly 20% of wall time.\n46\t#   \"warn\"  \u2014 bit-identical wherever a deterministic kernel exists; warn (naming the op)\n47\t#             where one does not. Never blocks a run. Switch to this whenever you need to\n48\t#             attribute a change in results to your edit rather than to run-to-run drift.\n49\t#   True    \u2014 hard guarantee; any op without a deterministic kernel raises. Note that\n50\t#             model.learned_flow uses F.grid_sample, which has no deterministic CUDA\n51\t#             backward, so learned_flow: true is incompatible with this setting.\n52\tVALID_DETERMINISTIC = (True, False, \"warn\")\n53\t\n54\t\n55\t@dataclass\n56\tclass TimeEmbeddingConfig:\n57\t    \"\"\"Controls how temporal position is encoded before the transformer blocks.\"\"\"\n58\t    type: str = \"linear\"         # \"linear\" | \"fourier\" | \"perceiver\"\n59\t    n_queries: Optional[int] = None  # Required for \"perceiver\"; unused otherwise\n60\t    time_dim: int = 1            # Number of input timesteps\n61\t\n62\t\n63\t@dataclass\n64\tclass LoraAdapterConfig:\n65\t    \"\"\"\n66\t    Settings for PEFT LoRA fine-tuning.\n67\t\n68\t    Passed to apply_peft_lora(); mirrors the fields of peft.LoraConfig.\n69\t    Named LoraAdapterConfig to avoid confusion with peft.LoraConfig.\n70\t\n71\t    The default target_modules match the Surya backbone's actual layer names:\n72\t    the feed-forward layers (fc1/fc2) in all blocks, plus the fused attention\n73\t    projection (attn.qkv) and output projection (attn.proj) in the attention\n74\t    blocks.  The dotted forms are deliberate -- a bare \"proj\" would also match\n75\t    the Conv2d patch-embedding tokeniser at embedding.patch_embed.proj.\n76\t\n77\t    PEFT only errors when *no* entry matches anything, so a misspelt name is\n78\t    silently ignored; keep this list in sync with the backbone.\n79\t\n80\t    There is no modules_to_save field: apply_peft_lora() discovers the\n81\t    fine-tuning head automatically from the ``head_`` naming convention.\n82\t    \"\"\"\n83\t    r: int = 8\n84\t    lora_alpha: int = 8\n85\t    target_modules: List[str] = field(\n86\t        default_factory=lambda: [\"fc1\", \"fc2\", \"attn.qkv\", \"attn.proj\"]\n87\t    )\n88\t    lora_dropout: float = 0.1\n89\t    bias: str = \"none\"\n90\t\n91\t\n92\t@dataclass\n93\tclass ModelConfig:\n94\t    \"\"\"\n95\t    Full configuration for the HelioSpectFormer backbone and fine-tuning head.\n96\t\n97\t    Backbone parameters mirror the HelioSpectFormer constructor.\n98\t    Fine-tuning head parameters are used by HelioSpectformer1D.\n99\t    \"\"\"\n100\t    # --- Backbone ---\n101\t    img_size: int = 4096\n102\t    patch_size: int = 16\n103\t    in_channels: int = 13\n104\t    embed_dim: int = 1280\n105\t    depth: int = 10\n106\t    spectral_blocks: int = 2\n107\t    num_heads: int = 16\n108\t    mlp_ratio: float = 4.0\n109\t    drop_rate: float = 0.0\n110\t    window_size: int = 2\n111\t    dp_rank: int = 4\n112\t    rpe: bool = False\n113\t    learned_flow: bool = False\n114\t    init_weights: bool = False\n115\t    checkpoint_layers: List[int] = field(default_factory=lambda: list(range(10)))\n116\t    ensemble: Optional[int] = None\n117\t    time_embedding: TimeEmbeddingConfig = field(default_factory=TimeEmbeddingConfig)\n118\t\n119\t    # --- Fine-tuning head ---\n120\t    # One of: \"global_average\" | \"global_max\" | \"attention\" | \"transformer\" | \"class_token\"\n121\t    pooling: str = \"class_token\"\n122\t    penultimate_linear_layer: bool = True\n123\t    dropout: float = 0.2\n124\t    freeze_backbone: bool = False\n125\t\n126\t    # --- LoRA ---\n127\t    use_lora: bool = True\n128\t    lora_config: LoraAdapterConfig = field(default_factory=LoraAdapterConfig)\n129\t\n130\t    # --- Checkpoint ---\n131\t    # Path to the pretrained Surya backbone weights. Passed to load_pretrained_weights().\n132\t    # Kept on ModelConfig (not TrainingConfig) because it describes the model, not the run.\n133\t    pretrained_path: Optional[str] = None\n134\t\n135\t    def __post_init__(self) -> None:\n136\t        if self.img_size % self.patch_size != 0:\n137\t            raise ValueError(\n138\t                f\"model.img_size ({self.img_size}) must be divisible by model.patch_size \"\n139\t                f\"({self.patch_size}); patch embedding silently crops the remainder otherwise.\"\n140\t            )\n141\t        if not 0 <= self.spectral_blocks <= self.depth:\n142\t            raise ValueError(\n143\t                f\"model.spectral_blocks ({self.spectral_blocks}) must be between 0 and \"\n144\t                f\"model.depth ({self.depth}) inclusive: spectral_blocks is the cutoff within \"\n145\t                f\"the depth blocks, not an additional count.\"\n146\t            )\n147\t        bad_layers = [i for i in self.checkpoint_layers if not 0 <= i < self.depth]\n148\t        if bad_layers:\n149\t            raise ValueError(\n150\t                f\"model.checkpoint_layers contains out-of-range index(es) {bad_layers}; \"\n151\t                f\"each entry must satisfy 0 <= i < model.depth ({self.depth}). Out-of-range \"\n152\t                \"entries are silently ignored at runtime rather than erroring, so they are \"\n153\t                \"rejected here instead.\"\n154\t            )\n155\t        if self.learned_flow and self.time_embedding.type != \"linear\":\n156\t            raise ValueError(\n157\t                f\"model.learned_flow is only supported with model.time_embedding.type \"\n158\t                f'\"linear\"; got type={self.time_embedding.type!r}. The vendored backbone\\'s '\n159\t                \"\\\"linear\\\" embedding adjusts its channel count for the extra learned-flow \"\n160\t                \"frame, but the other embedding types do not.\"\n161\t            )\n162\t\n163\t\n164\t# ---------------------------------------------------------------------------\n165\t# Run configuration\n166\t# ---------------------------------------------------------------------------\n167\t\n168\t@dataclass\n169\tclass DataConfig:\n170\t    \"\"\"What data to load, how to sample it in time, and how to reach it on S3.\n171\t\n172\t    Task-specific fields (label catalogs, alignment parameters, \u2026) do not belong here.\n173\t    Subclass this in your app and pass the subclass to ``load_config(data_cls=...)``.\n174\t    \"\"\"\n175\t\n176\t    # Fields holding a filesystem path. Relative values are resolved against the config\n177\t    # file's own directory, so a checked-in config works from any working directory and\n178\t    # on any machine \u2014 no absolute paths pointing into one user's home.\n179\t    # A subclass that adds a path field must extend this, e.g.:\n180\t    #     PATH_FIELDS = DataConfig.PATH_FIELDS + (\"my_catalog_path\",)\n181\t    PATH_FIELDS: ClassVar[tuple[str, ...]] = (\n182\t        \"train_data_path\",\n183\t        \"valid_data_path\",\n184\t        \"scalers_path\",\n185\t        \"sdo_data_root_path\",\n186\t    )\n187\t\n188\t    # --- Paths (relative paths are resolved against the config file's directory) ---\n189\t    train_data_path: str\n190\t    valid_data_path: str\n191\t    scalers_path: str\n192\t\n193\t    # --- Input channels and temporal sampling ---\n194\t    channels: List[str]\n195\t    time_delta_input_minutes: List[int]\n196\t    time_delta_target_minutes: int\n197\t\n198\t    # --- Local data ---\n199\t    # Root prepended to relative local paths in the index. Ignored for s3:// paths.\n200\t    sdo_data_root_path: Optional[str] = None\n201\t\n202\t    # --- S3 (used only when the index contains s3:// paths) ---\n203\t    s3_anon: bool = False\n204\t    # One of VALID_S3_MODES (above). \"download\" is recommended for NetCDF/HDF5.\n205\t    s3_mode: str = \"download\"\n206\t    # Required unless s3_mode is \"stream\". Budget ~1 GB per unique timestep.\n207\t    # Left unset here, load_config() falls back to $SURYA_WS_CACHE_DIR.\n208\t    s3_cache_dir: Optional[str] = None\n209\t    s3_boto3_max_concurrency: int = 4   # parallel threads per multipart download\n210\t    s3_boto3_part_size_mb: int = 64     # part size in MB for multipart downloads\n211\t\n212\t    # --- Development ---\n213\t    max_samples: Optional[int] = None\n214\t\n215\t    def __post_init__(self) -> None:\n216\t        if self.s3_mode not in VALID_S3_MODES:\n217\t            raise ValueError(\n218\t                f\"Unknown data.s3_mode {self.s3_mode!r}. \"\n219\t                f\"Valid modes are: {', '.join(VALID_S3_MODES)}.\"\n220\t            )\n221\t\n222\t\n223\t@dataclass\n224\tclass OutputConfig:\n225\t    \"\"\"Paths and S3 settings for checkpoints and artifacts.\"\"\"\n226\t    ckpt_dir: str = \"checkpoints\"\n227\t    # S3 upload of best checkpoint (all three used together; leave s3_bucket null to disable)\n228\t    s3_bucket: Optional[str] = None\n229\t    s3_prefix: str = \"\"\n230\t    s3_best_key: str = \"best.ckpt\"\n231\t\n232\t\n233\t@dataclass\n234\tclass TrainingConfig:\n235\t    \"\"\"Top-level configuration for a fine-tuning run.\"\"\"\n236\t    job_id: str\n237\t    data: DataConfig\n238\t    model: ModelConfig\n239\t    output: OutputConfig = field(default_factory=OutputConfig)\n240\t    learning_rate: float = 1e-4\n241\t    max_epochs: int = 20\n242\t    batch_size: int = 2\n243\t    num_workers: int = 8\n244\t    # Seeds every RNG (Python, NumPy, torch, and each DataLoader worker) and the shuffle\n245\t    # order. This applies regardless of `deterministic`: even with determinism off, the\n246\t    # data order is pinned, so changing the seed is how you get a genuinely different run.\n247\t    seed: int = 42\n248\t    # One of VALID_DETERMINISTIC (above). Defaults to False for speed; set \"warn\" when\n249\t    # you need reproducible results.\n250\t    deterministic: Union[bool, str] = False\n251\t    rollout_steps: int = 0\n252\t    drop_hmi_probability: float = 0.0\n253\t    use_latitude_in_learned_flow: bool = False\n254\t    dtype: str = \"float32\"\n255\t    wandb_project: str = \"surya_downstream\"\n256\t    wandb_entity: Optional[str] = None\n257\t\n258\t    def __post_init__(self) -> None:\n259\t        # Normalize the string form so YAML \"Warn\"/\"WARN\" behave like \"warn\"; bools pass\n260\t        # through untouched (YAML true/false already parse as Python bools).\n261\t        if isinstance(self.deterministic, str):\n262\t            self.deterministic = self.deterministic.lower()\n263\t        if self.deterministic not in VALID_DETERMINISTIC:\n264\t            raise ValueError(\n265\t                f\"Unknown training.deterministic {self.deterministic!r}. \"\n266\t                \"Valid values are: true, false, \\\"warn\\\".\"\n267\t            )\n268\t        # A quoted seed in YAML (\"42\") would otherwise reach torch.manual_seed as a str\n269\t        # and fail deep in the training loop. bool is excluded because it subclasses int.\n270\t        if isinstance(self.seed, bool) or not isinstance(self.seed, int):\n271\t            raise ValueError(\n272\t                f\"training.seed must be an integer, got {self.seed!r} \"\n273\t                f\"({type(self.seed).__name__}). Write it unquoted in the YAML, e.g. seed: 42.\"\n274\t            )\n275\t        if self.deterministic is True and self.model.learned_flow:\n276\t            raise ValueError(\n277\t                \"training.deterministic: true is incompatible with model.learned_flow: true \"\n278\t                \"(F.grid_sample has no deterministic CUDA backward). Use \"\n279\t                'training.deterministic: \"warn\" instead, or set model.learned_flow: false.'\n280\t            )\n281\t        time_dim = self.model.time_embedding.time_dim\n282\t        n_available = len(self.data.time_delta_input_minutes)\n283\t        if time_dim > n_available:\n284\t            raise ValueError(\n285\t                f\"model.time_embedding.time_dim ({time_dim}) must be <= \"\n286\t                f\"len(data.time_delta_input_minutes) ({n_available}): the dataset samples \"\n287\t                \"time_dim frames from that list and cannot sample more than it contains.\"\n288\t            )\n289\t\n290\t\n291\t# ---------------------------------------------------------------------------\n292\t# YAML parsing\n293\t# ---------------------------------------------------------------------------\n294\t\n295\tdef _from_dict(cls, d: dict, section: str):\n296\t    \"\"\"Construct a dataclass from a dict, rejecting unrecognized keys.\n297\t\n298\t    Unknown keys are an error, not a silent no-op. A dropped key looks exactly like a\n299\t    working one: adding ``s3_mode: stream`` to the YAML without a matching dataclass\n300\t    field would otherwise change nothing and report nothing. Failing here names the\n301\t    typo and lists what was expected.\n302\t    \"\"\"\n303\t    if not isinstance(d, dict):\n304\t        raise ValueError(f\"Config section '{section}:' must be a mapping, got {type(d).__name__}.\")\n305\t\n306\t    known = {f.name for f in dc_fields(cls)}\n307\t    unknown = sorted(set(d) - known)\n308\t    if unknown:\n309\t        raise ValueError(\n310\t            f\"Unrecognized key(s) in '{section}:' section of the config: \"\n311\t            f\"{', '.join(unknown)}.\\n\"\n312\t            f\"Valid keys for {cls.__name__} are: {', '.join(sorted(known))}.\\n\"\n313\t            \"If this is a new task-specific setting, add it to your DataConfig subclass \"\n314\t            \"(see downstream_apps/template/configs.py).\"\n315\t        )\n316\t\n317\t    missing = [\n318\t        f.name for f in dc_fields(cls)\n319\t        if f.name not in d\n320\t        and f.default is MISSING\n321\t        and f.default_factory is MISSING  # type: ignore[misc]\n322\t    ]\n323\t    if missing:\n324\t        raise ValueError(\n325\t            f\"Missing required key(s) in '{section}:' section of the config: \"\n326\t            f\"{', '.join(missing)}.\"\n327\t        )\n328\t\n329\t    return cls(**d)\n330\t\n331\t\n332\tdef _resolve_path(value, config_dir: Path) -> str:\n333\t    \"\"\"Expand ``~``/``$VARS`` and anchor a relative path to the config file's directory.\"\"\"\n334\t    expanded = os.path.expandvars(os.path.expanduser(str(value)))\n335\t    if not os.path.isabs(expanded):\n336\t        expanded = str((config_dir / expanded).resolve())\n337\t    return expanded\n338\t\n339\t\n340\tdef _resolve_paths(data_cfg, config_dir: Path) -> None:\n341\t    \"\"\"Expand ``~``/env vars and resolve relative path fields against the config's directory.\"\"\"\n342\t    for name in getattr(type(data_cfg), \"PATH_FIELDS\", DataConfig.PATH_FIELDS):\n343\t        value = getattr(data_cfg, name, None)\n344\t        if value:\n345\t            setattr(data_cfg, name, _resolve_path(value, config_dir))\n346\t\n347\t    # s3_cache_dir is a scratch location, not a repo path. Precedence is\n348\t    # CLI flag > config value > $SURYA_WS_CACHE_DIR; expand ~ and $VARS, but never anchor\n349\t    # it to the config directory (that would put ~1 GB files inside the repo).\n350\t    cache_dir = getattr(data_cfg, \"s3_cache_dir\", None) or os.environ.get(S3_CACHE_DIR_ENV_VAR)\n351\t    if cache_dir:\n352\t        data_cfg.s3_cache_dir = os.path.expandvars(os.path.expanduser(str(cache_dir)))\n353\t\n354\t\n355\tdef load_config(\n356\t    path: Union[str, Path],\n357\t    data_cls: type = DataConfig,\n358\t) -> TrainingConfig:\n359\t    \"\"\"Parse a run config YAML into a typed ``TrainingConfig``.\n360\t\n361\t    The YAML has five top-level sections (data, model, training, output, logging) plus\n362\t    ``job_id``. Each is parsed into its dataclass; unknown keys raise rather than being\n363\t    silently dropped.\n364\t\n365\t    Args:\n366\t        path: Path to the config YAML.\n367\t        data_cls: The ``DataConfig`` subclass to parse the ``data:`` section into. Pass\n368\t            your app's subclass to accept task-specific keys.\n369\t\n370\t    Returns:\n371\t        A fully typed ``TrainingConfig``. Relative paths in the ``data:`` section are\n372\t        resolved against the config file's own directory.\n373\t    \"\"\"\n374\t    config_path = Path(path).expanduser().resolve()\n375\t    if not config_path.is_file():\n376\t        raise FileNotFoundError(f\"Config file not found: {config_path}\")\n377\t\n378\t    with open(config_path, \"r\", encoding=\"utf-8\") as f:\n379\t        raw = yaml.safe_load(f)\n380\t\n381\t    if not isinstance(raw, dict):\n382\t        raise ValueError(f\"Config {config_path} must contain a top-level mapping.\")\n383\t\n384\t    missing_sections = [k for k in (\"job_id\", \"data\", \"model\") if k not in raw]\n385\t    if missing_sections:\n386\t        raise ValueError(\n387\t            f\"Config {config_path} is missing required top-level key(s): \"\n388\t            f\"{', '.join(missing_sections)}. Expected: job_id, data, model \"\n389\t            \"(training, output and logging are optional).\"\n390\t        )\n391\t\n392\t    # model: build the nested configs first, then the ModelConfig around them.\n393\t    model_raw = dict(raw[\"model\"])\n394\t    model_raw[\"time_embedding\"] = _from_dict(\n395\t        TimeEmbeddingConfig, model_raw.get(\"time_embedding\", {}), \"model.time_embedding\"\n396\t    )\n397\t    model_raw[\"lora_config\"] = _from_dict(\n398\t        LoraAdapterConfig, model_raw.get(\"lora_config\", {}), \"model.lora_config\"\n399\t    )\n400\t    model_cfg = _from_dict(ModelConfig, model_raw, \"model\")\n401\t\n402\t    # pretrained_path is a path like the data: ones, and gets the same treatment.\n403\t    if model_cfg.pretrained_path:\n404\t        model_cfg.pretrained_path = _resolve_path(model_cfg.pretrained_path, config_path.parent)\n405\t\n406\t    data_cfg = _from_dict(data_cls, raw[\"data\"], \"data\")\n407\t    _resolve_paths(data_cfg, config_path.parent)\n408\t\n409\t    training = raw.get(\"training\", {}) or {}\n410\t    logging_cfg = raw.get(\"logging\", {}) or {}\n411\t    _check_section_keys(training, _TRAINING_KEYS, \"training\")\n412\t    _check_section_keys(logging_cfg, _LOGGING_KEYS, \"logging\")\n413\t\n414\t    return TrainingConfig(\n415\t        job_id=raw[\"job_id\"],\n416\t        data=data_cfg,\n417\t        model=model_cfg,\n418\t        output=_from_dict(OutputConfig, raw.get(\"output\", {}) or {}, \"output\"),\n419\t        learning_rate=training.get(\"learning_rate\", 1e-4),\n420\t        max_epochs=training.get(\"max_epochs\", 20),\n421\t        batch_size=training.get(\"batch_size\", 2),\n422\t        num_workers=training.get(\"num_workers\", 8),\n423\t        seed=training.get(\"seed\", 42),\n424\t        deterministic=training.get(\"deterministic\", False),\n425\t        rollout_steps=training.get(\"rollout_steps\", 0),\n426\t        drop_hmi_probability=training.get(\"drop_hmi_probability\", 0.0),\n427\t        use_latitude_in_learned_flow=training.get(\"use_latitude_in_learned_flow\", False),\n428\t        dtype=training.get(\"dtype\", \"float32\"),\n429\t        wandb_project=logging_cfg.get(\"wandb_project\", \"surya_downstream\"),\n430\t        wandb_entity=logging_cfg.get(\"wandb_entity\"),\n431\t    )\n432\t\n433\t\n434\t# The training: and logging: sections map onto flat TrainingConfig fields rather than\n435\t# onto a dataclass of their own, so their keys are checked explicitly.\n436\t_TRAINING_KEYS = frozenset({\n437\t    \"learning_rate\", \"max_epochs\", \"batch_size\", \"num_workers\", \"seed\", \"deterministic\",\n438\t    \"rollout_steps\", \"drop_hmi_probability\", \"use_latitude_in_learned_flow\", \"dtype\",\n439\t})\n440\t_LOGGING_KEYS = frozenset({\"wandb_project\", \"wandb_entity\"})\n441\t\n442\t\n443\tdef _check_section_keys(section: dict, valid: frozenset, name: str) -> None:\n444\t    \"\"\"Raise on unrecognized keys in a section that has no dataclass of its own.\"\"\"\n445\t    unknown = sorted(set(section) - valid)\n446\t    if unknown:\n447\t        raise ValueError(\n448\t            f\"Unrecognized key(s) in '{name}:' section of the config: {', '.join(unknown)}.\\n\"\n449\t            f\"Valid keys are: {', '.join(sorted(valid))}.\"\n450\t        )\n451\t",
            "title": "Read configs.py",
            "tool_call_id": "toolu_bdrk_016Mtd3qyRvL2CmhYhsR2kjN",
            "kind": "read",
            "status": "completed"
          },
          {
            "title": "cd  && python3 -c \" import json nb=json.load(open('2_finetune_template_1D.ipynb')) for i in range(24,46): c=nb['cells'][i] print('#'*70) print('### CELL',i,c['cell_type'],'exec_count=',c.get('execution_count')) print('-'*20,'SOURCE','-'*20) print(''.join(c['source'])) outs=c.get('outputs') or [] for j,o in enumerate(outs): print('-'*10,'OUT',j,o.get('output_type'),'-'*10) if o.get('output_type')=='stream': t=''.join(o.get('text',[])) print('[',o.get('name'),']',t[:3000]) elif o.get('output_type')=='error': print('ENAME:',o.get('ename'),'EVALUE:',o.get('evalue')) print('\\n'.join(o.get('traceback',[]))[:12000]) else: d=o.get('data',{}) for k,v in d.items(): if k=='text/plain': print('text/plain:',''.join(v)[:2000]) else: print('[',k,'len',len(''.join(v) if isinstance(v,list) else str(v)),']') \"",
            "status": "completed",
            "raw_input": {
              "command": "cd /home/jovyan/adi_wdir/surya_workshop/downstream_apps/sf_triggers/ && python3 -c \"\nimport json\nnb=json.load(open('2_finetune_template_1D.ipynb'))\nfor i in range(24,46):\n    c=nb['cells'][i]\n    print('#'*70)\n    print('### CELL',i,c['cell_type'],'exec_count=',c.get('execution_count'))\n    print('-'*20,'SOURCE','-'*20)\n    print(''.join(c['source']))\n    outs=c.get('outputs') or []\n    for j,o in enumerate(outs):\n        print('-'*10,'OUT',j,o.get('output_type'),'-'*10)\n        if o.get('output_type')=='stream':\n            t=''.join(o.get('text',[]))\n            print('[',o.get('name'),']',t[:3000])\n        elif o.get('output_type')=='error':\n            print('ENAME:',o.get('ename'),'EVALUE:',o.get('evalue'))\n            print('\\n'.join(o.get('traceback',[]))[:12000])\n        else:\n            d=o.get('data',{})\n            for k,v in d.items():\n                if k=='text/plain':\n                    print('text/plain:',''.join(v)[:2000])\n                else:\n                    print('[',k,'len',len(''.join(v) if isinstance(v,list) else str(v)),']')\n\"",
              "description": "Dump cells 24-45 with sources and outputs"
            },
            "tool_call_id": "toolu_bdrk_018cRLzoef54kuRnF5ZDaNWW",
            "raw_output": "######################################################################\n### CELL 24 markdown exec_count= None\n-------------------- SOURCE --------------------\n## Define your metrics\n\nMetrics are a very important part of training AI models.   They provide your models with the quantitification of error, which in turn shifts the weights towards better pefrorming models.  They also provide a way for you to monitor performance, identify overfitting, and quantify value added. \n\nWe now initialize the metrics class which allows you to control what metrics do you want to use as \"loss\" (i.e. the metrics that backpropagate through your model) and which ones for monitoring performance.  As with other components, this takes the form of a loaded module that can be later use in a training script\n######################################################################\n### CELL 25 code exec_count= 15\n-------------------- SOURCE --------------------\nfrom downstream_apps.sf_triggers.metrics.sf_triggers_metrics import FlareMetrics\n######################################################################\n### CELL 26 code exec_count= 16\n-------------------- SOURCE --------------------\ntrain_loss_metrics = FlareMetrics(\"train_loss\")\n# val_loss is the quantity logged as \"val_loss\" and used to pick the best checkpoint.\n# It defaults to the same MSE as train_loss \u2014 override FlareMetrics.val_loss to change it.\nval_loss_metrics = FlareMetrics(\"val_loss\")\ntrain_evaluation_metrics = FlareMetrics(\"train_metrics\")\n# Reported only: val_metrics do NOT influence checkpoint selection.\nvalidation_evaluation_metrics = FlareMetrics(\"val_metrics\")\n######################################################################\n### CELL 27 markdown exec_count= None\n-------------------- SOURCE --------------------\nNow they can be evaluated in our model's output and our ground truth.   First the loss that actually will backpropagate, in this case Mean Squared Errror\n######################################################################\n### CELL 28 code exec_count= 17\n-------------------- SOURCE --------------------\ntrain_loss_metrics(output, batch[\"forecast\"])\n---------- OUT 0 execute_result ----------\ntext/plain: ({'mse': tensor(0.2119, grad_fn=<MseLossBackward0>)}, [1])\n######################################################################\n### CELL 29 markdown exec_count= None\n-------------------- SOURCE --------------------\nThen a training evaluation that will not backpropagate and inform our model, but that we can keep an eye on. Note that reporting lots of metrics during training will slow the training process.  I'm including it her as an example, but oftentimes is better to put the diagnostics only in the validation evaluation metrics.\n\nHere we are caclulating the Root Relative Squared Error https://lightning.ai/docs/torchmetrics/stable/regression/rse.html \n\nA value below one means the prediction is better than predicting the average.  It is unlikely that this metric will be lower than one with a randomly initialized model\n######################################################################\n### CELL 30 code exec_count= 18\n-------------------- SOURCE --------------------\ntrain_evaluation_metrics(output, batch[\"forecast\"])\n---------- OUT 0 execute_result ----------\ntext/plain: ({'rrse': tensor(2.9550)}, [1])\n######################################################################\n### CELL 31 markdown exec_count= None\n-------------------- SOURCE --------------------\nIn the validation evaluation metrics we report both MSE and RRSE\n######################################################################\n### CELL 32 code exec_count= 19\n-------------------- SOURCE --------------------\nvalidation_evaluation_metrics(output, batch[\"forecast\"])\n---------- OUT 0 execute_result ----------\ntext/plain: ({'mse': tensor(0.2119), 'rrse': tensor(2.9550)}, [1, 1])\n######################################################################\n### CELL 33 markdown exec_count= None\n-------------------- SOURCE --------------------\n## Define your PyTorch ligthning module\n\nIn this workshop we will use PyTorch lightning to train our models.  PyTorch lighting reduces the amount of code required to implement a training loop in comparison to PyTorch (at the expense of control and versatility).  \n\nOpening the FlareLightningModule shows a simple Lightning model implementation.  It consists of:\n\n- An initialization of the class (metrics, model, and learning rate).\n- The forward code that runs evaluation of the model.\n- Training and validation steps.\n- Configuration of optimizers.\n\n**_Note that it is the same Lightning module we used for the baseline!!_**\n######################################################################\n### CELL 34 code exec_count= 20\n-------------------- SOURCE --------------------\nfrom downstream_apps.template.lightning_modules.pl_simple_baseline import FlareLightningModule\n######################################################################\n### CELL 35 markdown exec_count= None\n-------------------- SOURCE --------------------\n## Set your global seeds\n\nSince training AI models generally uses stochastic gradient descent, it is a good idea to fix your random seeds so that your training exercise is reproducible.    \n######################################################################\n### CELL 36 code exec_count= 21\n-------------------- SOURCE --------------------\nL.seed_everything(42, workers=True)\n---------- OUT 0 stream ----------\n[ stderr ] Seed set to 42\n\n---------- OUT 1 execute_result ----------\ntext/plain: 42\n######################################################################\n### CELL 37 markdown exec_count= None\n-------------------- SOURCE --------------------\n## Intialize Lightning module\n\nNow we properly initalize the Lightning module to enable training, including passing the dictionary of metrics\n######################################################################\n### CELL 38 code exec_count= 22\n-------------------- SOURCE --------------------\nmetrics = {\n    'train_loss': train_loss_metrics,\n    'val_loss': val_loss_metrics,\n    'train_metrics': train_evaluation_metrics,\n    'val_metrics': validation_evaluation_metrics,\n}\n\nlit_model = FlareLightningModule(model, metrics, lr=cfg.learning_rate, batch_size=batch_size)\n\n######################################################################\n### CELL 39 markdown exec_count= None\n-------------------- SOURCE --------------------\n## Logging\n\nIn order to properly compare experiments against each other, it is very useful to log evaluation metrics in a place where they can be compared against other training runs.  In this workshop we will use Weights and Biases (WandB). \n\nThe first time you run WandB in a machine it will ask you to login to WandB.  You should have received an invitation to our project.  In order to login you must:\n\n- Select option 2 (existing account).   In VScode the dialog opens a box at the top of your screen.\n- Click on get API Key (this will open a browser).\n- Generate API Key.\n- Paste it in the dialog box at the top of your VSCode\n######################################################################\n### CELL 40 code exec_count= 23\n-------------------- SOURCE --------------------\nproject_name = cfg.wandb_project\nrun_name = \"adi_vs_surya_fine_tuning\"  # give your run a descriptive name\n\nwandb_logger = WandbLogger(\n    entity=cfg.wandb_entity,  # set wandb_entity in the config; null = personal account\n    project=project_name,\n    name=run_name,\n    log_model=False,\n    save_dir=\"./wandb/wandb_tmp\",\n)\n\ncsv_logger = CSVLogger(\"runs\", name=project_name)\n\n######################################################################\n### CELL 41 markdown exec_count= None\n-------------------- SOURCE --------------------\n## Initialize trainer\n\nWith the loggers done, now the trainer needs to be defined.  The trainer defines several properties of your training run. Here we define:\n\n- The max number of epochs (one epoch represents your model seeing your entire training dataset).\n- Define where the training run will take place (auto uses the GPU if possible, if not, CPU).\n- The loggers.\n- The callbacks (here we save the model with the lowest validation loss).\n- Logging frequency (because we are working with a small dataset it needs to be small).\n\n\n**Note that in this notebook we also set a mixed precision to reduce the model's footprint in memory.**\n######################################################################\n### CELL 42 code exec_count= 24\n-------------------- SOURCE --------------------\nmax_epochs = 2\n\n# -------------------------------------------------------------------------\n# Trainer\n# -------------------------------------------------------------------------\ntrainer = L.Trainer(\n    max_epochs=max_epochs,\n    accelerator=\"auto\",\n    devices=\"auto\",\n    precision=\"bf16-mixed\", \n    logger=[wandb_logger, csv_logger],\n    callbacks=[\n        ModelCheckpoint(\n            monitor=\"val_loss\",\n            mode=\"min\",\n            save_top_k=1,\n        )\n    ],\n    log_every_n_steps=2,\n)\n---------- OUT 0 stream ----------\n[ stderr ] Using bfloat16 Automatic Mixed Precision (AMP)\n\n---------- OUT 1 stream ----------\n[ stderr ] GPU available: True (cuda), used: True\n\n---------- OUT 2 stream ----------\n[ stderr ] TPU available: False, using: 0 TPU cores\n\n---------- OUT 3 stream ----------\n[ stderr ] \ud83d\udca1 Tip: For seamless cloud logging and experiment tracking, try installing [litlogger](https://pypi.org/project/litlogger/) to enable LitLogger, which logs metrics and artifacts automatically to the Lightning Experiments platform.\n\n######################################################################\n### CELL 43 markdown exec_count= None\n-------------------- SOURCE --------------------\n## Fit the model\n\nFinally we fit the model.  We pass the Lighting module, and our dataloaders.\n######################################################################\n### CELL 44 code exec_count= 25\n-------------------- SOURCE --------------------\ntrainer.fit(lit_model, train_data_loader, val_data_loader)\n---------- OUT 0 stream ----------\n[ stderr ] \u001b[34m\u001b[1mwandb\u001b[0m: \u001b[33mWARNING\u001b[0m The anonymous setting has no effect and will be removed in a future version.\n\n---------- OUT 1 stream ----------\n[ stderr ] \u001b[34m\u001b[1mwandb\u001b[0m: \u001b[32m\u001b[41mERROR\u001b[0m Failed to detect the name of this notebook. You can set it manually with the WANDB_NOTEBOOK_NAME environment variable to enable code saving.\n\n---------- OUT 2 stream ----------\n[ stderr ] \u001b[34m\u001b[1mwandb\u001b[0m: Currently logged in as: \u001b[33madithyabhattsringeri\u001b[0m (\u001b[33msurya-ws2\u001b[0m) to \u001b[32mhttps://api.wandb.ai\u001b[0m. Use \u001b[1m`wandb login --relogin`\u001b[0m to force relogin\n\n---------- OUT 3 display_data ----------\n[ text/html len 0 ]\ntext/plain: <IPython.core.display.HTML object>\n---------- OUT 4 display_data ----------\n[ text/html len 27 ]\ntext/plain: <IPython.core.display.HTML object>\n---------- OUT 5 display_data ----------\n[ text/html len 27 ]\ntext/plain: <IPython.core.display.HTML object>\n---------- OUT 6 display_data ----------\n[ text/html len 27 ]\ntext/plain: <IPython.core.display.HTML object>\n---------- OUT 7 display_data ----------\n[ text/html len 30 ]\ntext/plain: <IPython.core.display.HTML object>\n---------- OUT 8 display_data ----------\n[ text/html len 30 ]\ntext/plain: <IPython.core.display.HTML object>\n---------- OUT 9 display_data ----------\n[ text/html len 30 ]\ntext/plain: <IPython.core.display.HTML object>\n---------- OUT 10 display_data ----------\n[ text/html len 0 ]\ntext/plain: <IPython.core.display.HTML object>\n---------- OUT 11 display_data 