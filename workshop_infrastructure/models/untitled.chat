            "title": "cd  && python3 -c \" import json nb=json.load(open('2_finetune_template_1D.ipynb')) for i in range(0,24): c=nb['cells'][i] if c['cell_type']!='code': continue print('#'*60) print('### CELL',i,'exec=',c.get('execution_count')) print(''.join(c['source'])) for o in (c.get('outputs') or []): t=o.get('output_type') if t=='stream': print('--OUT stream',o.get('name'),':',''.join(o.get('text',[]))[:1500]) elif t=='error': print('--OUT ERROR',o.get('ename'),o.get('evalue')) else: print('--OUT',t,':',''.join(o.get('data',{}).get('text/plain','') or '')[:1500]) \"",
