/workshop_infrastructure/benchmark_s3.py:163:    while offset < sample_bytes:\n/home/jovyan/adi_wdir/surya_workshop/workshop_infrastructure/benchmark_s3.py:164:        end = min(offset + part_size, sample_bytes)\n/home/jovyan/adi_wdir/surya_workshop/workshop_infrastructure/benchmark_s3.py:193:    sample_bytes = min(cfg.sample_mb * 1024 * 1024, file_size)\n/home/jovyan/adi_wdir/surya_workshop/workshop_infrastructure/benchmark_s3.py:194:    sample_mb_actual = sample_bytes / 1e6\n/home/jovyan/adi_wdir/surya_workshop/workshop_infrastructure/benchmark_s3.py:224:                    concurrency, part_size_mb, sample_bytes,\n/home/jovyan/adi_wdir/surya_workshop/workshop_infrastructure/benchmark_s3.py:250:                    sample_mb=sample_mb_actual,\n/home/jovyan/adi_wdir/surya_workshop/workshop_infrastructure/benchmark_s3.py:259:                    sample_mb=sample_mb_actual,\n/home/jovyan/adi_wdir/surya_workshop/workshop_infrastructure/benchmark_s3.py:294:        f\"Throughput (MB/s) \u2014 sample={results[0].sample_mb:.0f} MB from {file_size_mb:.0f} MB file\",\n/home/jovyan/adi_wdir/surya_workshop/workshop_infrastructure/benchmark_s3.py:322:            \"* single-part: part_size >= sample size; only one request issued. \"\n/home/jovyan/adi_wdir/surya_workshop/workshop_infrastructure/benchmark_s3.py:360:                        \"sample_mb\", \"n_parts\", \"single_part\", \"error\"],\n/home/jovyan/adi_wdir/surya_workshop/workshop_infrastructure/benchmark_s3.py:368:                \"sample_mb\": f\"{r.sample_mb:.1f}\",\n/home/jovyan/adi_wdir/surya_workshop/workshop_infrastructure/benchmark_s3.py:410:        \"--sample-mb\",\n/home/jovyan/adi_wdir/surya_workshop/workshop_infrastructure/benchmark_s3.py:493:        sample_mb=args.sample_mb,\n/home/jovyan/adi_wdir/surya_workshop/workshop_infrastructure/benchmark_s3.py:514:    print(f\"  Sample:       up to {cfg.sample_mb} MB per download\")\n/home/jovyan/adi_wdir/surya_workshop/workshop_infrastructure/benchmark_s3.py:530:    