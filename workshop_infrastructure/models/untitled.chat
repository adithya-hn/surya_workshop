42),\n  424\t        deterministic=training.get(\"deterministic\", False),\n  425\t        rollout_steps=training.get(\"rollout_steps\", 0),\n  426\t        drop_hmi_probability=training.get(\"drop_hmi_probability\", 0.0),\n  427\t        use_latitude_in_learned_flow=training.get(\"use_latitude_in_learned_flow\", False),\n  428\t        dtype=training.get(\"dtype\", \"float32\"),\n  429\t        wandb_project=logging_cfg.get(\"wandb_project\", \"surya_downstream\"),\n  430\t        wandb_entity=logging_cfg.get(\"wandb_entity\"),\n  431\t    )\n  432\t\n  433\t\n  434\t# The training: and logging: sections map onto flat TrainingConfig fields rather than\n  435\t# onto a dataclass of their own, so their keys are checked explicitly.\n  436\t_TRAINING_KEYS = frozenset({\n  437\t    \"learning_rate\", \"max_epochs\", \"batch_size\", \"num_workers\", \"seed\", \"deterministic\",\n  438\t    \"rollout_steps\", \"drop_hmi_probability\", \"use_latitude_in_learned_flow\", \"dtype\",\n  439\t})\n  440\t_LOGGING_KEYS = frozenset({\"wandb_project\", \"wandb_entity\"})\n  441\t\n=== VALID_ constants ===\n31:S3_CACHE_DIR_ENV_VAR = \"SURYA_WS_CACHE_DIR\"\n41:VALID_S3_MODES = (\"download\", \"simplecache\", \"stream\")\n52:VALID_DETERMINISTIC = (True, False, \"warn\")\n440:_LOGGING_KEYS = frozenset({\"wandb_project\", \"wandb_entity\"})",
