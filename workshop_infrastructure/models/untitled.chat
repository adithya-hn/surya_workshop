    {
      "body": "65 passing. Now the real question: do these levers actually move peak GPU memory? The full config needs ~8.6 GiB and only 2.7 GiB is free, so let me measure the mechanism on a scaled-down 2D model on the actual T4:",
      "sender": "jupyter-ai-personas::jupyter_ai_acp_client::ClaudeAcpPersona",
      "time": 1789675340.7273192,
      "type": "msg",
      "raw_time": false,
      "mentions": [],
      "id": "22b90394-e25e-4e6f-8126-f37d4bae4069"
    },
    {
      "sender": "jupyter-ai-personas::jupyter_ai_acp_client::ClaudeAcpPersona",
      "id": "f9d20fcc-af17-4f79-80f4-50ea346f6e1d",
      "raw_time": false,
      "time": 1789675340.7317758,
      "type": "msg",
      "body": "",
      "mentions": [],
      "metadata": {
        "tool_calls": [
          {
            "status": "completed",
            "kind": "execute",
            "title": "cd surya_workshop && cat > gpu_ladder.py <<'PYEOF' \"\"\"Measure each memory lever on real CUDA, at reduced resolution. The full 4096x4096 config needs ~8.6 GiB and only ~2.7 GiB is free (a stale kernel holds the rest), so this runs img_size=1024 (4096 tokens). Absolute numbers are not the real run's; the point is the *direction and mechanism* of each lever on actual hardware. \"\"\" import gc, sys sys.path.insert(0, \".\") import torch from workshop_infrastructure.configs import LoraAdapterConfig from workshop_infrastructure.models.finetune_models import HelioSpectformer2D from workshop_infrastructure.utils import ( apply_peft_lora, cast_frozen_to, disable_peft_input_dtype_cast, ) IMG, PATCH, EMBED, DEPTH, NSPEC = 1024, 16, 1280, 4, 2 TOKENS = (IMG  PATCH) ** 2 print(f\"img_size={IMG} -> {TOKENS} tokens, embed={EMBED}, mlp hidden={EMBED*4}\") print(f\"one fc2 input: {TOKENS*EMBED*4} elems = \" f\"{TOKENS*EMBED*4*4/2**20:.0f} MiB fp32 / {TOKENS*EMBED*4*2/2**20:.0f} MiB half\\n\") def build(lora_dropout, disable_cast, cast_half, half_dtype): torch.manual_seed(0) m = HelioSpectformer2D( img_size=IMG, patch_size=PATCH, in_chans=13, embed_dim=EMBED, time_embedding={\"type\": \"linear\", \"time_dim\": 1}, depth=DEPTH, n_spectral_blocks=NSPEC, num_heads=16, mlp_ratio=4.0, drop_rate=0.0, window_size=2, dp_rank=4, dtype=torch.float32, ft_out_chans=1, checkpoint_layers=list(range(DEPTH)), ) m = apply_peft_lora(m, LoraAdapterConfig(r=2, lora_dropout=lora_dropout)) if disable_cast: disable_peft_input_dtype_cast(m) if cast_half: cast_frozen_to(m, half_dtype) return m def measure(m, autocast_dtype, label): dev = torch.device(\"cuda\") m = m.to(dev).train() batch = {\"ts\": torch.randn(1, 13, 1, IMG, IMG, device=dev), \"time_delta_input\": torch.zeros(1, 1, device=dev)} opt = torch.optim.Adam([p for p in m.parameters() if p.requires_grad], lr=1e-4) m.zero_grad(set_to_none=True); gc.collect(); torch.cuda.empty_cache() torch.cuda.reset_peak_memory_stats() static = torch.cuda.memory_allocated() / 2**20 with torch.autocast(\"cuda\", dtype=autocast_dtype): out = m(batch) loss = torch.nn.functional.mse_loss(out.reshape(-1), torch.zeros_like(out).reshape(-1)) loss.backward(); opt.step() peak = torch.cuda.max_memory_allocated() / 2**20 print(f\" {label:<46s} static {static:7.0f} MiB | peak {peak:7.0f} MiB\") del out, loss, batch, opt m.to(\"cpu\"); del m gc.collect(); torch.cuda.empty_cache() return peak import io, contextlib def quiet(fn, *a, **k): with contextlib.redirect_stdout(io.StringIO()): return fn(*a, **k) print(\"LADDER (each row adds one lever):\") r = {} r[\"a\"] = measure(quiet(build, 0.1, False, False, None), torch.bfloat16, \"(a) bf16-mixed, PEFT cast ON, dropout 0.1\") r[\"b\"] = measure(quiet(build, 0.1, True, False, None), torch.bfloat16, \"(b) + disable_peft_input_dtype_cast\") r[\"c\"] = measure(quiet(build, 0.0, True, False, None), torch.bfloat16, \"(c) + lora_dropout 0.0\") r[\"d\"] = measure(quiet(build, 0.0, True, True, torch.float16), torch.float16, \"(d) + cast_frozen_to(fp16), 16-mixed\") print(f\"\\nDELTAS (reduced resolution -- {TOKENS} tokens, not the real 65,536):\") print(f\" disable_peft_input_dtype_cast : {r['a']-r['b']:7.0f} MiB\") print(f\" lora_dropout 0.1 -> 0.0 : {r['b']-r['c']:7.0f} MiB\") print(f\" cast_frozen_to(fp16) : {r['c']-r['d']:7.0f} MiB\") print(f\" TOTAL : {r['a']-r['d']:7.0f} MiB \" f\"({100*(r['a']-r['d'])/r['a']:.0f}% of baseline peak)\") print(f\"\\nToken-count scaling to the real config: 65536/{TOKENS} = {65536//TOKENS}x\") PYEOF python gpu_ladder.py 2>&1 | grep -viE \"futurewarning|warnings.warn\"",
            "raw_input": {
              "description": "Measure memory levers on real GPU at reduced resolution",
              "command": "cd /home/jovyan/adi_wdir/surya_workshop && cat > /tmp/gpu_ladder.py <<'PYEOF'\n\"\"\"Measure each memory lever on real CUDA, at reduced resolution.\n\nThe full 4096x4096 config needs ~8.6 GiB and only ~2.7 GiB is free (a stale kernel holds\nthe rest), so this runs img_size=1024 (4096 tokens). Absolute numbers are not the real\nrun's; the point is the *direction and mechanism* of each lever on actual hardware.\n\"\"\"\nimport gc, sys\nsys.path.insert(0, \".\")\nimport torch\nfrom workshop_infrastructure.configs import LoraAdapterConfig\nfrom workshop_infrastructure.models.finetune_models import HelioSpectformer2D\nfrom workshop_infrastructure.utils import (\n    apply_peft_lora, cast_frozen_to, disable_peft_input_dtype_cast,\n)\n\nIMG, PATCH, EMBED, DEPTH, NSPEC = 1024, 16, 1280, 4, 2\nTOKENS = (IMG // PATCH) ** 2\nprint(f\"img_size={IMG} -> {TOKENS} tokens, embed={EMBED}, mlp hidden={EMBED*4}\")\nprint(f\"one fc2 input: {TOKENS*EMBED*4} elems = \"\n      f\"{TOKENS*EMBED*4*4/2**20:.0f} MiB fp32 / {TOKENS*EMBED*4*2/2**20:.0f} MiB half\\n\")\n\n\ndef build(lora_dropout, disable_cast, cast_half, half_dtype):\n    torch.manual_seed(0)\n    m = HelioSpectformer2D(\n        img_size=IMG, patch_size=PATCH, in_chans=13, embed_dim=EMBED,\n        time_embedding={\"type\": \"linear\", \"time_dim\": 1}, depth=DEPTH,\n        n_spectral_blocks=NSPEC, num_heads=16, mlp_ratio=4.0, drop_rate=0.0,\n        window_size=2, dp_rank=4, dtype=torch.float32, ft_out_chans=1,\n        checkpoint_layers=list(range(DEPTH)),\n    )\n    m = apply_peft_lora(m, LoraAdapterConfig(r=2, lora_dropout=lora_dropout))\n    if disable_cast:\n        disable_peft_input_dtype_cast(m)\n    if cast_half:\n        cast_frozen_to(m, half_dtype)\n    return m\n\n\ndef measure(m, autocast_dtype, label):\n    dev = torch.device(\"cuda\")\n    m = m.to(dev).train()\n    batch = {\"ts\": torch.randn(1, 13, 1, IMG, IMG, device=dev),\n             \"time_delta_input\": torch.zeros(1, 1, device=dev)}\n    opt = torch.optim.Adam([p for p in m.parameters() if p.requires_grad], lr=1e-4)\n    m.zero_grad(set_to_none=True); gc.collect(); torch.cuda.empty_cache()\n    torch.cuda.reset_peak_memory_stats()\n    static = torch.cuda.memory_allocated() / 2**20\n    with torch.autocast(\"cuda\", dtype=autocast_dtype):\n        out = m(batch)\n        loss = torch.nn.functional.mse_loss(out.reshape(-1), torch.zeros_like(out).reshape(-1))\n    loss.backward(); opt.step()\n    peak = torch.cuda.max_memory_allocated() / 2**20\n    print(f\"  {label:<46s} static {static:7.0f} MiB | peak {peak:7.0f} MiB\")\n    del out, loss, batch, opt\n    m.to(\"cpu\"); del m\n    gc.collect(); torch.cuda.empty_cache()\n    return peak\n\n\nimport io, contextlib\ndef quiet(fn, *a, **k):\n    with contextlib.redirect_stdout(io.StringIO()):\n        return fn(*a, **k)\n\nprint(\"LADDER (each row adds one lever):\")\nr = {}\nr[\"a\"] = measure(quiet(build, 0.1, False, False, None), torch.bfloat16,\n                 \"(a) bf16-mixed, PEFT cast ON, dropout 0.1\")\nr[\"b\"] = measure(quiet(build, 0.1, True, False, None), torch.bfloat16,\n                 \"(b)  + disable_peft_input_dtype_cast\")\nr[\"c\"] = measure(quiet(build, 0.0, True, False, None), torch.bfloat16,\n                 \"(c)  + lora_dropout 0.0\")\nr[\"d\"] = measure(quiet(build, 0.0, True, True, torch.float16), torch.float16,\n                 \"(d)  + cast_frozen_to(fp16), 16-mixed\")\n\nprint(f\"\\nDELTAS (reduced resolution -- {TOKENS} tokens, not the real 65,536):\")\nprint(f\"  disable_peft_input_dtype_cast : {r['a']-r['b']:7.0f} MiB\")\nprint(f\"  lora_dropout 0.1 -> 0.0       : {r['b']-r['c']:7.0f} MiB\")\nprint(f\"  cast_frozen_to(fp16)          : {r['c']-r['d']:7.0f} MiB\")\nprint(f\"  TOTAL                         : {r['a']-r['d']:7.0f} MiB \"\n      f\"({100*(r['a']-r['d'])/r['a']:.0f}% of baseline peak)\")\nprint(f\"\\nToken-count scaling to the real config: 65536/{TOKENS} = {65536//TOKENS}x\")\nPYEOF\n/home/jovyan/envs/surya_ws/bin/python /tmp/gpu_ladder.py 2>&1 | grep -viE \"futurewarning|warnings.warn\""
            },
            "raw_output": "img_size=1024 -> 4096 tokens, embed=1280, mlp hidden=5120\none fc2 input: 20971520 elems = 80 MiB fp32 / 40 MiB half\n\nLADDER (each row adds one lever):\n  (a) bf16-mixed, PEFT cast ON, dropout 0.1      static     391 MiB | peak    1141 MiB\n  (b)  + disable_peft_input_dtype_cast           static     410 MiB | peak    1022 MiB\n  (c)  + lora_dropout 0.0                        static     410 MiB | peak    1016 MiB\n  (d)  + cast_frozen_to(fp16), 16-mixed          static     238 MiB | peak     805 MiB\n\nDELTAS (reduced resolution -- 4096 tokens, not the real 65,536):\n  disable_peft_input_dtype_cast :     119 MiB\n  lora_dropout 0.1 -> 0.0       :       6 MiB\n  cast_frozen_to(fp16)          :     212 MiB\n  TOTAL                         :     336 MiB (29% of baseline peak)\n\nToken-count scaling to the real config: 65536/4096 = 16x\nShell cwd was reset to /home/jovyan/adi_wdir/surya_workshop/workshop_infrastructure/models",
            "tool_call_id": "toolu_bdrk_01TJfP3oYHM3sadkK9pkMUFx"
