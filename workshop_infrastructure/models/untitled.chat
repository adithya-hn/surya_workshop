            "tool_call_id": "toolu_bdrk_01Nwx98K19MJmFYmdZn6U5RV",
            "title": "cd surya_workshop && python - <<'PYEOF' 2>&1 | tail -20 import torch ln = torch.nn.LayerNorm(64) x32 = torch.randn(2, 8, 64) # CPU, half weight ln_h = torch.nn.LayerNorm(64) ln_h.weight.data = ln_h.weight.data.to(torch.bfloat16) ln_h.bias.data = ln_h.bias.data.to(torch.bfloat16) for dev, xd in ((\"cpu\", x32),): try: with torch.autocast(\"cpu\", dtype=torch.bfloat16): out = ln_h(xd) print(f\"CPU autocast, bf16 weight -> {out.dtype}\") except Exception as e: print(f\"CPU autocast, bf16 weight -> ERROR: {type(e).__name__}: {e}\") if torch.cuda.is_available(): lg = torch.nn.LayerNorm(64).cuda() lg.weight.data = lg.weight.data.to(torch.float16) lg.bias.data = lg.bias.data.to(torch.float16) xg = torch.randn(2, 8, 64, device=\"cuda\") try: with torch.autocast(\"cuda\", dtype=torch.float16): out = lg(xg) print(f\"CUDA autocast, fp16 weight, fp32 input -> {out.dtype}\") except Exception as e: print(f\"CUDA autocast, fp16 weight -> ERROR: {type(e).__name__}: {e}\") # and without autocast, fp16 input try: out = lg(xg.half()) print(f\"CUDA no autocast, fp16 weight, fp16 input -> {out.dtype}\") except Exception as e: print(f\"CUDA no autocast fp16/fp16 -> ERROR: {type(e).__name__}: {e}\") PYEOF",
            "raw_input": {
              "command": "cd /home/jovyan/adi_wdir/surya_workshop && /home/jovyan/envs/surya_ws/bin/python - <<'PYEOF' 2>&1 | tail -20\nimport torch\n\nln = torch.nn.LayerNorm(64)\nx32 = torch.randn(2, 8, 64)\n\n# CPU, half weight\nln_h = torch.nn.LayerNorm(64)\nln_h.weight.data = ln_h.weight.data.to(torch.bfloat16)\nln_h.bias.data = ln_h.bias.data.to(torch.bfloat16)\nfor dev, xd in ((\"cpu\", x32),):\n    try:\n        with torch.autocast(\"cpu\", dtype=torch.bfloat16):\n            out = ln_h(xd)\n        print(f\"CPU  autocast, bf16 weight -> {out.dtype}\")\n    except Exception as e:\n        print(f\"CPU  autocast, bf16 weight -> ERROR: {type(e).__name__}: {e}\")\n\nif torch.cuda.is_available():\n    lg = torch.nn.LayerNorm(64).cuda()\n    lg.weight.data = lg.weight.data.to(torch.float16)\n    lg.bias.data = lg.bias.data.to(torch.float16)\n    xg = torch.randn(2, 8, 64, device=\"cuda\")\n    try:\n        with torch.autocast(\"cuda\", dtype=torch.float16):\n            out = lg(xg)\n        print(f\"CUDA autocast, fp16 weight, fp32 input -> {out.dtype}\")\n    except Exception as e:\n        print(f\"CUDA autocast, fp16 weight -> ERROR: {type(e).__name__}: {e}\")\n    # and without autocast, fp16 input\n    try:\n        out = lg(xg.half())\n        print(f\"CUDA no autocast, fp16 weight, fp16 input -> {out.dtype}\")\n    except Exception as e:\n        print(f\"CUDA no autocast fp16/fp16 -> ERROR: {type(e).__name__}: {e}\")\nPYEOF",
